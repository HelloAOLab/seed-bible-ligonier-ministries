                "0a0756bd-9e4f-435d-934a-f69e439f0c65/api/ARBNAV/GEN/3.json": "🧬{\r\n    \"data\": {\r\n        \"book\": {\r\n            \"commonName\": \"التَّكوين\",\r\n            \"firstChapterApiLink\": \"/api/ARBNAV/GEN/1.json\",\r\n            \"id\": \"GEN\",\r\n            \"lastChapterApiLink\": \"/api/ARBNAV/GEN/50.json\",\r\n            \"name\": \"تكوين\",\r\n            \"numberOfChapters\": 50,\r\n            \"order\": 1,\r\n            \"sha256\": \"fed2e7d0fdb9a0a7e4aae7f724ce27612d418f755d3480d1143ddd3194c56db1\",\r\n            \"title\": \"كتابُ التَّكوين\",\r\n            \"totalNumberOfVerses\": 1533,\r\n            \"translationId\": \"ARBNAV\"\r\n        },\r\n        \"chapter\": {\r\n            \"content\": [\r\n                {\r\n                    \"content\": [\r\n                        \"وَكَانَتِ الْحَيَّةُ أَمْكَرَ وُحُوشِ الْبَرِّيَّةِ الَّتِي صَنَعَهَا الرَّبُّ الإِلَهُ، فَسَأَلَتِ الْمَرْأَةَ: «أَحَقّاً أَمَرَكُمَا اللهُ أَلاَّ تَأْكُلاَ مِنْ جَمِيعِ شَجَرِ الْجَنَّةِ؟»\"\r\n                    ],\r\n                    \"number\": 1,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَأَجَابَتِ الْمَرْأَةُ: «يُمْكِنُنَا أَنْ نَأْكُلَ مِنْ ثَمَرِ الْجَنَّةِ كُلِّهَا،\"\r\n                    ],\r\n                    \"number\": 2,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"مَاعَدَا ثَمَرَ الشَّجَرَةِ الَّتِي فِي وَسَطِهَا، فَقَدْ قَالَ اللهُ: لاَ تَأْكُلاَ مِنْهُ وَلاَ تَلْمُسَاهُ وَإِلَّا تَمُوتَا».\"\r\n                    ],\r\n                    \"number\": 3,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَقَالَتِ الْحَيَّةُ لِلْمَرْأَةِ: «لَنْ تَمُوتَا،\"\r\n                    ],\r\n                    \"number\": 4,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"بَلْ إِنَّ اللهَ يَعْرِفُ أَنَّهُ يَوْمَ تَأْكُلانِ مِنْ ثَمَرِ هَذِهِ الشَّجَرَةِ تَنْفَتِحُ أَعْيُنُكُمَا فَتَصِيرَانِ مِثْلَهُ، قَادِرَيْنِ عَلَى التَّمْيِيزِ بَيْنَ الْخَيْرِ وَالشَّرِّ».\"\r\n                    ],\r\n                    \"number\": 5,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"وَعِنْدَمَا شَاهَدَتِ الْمَرْأَةُ أَنَّ الشَّجَرَةَ لَذِيذَةٌ لِلْمَأْكَلِ وَشَهِيَّةٌ لِلْعُيُونِ، وَمُثِيرَةٌ لِلنَّظَرِ قَطَفَتْ مِنْ ثَمَرِهَا وَأَكَلَتْ، ثُمَّ أَعْطَتْ زَوْجَهَا أَيْضاً فَأَكَلَ مَعَهَا،\"\r\n                    ],\r\n                    \"number\": 6,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَانْفَتَحَتْ لِلْحَالِ أَعْيُنُهُمَا، وَأَدْرَكَا أَنَّهُمَا عُرْيَانَانِ، فَخَاطَا لأَنْفُسِهِمَا مَآزِرَ مِنْ أَوْرَاقِ التِّينِ.\"\r\n                    ],\r\n                    \"number\": 7,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"ثُمَّ سَمِعَ الزَّوْجَانِ صَوْتَ الرَّبِّ الإِلَهِ وَهُوَ يَمْشِي فِي الْجَنَّةِ عِنْدَ هُبُوبِ رِيحِ النَّهَارِ، فَاخْتَبَآ مِنْ حَضْرَةِ الرَّبِّ الإِلَهِ بَيْنَ شَجَرِ الْجَنَّةِ.\"\r\n                    ],\r\n                    \"number\": 8,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَنَادَى الرَّبُّ الإِلَهُ آدَمَ: «أَيْنَ أَنْتَ؟»\"\r\n                    ],\r\n                    \"number\": 9,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَأَجَابَ: «سَمِعْتُ صَوْتَكَ فِي الْجَنَّةِ فَاخْتَبَأْتُ خِشْيَةً مِنْكَ لأَنِّي عُرْيَانٌ».\"\r\n                    ],\r\n                    \"number\": 10,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَسَأَلَهُ: «مَنْ قَالَ لَكَ إِنَّكَ عُرْيَانٌ؟ هَلْ أَكَلْتَ مِنْ ثَمَرِ الشَّجَرَةِ الَّتِي نَهَيْتُكَ عَنْهَا؟»\"\r\n                    ],\r\n                    \"number\": 11,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَأَجَابَ آدَمُ: «إِنَّهَا الْمَرْأَةُ الَّتِي جَعَلْتَهَا رَفِيقَةً لِي. هِيَ الَّتِي أَطْعَمَتْنِي مِنْ ثَمَرِ الشَّجَرَةِ، فَأَكَلْتُ».\"\r\n                    ],\r\n                    \"number\": 12,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَسَأَلَ الرَّبُّ الإِلَهُ الْمَرْأَةَ: «مَاذَا فَعَلْتِ؟» فَأَجَابَتْ: «أَغْوَتْنِي الْحَيَّةُ فَأَكَلْتُ».\"\r\n                    ],\r\n                    \"number\": 13,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَقَالَ الرَّبُّ الإِلَهُ لِلْحَيَّةِ: «لأَنَّكِ فَعَلْتِ هَذَا، مَلْعُونَةٌ أَنْتِ مِنْ بَيْنَ جَمِيعِ الْبَهَائِمِ وَمِنْ جَمِيعِ وُحُوشِ الْبَرِّيَّةِ، عَلَى بَطْنِكِ تَسْعَيْنَ، وَمِنَ التُّرَابِ تَأْكُلِينَ طَوَالَ حَيَاتِكِ،\"\r\n                    ],\r\n                    \"number\": 14,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"وَأُثِيرُ عَدَاوَةً دَائِمَةً بَيْنَكِ وَبَيْنَ الْمَرْأَةِ، وَكَذَلِكَ بَيْنَ نَسْلَيْكُمَا. هُوَ يَسْحَقُ رَأْسَكِ وَأَنْتِ تَلْدَغِينَ عَقِبَهُ».\"\r\n                    ],\r\n                    \"number\": 15,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"ثُمَّ قَالَ لِلْمَرْأَةِ: «أُكَثِّرُ تَكْثِيراً أَوْجَاعَ مَخَاضِكِ فَتُنْجِبِينَ بِالآلاَمِ أَوْلاَداً، وَإِلَى زَوْجِكِ يَكُونُ اشْتِيَاقُكِ وَهُوَ يَتَسَلَّطُ عَلَيْكِ».\"\r\n                    ],\r\n                    \"number\": 16,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"وَقَالَ لِآدَمَ: «لأَنَّكَ أَذْعَنْتَ لِقَوْلِ امْرَأَتِكَ، وَأَكَلْتَ مِنَ الشَّجَرَةِ الَّتِي نَهَيْتُكَ عَنْهَا، فَالأَرْضُ مَلْعُونَةٌ بِسَبَبِكَ وَبِالْمَشَقَّةِ تَقْتَاتُ مِنْهَا طَوَالَ عُمْرِكَ.\"\r\n                    ],\r\n                    \"number\": 17,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"شَوْكاً وَحَسَكاً تُنْبِتُ لَكَ، وَأَنْتَ تَأْكُلُ عُشْبَ الْحَقْلِ.\"\r\n                    ],\r\n                    \"number\": 18,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"بِعَرَقِ جَبِينِكَ تَكْسَبُ عَيْشَكَ حَتَّى تَعُودَ إِلَى الأَرْضِ، فَمِنْ تُرَابٍ أُخِذْتَ، وَإِلَى تُرَابٍ تَعُودُ».\"\r\n                    ],\r\n                    \"number\": 19,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"وَسَمَّى آدَمُ زَوْجَتَهُ «حَوَّاءَ» لأَنَّهَا أُمُّ كُلِّ حَيٍّ.\"\r\n                    ],\r\n                    \"number\": 20,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"وَكَسَا الرَّبُّ الإِلَهُ آدَمَ وَزَوْجَتَهُ رِدَاءَيْنِ مِنْ جِلْدٍ صَنَعَهَا لَهُمَا.\"\r\n                    ],\r\n                    \"number\": 21,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"ثُمَّ قَالَ الرَّبُّ الإِلَهُ: «هَا الإِنْسَانُ قَدْ صَارَ كَوَاحِدٍ مِنَّا، يُمَيِّزُ بَيْنَ الْخَيْرِ وَالشَّرِّ. وَقَدْ يَمُدُّ يَدَهُ وَيَتَنَاوَلُ مِنْ شَجَرَةِ الْحَيَاةِ وَيَأْكُلُ، فَيَحْيَا إِلَى الأَبَدِ».\"\r\n                    ],\r\n                    \"number\": 22,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"فَأَخْرَجَهُ مِنْ جَنَّةِ عَدْنٍ لِيَفْلَحَ الأَرْضَ الَّتِي أُخِذَ مِنْ تُرَابِهَا.\"\r\n                    ],\r\n                    \"number\": 23,\r\n                    \"type\": \"verse\"\r\n                },\r\n                {\r\n                    \"content\": [\r\n                        \"وَهَكَذَا طَرَدَ اللهُ الإِنْسَانَ مِنْ جَنَّةِ عَدْنٍ، وَأَقَامَ مَلائِكَةَ الْكَرُوبِيمِ وَسَيْفاً نَارِيّاً مُتَقَلِّباً شَرْقِيَّ الْجَنَّةِ لِحِرَاسَةِ الطَّرِيقِ الْمُفْضِيَةِ إِلَى «شَجَرَةِ الْحَيَاةِ».\"\r\n                    ],\r\n                    \"number\": 24,\r\n                    \"type\": \"verse\"\r\n                }\r\n            ],\r\n            \"footnotes\": [],\r\n            \"number\": 3\r\n        },\r\n        \"nextChapterApiLink\": \"/api/ARBNAV/GEN/4.json\",\r\n        \"nextChapterAudioLinks\": {},\r\n        \"numberOfVerses\": 24,\r\n        \"previousChapterApiLink\": \"/api/ARBNAV/GEN/2.json\",\r\n        \"previousChapterAudioLinks\": {},\r\n        \"thisChapterAudioLinks\": {},\r\n        \"thisChapterLink\": \"/api/ARBNAV/GEN/3.json\",\r\n        \"translation\": {\r\n            \"availableFormats\": [\r\n                \"json\"\r\n            ],\r\n            \"englishName\": \"NAV\",\r\n            \"id\": \"ARBNAV\",\r\n            \"language\": \"arb\",\r\n            \"languageEnglishName\": \"Arabic\",\r\n            \"languageName\": \"العربية\",\r\n            \"licenseNotes\": null,\r\n            \"licenseUrl\": \"https://ebible.org/Scriptures/details.php?id=arbnav\",\r\n            \"listOfBooksApiLink\": \"/api/ARBNAV/books.json\",\r\n            \"name\": \"كتاب الحياة\",\r\n            \"numberOfBooks\": 66,\r\n            \"sha256\": \"a79c9b768c54fa24fe464238d727a3042fa6a4cd6874e8e48d416538a03fdaad\",\r\n            \"shortName\": \"NAV\",\r\n            \"textDirection\": \"rtl\",\r\n            \"totalNumberOfChapters\": 1189,\r\n            \"totalNumberOfVerses\": 31101,\r\n            \"website\": \"https://ebible.org/Scriptures/details.php?id=arbnav\"\r\n        }\r\n    },\r\n    \"headers\": {\r\n        \"content-type\": \"application/json\",\r\n        \"last-modified\": \"Thu, 19 Dec 2024 17:48:55 GMT\"\r\n    },\r\n    \"status\": 200,\r\n    \"statusText\": \"\"\r\n}",
                "0a0756bd-9e4f-435d-934a-f69e439f0c65/api/ARBNAV/GEN/4.json": {
                    "data": {
                        "book": {
                            "commonName": "التَّكوين",
                            "firstChapterApiLink": "/api/ARBNAV/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/ARBNAV/GEN/50.json",
                            "name": "تكوين",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "fed2e7d0fdb9a0a7e4aae7f724ce27612d418f755d3480d1143ddd3194c56db1",
                            "title": "كتابُ التَّكوين",
                            "totalNumberOfVerses": 1533,
                            "translationId": "ARBNAV"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "وَعَاشَرَ آدَمُ حَوَّاءَ زَوْجَتَهُ فَحَبِلَتْ، وَوَلَدَتْ ابْناً أَسْمَتْهُ قَايِينَ إِذْ قَالَتْ: «اقْتَنَيْتُ رَجُلاً مِنْ عِنْدِ الرَّبِّ»."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "ثُمَّ عَادَتْ فَوَلَدَتْ أَخَاهُ هَابِيلَ، وَكَانَ هَابِيلُ رَاعِياً لِلْغَنَمِ. أَمَّا قَايِينُ فَقَدْ عَمِلَ فِي فَلاَحَةِ الأَرْضِ."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَحَدَثَ بَعْدَ مُرُورِ أَيَّامٍ أَنْ قَدَّمَ قَايِينُ مِنْ ثِمَارِ الأَرْضِ قُرْبَاناً لِلرَّبِّ،"
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَقَدَّمَ هَابِيلُ أَيْضاً مِنْ خَيْرَةِ أَبْكَارِ غَنَمِهِ وَأَسْمَنِهَا. فَتَقَبَّلَ الرَّبُّ قُرْبَانَ هَابِيلَ وَرَضِيَ عَنْهُ."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "لَكِنَّهُ لَمْ يَتَقَبَّلْ قُرْبَانَ قَايِينَ وَلَمْ يَرْضَ عَنْهُ. فَاغْتَاظَ قَايِينُ جِدّاً وَتَجَهَّمَ وَجْهُهُ كَمَداً."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "فَسَأَلَ الرَّبُّ قَايِينَ: «لِمَاذَا اغْتَظْتَ؟ لِمَاذَا تَجَهَّمَ وَجْهُكَ؟"
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "لَوْ أَحْسَنْتَ فِي تَصَرُّفِكَ أَلاَ يُشْرِقُ وَجْهُكَ فَرَحاً؟ وَإِنْ لَمْ تُحْسِنِ التَّصَرُّفَ، فَعِنْدَ الْبَابِ خَطِيئَةٌ تَنْتَظِرُكَ، تَتَشَوَّقُ أَنْ تَتَسَلَّطَ عَلَيْكَ، لَكِنْ يَجِبُ أَنْ تَتَحَكَّمَ فِيهَا»"
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَعَادَ قَايِينُ يَتَظَاهَرُ بِالْوُدِّ لأَخِيهِ هَابِيلَ. وَحَدَثَ إِذْ كَانَا مَعاً فِي الْحَقْلِ أَنَّ قَايِينَ هَجَمَ عَلَى أَخِيهِ هَابِيلَ وَقَتَلَهُ."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَسَأَلَ الرَّبُّ قَايِينَ: «أَيْنَ أَخُوكَ هَابِيلُ؟» فَأَجَابَ: «لاَ أَعْرِفُ. هَلْ أَنَا حَارِسٌ لأَخِي؟»"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "فَقَالَ الرَّبُّ لَهُ: «مَاذَا فَعَلْتَ؟ إِنَّ صَوْتَ دَمِ أَخِيكَ يَصْرُخُ إِلَيَّ مِنَ الأَرْضِ."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "فَمُنْذُ الآنَ، تَحِلُّ عَلَيْكَ لَعْنَةُ الأَرْضِ الَّتِي فَتَحَتْ فَاهَا وَابْتَلَعَتْ دَمَ أَخِيكَ الَّذِي سَفَكَتْهُ يَدُكَ."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "عِنْدَمَا تَفْلَحُهَا لَنْ تُعْطِيَكَ خَيْرَهَا، وَتَكُونُ شَرِيداً وَطَرِيداً فِي الأَرْضِ»."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "فَقَالَ قَايِينُ لِلرَّبِّ: «عُقُوبَتِي أَعْظَمُ مِنْ أَنْ تُحْتَمَلَ."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "هَا أَنْتَ الْيَوْمَ قَدْ طَرَدْتَنِي عَنْ وَجْهِ الأَرْضِ، وَمِنْ أَمَامِ حَضْرَتِكَ أَخْتَفِي، وَأَكُونُ شَرِيداً طَرِيداً فِي الأَرْضِ، وَيَقْتُلُنِي كُلُّ مَنْ يَجِدُنِي»."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "فَقَالَ الرَّبُّ لَهُ: «سَأُعَاقِبُ كُلَّ مَنْ يَقْتُلُكَ بِسَبْعَةِ أَضْعَافِ الْعُقُوبَةِ الَّتِي عَاقَبْتُكَ بِهَا». وَوَسَمَ الرَّبُّ قَايِينَ بِعَلاَمَةٍ تَحْظُرُ عَلَى مَنْ يَلْقَاهُ اغْتِيَالَهُ."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَهَكَذَا خَرَجَ قَايِينُ مِنْ حَضْرَةِ الرَّبِّ وَسَكَنَ فِي أَرْضِ نُودٍ شَرْقِيَّ عَدْنٍ."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَعَاشَرَ قَايِينُ زَوْجَتَهُ فَحَبِلَتْ وَأَنْجَبَتِ ابْناً دَعَاهُ «حَنُوكَ». وَكَانَ قَايِينُ آنَئِذٍ يَبْنِي مَدِينَةً فَسَمَّاهَا «حَنُوكَ» عَلَى اسْمِ ابْنِهِ."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "ثُمَّ وَلَدَ حَنُوكُ عِيرَادَ، وَوَلَدَ عِيرَادُ مَحُويَائِيلَ، وَوَلَدَ مَحُويَائِيلُ مَتُوشَائِيلَ، وَوَلَدَ مَتُوشَائِيلُ لاَمَكَ."
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَتَزَوَّجَ لاَمَكُ امْرَأَتَيْنِ: اسْمُ الْوَاحِدَةِ عَادَةُ، وَاسْمُ الأُخْرَى صِلَّةُ."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَوَلَدَتْ عَادَةُ كُلًّا مِنْ «يَابَالَ» أَوَّلِ رُعَاةِ الْمَوَاشِي وَسَاكِنِي الْخِيَامِ."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَأَخِيهِ يُوبَالَ أَوَّلِ الْعَازِفِينَ بِالْعُودِ وَالْمِزْمَارِ."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَوَلَدَتْ صِلَّةُ «تُوبَالَ قَايِينَ» أَوَّلَ صَانِعِي آلاَتِ النُّحَاسِ وَالْحَدِيدِ. كَمَا وَلَدَتْ «نَعْمَةَ» أُخْتَ تُوبَالَ قَايِينَ."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَقَالَ لاَمَكُ لِزَوْجَتَيْهِ: «يَاعَادَةُ وَصِلَّةُ، اسْمَعَا قَوْلِي، يَازَوْجَتَيْ لاَمَكَ أَصْغِيَا لِكَلاَمِي: إِنِّي قَتَلْتُ رَجُلاً جَرَحَنِي وَشَابّاً كَسَرَنِي."
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "فَإِنْ كَانَ يُنْتَقَمُ لِقَايِينَ سَبْعَةَ أَضْعَافٍ، فَإِنَّهُ يُنْتَقَمُ لِلاَمَكَ سَبْعَةً وَسَبْعِينَ ضِعْفاً»."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَعَاشَرَ آدَمُ زَوْجَتَهُ حَوَّاءَ مَرَّةً أُخْرَى فَأَنْجَبَتْ لَهُ ابْناً أَسْمَتْهُ «شِيثاً» إِذْ قَالَتْ: «قَدْ عَوَّضَنِي اللهُ نَسْلاً آخَرَ عِوَضاً عَنْ هَابِيلَ الَّذِي قَتَلَهُ قَايِينُ»."
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "وَوُلِدَ لِشِيثٍ أَيْضاً ابْنٌ سَمَّاهُ أَنُوشَ وَعَنْدَئِذٍ ابْتَدَأَ النَّاسُ يَدْعُونَ بِاسْمِ الرَّبِّ."
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [],
                            "number": 4
                        },
                        "nextChapterApiLink": "/api/ARBNAV/GEN/5.json",
