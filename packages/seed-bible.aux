                "App.css": ".starterAnimation {\r\n    animation: fade-in-animation 0.3s linear forwards;\r\n    animation-delay: 0.1s;\r\n}\r\n\r\n.share-btn {\r\n    border: none;\r\n    font-size: 18px !important;\r\n    height: 24px;\r\n    width: 24px;\r\n    background: #80DEF8;\r\n    display: flex !important;\r\n    justify-content: center;\r\n    align-items: center;\r\n    border-radius: 5px;\r\n    padding: 3px;\r\n}\r\n\r\n.share-btn:hover {\r\n    background-color: #26C6DA;\r\n}\r\n\r\n.share-btn:active {\r\n    background-color: #26C6DA;\r\n}\r\n\r\n@keyframes fade-in-animation {\r\n    from {\r\n        opacity: 0;\r\n    }\r\n\r\n    to {\r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n@keyframes come-up-animation {\r\n    from {\r\n        height: 0px;\r\n    }\r\n\r\n    to {\r\n        height: 210px;\r\n    }\r\n}\r\n\r\nbody {\r\n    user-select: none;\r\n}\r\n\r\n.switch {\r\n    position: relative;\r\n    display: inline-block;\r\n    width: 30px;\r\n    height: 17px;\r\n}\r\n\r\n.switch input {\r\n    opacity: 0;\r\n    width: 0;\r\n    height: 0;\r\n}\r\n\r\n.slider:not(#slider) {\r\n    position: absolute;\r\n    cursor: pointer;\r\n    top: 0;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    background-color: #ccc;\r\n    -webkit-transition: .4s;\r\n    transition: .4s;\r\n}\r\n\r\n.slider:not(#slider):before {\r\n    position: absolute;\r\n    content: \"\";\r\n    height: 13px;\r\n    width: 13px;\r\n    left: 2px;\r\n    bottom: 2px;\r\n    background-color: white;\r\n    -webkit-transition: .4s;\r\n    transition: .4s;\r\n}\r\n\r\ninput:checked+.slider:not(#slider) {\r\n    background-color: #2196F3;\r\n}\r\n\r\ninput:focus+.slider:not(#slider) {\r\n    box-shadow: 0 0 1px #2196F3;\r\n}\r\n\r\ninput:checked+.slider:not(#slider):before {\r\n    -webkit-transform: translateX(13px);\r\n    -ms-transform: translateX(13px);\r\n    transform: translateX(13px);\r\n}\r\n\r\n/* Rounded sliders */\r\n.slider:not(#slider).round {\r\n    border-radius: 17px;\r\n}\r\n\r\n.slider:not(#slider).round:before {\r\n    border-radius: 50%;\r\n}\r\n\r\n.custom-translation-header {\r\n    display: flex;\r\n    height: fit-content;\r\n    width: 100%;\r\n    padding: 0px 10px;\r\n    font-size: 18px;\r\n    justify-content: space-between;\r\n    color: #4459F3;\r\n    margin-top: 5px;\r\n}\r\n\r\n.custom-translation-container-main {\r\n    justify-content: flex-start;\r\n    align-items: flex-start;\r\n    height: fit-content;\r\n    background-color: white;\r\n    flex-direction: column;\r\n    transition: 0.5s linear all;\r\n}\r\n\r\n.custom-translation-container {\r\n    display: flex;\r\n    width: 100%;\r\n    flex-direction: column;\r\n    padding: 10px;\r\n    gap: 10px;\r\n}\r\n\r\n.custom-tr-api {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 10px;\r\n    padding: 5px;\r\n    width: 100%;\r\n}\r\n\r\n.custom-tr-in-con {\r\n    display: flex;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    gap: 5px;\r\n    /* height: 20px; */\r\n    position: relative;\r\n}\r\n\r\n.custom-tr-in {\r\n    width: 100%;\r\n    height: 40px;\r\n    border-radius: 5px;\r\n    padding-right: 80px;\r\n    border: 1px solid #607D8B;\r\n    padding-left: 5px;\r\n    font-size: 16px;\r\n}\r\n\r\n.import-btn {\r\n    position: absolute;\r\n    right: 5px;\r\n    width: 70px;\r\n    height: 30px;\r\n    border-radius: 5px;\r\n    background-color: #4459F3;\r\n    color: white;\r\n    border: none;\r\n}\r\n\r\n.radioinput {\r\n    height: 15px;\r\n    width: 15px;\r\n    cursor: pointer;\r\n}\r\n\r\n.selectionsection {\r\n    display: flex;\r\n    font-size: 18px;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    gap: 10px;\r\n}\r\n\r\n.about-us-title-conatiner {\r\n    display: flex;\r\n    width: 100%;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.about-us-title {\r\n    font-size: 18px;\r\n    font-weight: bold;\r\n}\r\n\r\n.about-us-description-container {\r\n    display: flex;\r\n    width: 100%;\r\n    animation: open-bar ease 1s;\r\n    animation-iteration-count: 1;\r\n    animation-fill-mode: forwards;\r\n    height: 100%;\r\n    margin-top: -10px;\r\n}\r\n\r\n.about-us-description {\r\n    color: black;\r\n}\r\n\r\n@keyframes open-bar {\r\n    0% {\r\n        height: 0%;\r\n    }\r\n\r\n    100% {\r\n        height: 100%;\r\n    }\r\n}\r\n\r\n.searchbar-container {\r\n    position: fixed;\r\n    bottom: 10px;\r\n    max-width: 200px;\r\n    left: calc(50vw - 20px);\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: flex-end;\r\n    animation: fadeInAnimation2 ease 2s;\r\n    animation-iteration-count: 1;\r\n    animation-fill-mode: forwards;\r\n    height: fit-content;\r\n    width: fit-content;\r\n    transition: all 0.5s;\r\n}\r\n\r\n.sidebar-book-selector {\r\n    width: 100%;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    height: 24px;\r\n}\r\n\r\n.sidebar-translation-selector {\r\n    display: flex;\r\n}\r\n\r\n.sidebar-translation-options {\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: flex-start;\r\n    align-items: flex-start;\r\n    width: 100%;\r\n    padding-top: 40px;\r\n}\r\n\r\n.translation-option {\r\n    display: flex;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin-bottom: 5px;\r\n    width: 100%;\r\n    padding: 5px;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n    width: 300px;\r\n}\r\n\r\n.translation-option:hover {\r\n    background: #B3E5FC;\r\n}\r\n\r\n.translation-language {\r\n    font-weight: bold;\r\n    font-size: 20px;\r\n    display: flex;\r\n    justify-content: start;\r\n    align-items: center;\r\n    flex-direction: row;\r\n    margin-bottom: 10px;\r\n    width: 291px;\r\n    justify-content: space-between;\r\n    margin: 10px;\r\n}\r\n\r\n.translation-title {\r\n    width: 25%;\r\n    font-weight: bold;\r\n    font-size: 14px;\r\n}\r\n\r\n.sidebar-selected-title {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 24px;\r\n    /* overflow: hidden; */\r\n    font-size: 18px;\r\n    text-overflow: ellipsis;\r\n    white-space: nowrap;\r\n}\r\n\r\n.translation-description {\r\n    font-weight: normal;\r\n    font-size: 14px;\r\n    width: 60%;\r\n}\r\n\r\n.experience-container {\r\n    display: flex;\r\n    width: calc(100% - 20px);\r\n    height: calc(100% - 20px);\r\n    /* position: absolute; */\r\n    top: 0;\r\n    left: 0;\r\n    padding: 10px;\r\n    flex-direction: column;\r\n    background: white;\r\n    pointer-events: all;\r\n}\r\n\r\n.experience_title_container {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    gap: 5px;\r\n}\r\n\r\n.experience_title_intro {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 5px;\r\n}\r\n\r\n.experience_title_back {\r\n    background: none;\r\n    outline: none;\r\n    border: none;\r\n}\r\n\r\n.experience_title_container .experience_title_icon {\r\n    font-size: 30px;\r\n}\r\n\r\n.experience_title_container .experience_title {\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n}\r\n\r\n.experiences {\r\n    display: flex;\r\n    gap: 10px;\r\n    flex-wrap: wrap;\r\n    margin-top: 10px;\r\n}\r\n\r\n.experiences .experience_btn {\r\n    display: flex;\r\n    height: 35px;\r\n    width: 150px;\r\n    background: #CFD8DC;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    border-radius: 10px;\r\n    font-weight: bold;\r\n    padding: 5px;\r\n    gap: 3px;\r\n}\r\n\r\n.experiences .experience_btn.visited {\r\n    background: rgb(181, 214, 228);\r\n}\r\n\r\n.experiences .experience_btn:hover {\r\n    background: #ECEFF1;\r\n}\r\n\r\n.sidebar-toggle {\r\n    display: flex;\r\n    gap: 5px;\r\n    justify-content: center;\r\n    align-items: center;\r\n}\r\n\r\n.baseT {\r\n    max-width: 90%;\r\n    width: 100%;\r\n    height: 25px;\r\n    color: white;\r\n    border: 3px solid black;\r\n    padding: 5px;\r\n    background: rgb(255, 255, 255);\r\n    background: linear-gradient(90deg, rgba(255, 255, 255, 1) 25%, rgba(0, 0, 0, 1) 25%, rgba(0, 0, 0, 1) 75%, rgba(255, 255, 255, 1) 75%);\r\n    background-size: 400%;\r\n    border-radius: 5px;\r\n    font-size: small;\r\n    animation-iteration-count: 1;\r\n    animation-fill-mode: forwards;\r\n}\r\n\r\n.ot {\r\n    background-color: black;\r\n    display: flex;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    background-position: 210%;\r\n    animation: otAni ease 1s;\r\n}\r\n\r\n@keyframes otAni {\r\n    0% {\r\n        background-position: 199%;\r\n    }\r\n\r\n    50% {\r\n        background-position: 235%;\r\n    }\r\n\r\n    100% {\r\n        background-position: 210%;\r\n    }\r\n}\r\n\r\n.nt {\r\n    display: flex;\r\n    justify-content: flex-end;\r\n    align-items: center;\r\n    background-position: 145%;\r\n    animation: ntAni ease 1s;\r\n}\r\n\r\n@keyframes ntAni {\r\n    0% {\r\n        background-position: 210%;\r\n    }\r\n\r\n    50% {\r\n        background-position: 133%;\r\n    }\r\n\r\n    100% {\r\n        background-position: 145%;\r\n    }\r\n}\r\n\r\n.all {\r\n    display: flex;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    padding: 5px;\r\n    background-position: 199%;\r\n    animation: allAni ease 1s;\r\n}\r\n\r\n@keyframes allAni {\r\n    0% {\r\n        background-position: 145%;\r\n    }\r\n\r\n    100% {\r\n        background-position: 199%;\r\n    }\r\n}\r\n\r\n.desktop-hide {\r\n    display: none;\r\n}\r\n\r\n.sidebar-input-container {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-top: 5px;\r\n    position: absolute;\r\n    bottom: 5px;\r\n    right: 0;\r\n    left: 0;\r\n    border-top: 2px solid #78909C;\r\n    padding-top: 5px;\r\n}\r\n\r\n.open-sidebar-input-container {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-top: 5px;\r\n    position: absolute;\r\n    bottom: 5px;\r\n    right: 0;\r\n    left: 0;\r\n}\r\n\r\n.open-sidebar-input-container.hide-seek {\r\n    justify-content: flex-end;\r\n}\r\n\r\n.open-searchbar {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-top: 5px;\r\n    position: absolute;\r\n    bottom: 5px;\r\n    right: 0;\r\n    left: 0;\r\n}\r\n\r\n.psalms-btn {\r\n    width: 290px;\r\n    display: flex;\r\n    background-color: rgba(1, 87, 155, 0.3);\r\n    color: #044d87;\r\n    padding: 10px;\r\n    border-radius: 5px;\r\n    font-size: 16px;\r\n}\r\n\r\n.chapter-btn {\r\n    padding: 0;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n.searchbar-container:hover {\r\n    left: calc(50vw - 100px);\r\n}\r\n\r\n.searchbar-container:not(:hover) {\r\n    transition-delay: 2s;\r\n}\r\n\r\n@keyframes fadeInAnimation2 {\r\n    0% {\r\n        opacity: 1;\r\n    }\r\n\r\n    100% {\r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n\r\n.sidebar-container {\r\n    display: flex;\r\n    position: fixed;\r\n    right: 35px;\r\n    width: 24px;\r\n    bottom: 35px;\r\n    height: 24px;\r\n    color: black;\r\n    justify-content: center;\r\n    align-items: center;\r\n    transition: 0.5s;\r\n    flex-direction: column;\r\n    gap: 5px;\r\n    z-index: 1000;\r\n}\r\n\r\n.sidebar-container.solo {\r\n    right: 27px;\r\n    bottom: 5px;\r\n}\r\n\r\n\r\n.sidebar-chapters {\r\n    display: none;\r\n}\r\n\r\n.show-sidebar-chapter {\r\n    display: flex;\r\n    width: 100%;\r\n    height: fit-content;\r\n    gap: 8.5px;\r\n    flex-wrap: wrap;\r\n    background-color: #E1F5FE;\r\n    padding: 8px;\r\n    border-radius: 5px;\r\n}\r\n\r\n.show-sidebar-chapter-m {\r\n    display: flex;\r\n    width: 100%;\r\n    height: fit-content;\r\n    gap: 8.5px;\r\n    flex-wrap: wrap;\r\n    background-color: #E1F5FE;\r\n    padding: 8px;\r\n    border-radius: 5px;\r\n}\r\n\r\n.sidebar-chapter-itm {\r\n    height: 41.5px;\r\n    width: 41.5px;\r\n    display: flex;\r\n    background-color: rgba(1, 87, 155, 0.3);\r\n    justify-content: center;\r\n    align-items: center;\r\n    border-radius: 5px;\r\n    color: white;\r\n    transition: all 0.3s;\r\n}\r\n\r\n.sidebar-chapter-itm:hover {\r\n    background-color: rgba(1, 87, 155, 0.9);\r\n}\r\n\r\n.close-input {\r\n    position: fixed;\r\n    display: flex;\r\n    left: 60px;\r\n    bottom: 18px;\r\n    width: 24px;\r\n    height: 24px;\r\n    justify-content: center;\r\n    align-items: center;\r\n    transition: all 0.5s;\r\n    opacity: 0;\r\n}\r\n\r\n.close-input-icon {\r\n    position: fixed;\r\n    display: flex;\r\n    left: 60px;\r\n    bottom: 18px;\r\n    width: 24px;\r\n    height: 24px;\r\n    justify-content: center;\r\n    align-items: center;\r\n    transition: all 0.5s;\r\n    opacity: 0;\r\n    pointer-events: auto;\r\n}\r\n\r\n.open-toggle {\r\n    right: 360px;\r\n    opacity: 1;\r\n    bottom: 0px;\r\n}\r\n\r\n.sidebar-container.open-toggle-solo {\r\n    right: 304px;\r\n    opacity: 1;\r\n    z-index: 9999;\r\n}\r\n\r\n.close-toggle {\r\n    right: 35px;\r\n    opacity: 1;\r\n    bottom: 35px;\r\n}\r\n\r\n.close-toggle.solo {\r\n    right: 27px;\r\n    opacity: 1;\r\n    bottom: -10px;\r\n}\r\n\r\n.sidebar {\r\n    /* position: fixed; */\r\n    /* top: 0; */\r\n    /* right: -330px; */\r\n    /* height: 60dvh; */\r\n    width: 330px;\r\n    background-color: var(--bgColor) !important;\r\n    color: var(--textColor) !important;\r\n    display: flex;\r\n    padding: 10px;\r\n    transition: all 0.5s;\r\n    overflow-y: hidden;\r\n    scrollbar-width: none;\r\n    /* z-index: 1001; */\r\n    /* bottom: 15px; */\r\n    border-top-left-radius: 10px;\r\n    border-bottom-left-radius: 10px;\r\n    flex-direction: column;\r\n    padding-bottom: 45px;\r\n    position: fixed;\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n    z-index: 2;\r\n    height: 0dvh;\r\n    bottom: 10px;\r\n}\r\n\r\n.testament-selection {\r\n    opacity: 0;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.sidebar-select {\r\n    width: 100%;\r\n    height: fit-content;\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n    border-radius: 10px;\r\n    outline: 0px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    /* padding: 10px; */\r\n    gap: 5px;\r\n    animation: fadeInAnimation2 ease 1s;\r\n    animation-iteration-count: 1;\r\n    animation-fill-mode: forwards;\r\n    /* border: 1px solid black; */\r\n    background-color: white;\r\n    padding-left: 5px;\r\n    cursor: pointer;\r\n    flex-direction: column;\r\n}\r\n\r\n.sidebar-select:hover {\r\n    /* background-color: #ECEFF1; */\r\n}\r\n\r\n.sidebar-results {\r\n    display: flex;\r\n    width: 100%;\r\n    scroll-behavior: smooth;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n    overflow-y: auto;\r\n    scrollbar-width: none;\r\n    transition: all 0.3s;\r\n    justify-content: flex-start;\r\n    align-items: flex-start;\r\n}\r\n\r\n.sidebar-itm {\r\n    height: 40px;\r\n    width: 150px;\r\n    display: flex;\r\n    /* background-color: #F9F9F9; */\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n    transition: all 0.3s;\r\n    font-size: 14px;\r\n    padding: 10px;\r\n    /* color: black; */\r\n}\r\n\r\n.sidebar-itm:hover {\r\n    background-color: var(--bg-color);\r\n}\r\n\r\n.sidebar-selected-itm {\r\n    background-color: #E1F5FE;\r\n    color: #044d87;\r\n    font-weight: bold;\r\n}\r\n\r\n.sidebar-itm.blinker {\r\n    animation: blinking 2s linear 1;\r\n}\r\n\r\n.sidebar-itm.sidebar-selected-itm-win {\r\n    background-color: gold;\r\n    color: #fff;\r\n    font-weight: bold;\r\n}\r\n\r\n.sidebar-itm.sidebar-selected-itm-disabled {\r\n    background-color: #363737;\r\n    color: white;\r\n    opacity: 1;\r\n    display: block;\r\n    font-weight: bold;\r\n    animation: 1s disappear 1s linear forwards;\r\n}\r\n\r\n@keyframes disappear {\r\n    0% {\r\n        opacity: 1;\r\n        display: block;\r\n    }\r\n\r\n    100% {\r\n        opacity: 0;\r\n        display: none;\r\n    }\r\n}\r\n\r\n@keyframes blinking {\r\n\r\n    0%,\r\n    50%,\r\n    100% {\r\n        background-color: #F9F9F9;\r\n    }\r\n\r\n    25%,\r\n    75% {\r\n        background-color: var(--bg-color);\r\n    }\r\n}\r\n\r\n.open-sideBar {\r\n    opacity: 1;\r\n    height: 60dvh;\r\n    bottom: 78px;\r\n    background-color: white !important;\r\n    box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;\r\n    /* opacity: 0; */\r\n}\r\n\r\n.close-sideBar {\r\n    right: 0;\r\n    opacity: 1;\r\n    height: 0;\r\n    bottom: -80px !important;\r\n}\r\n\r\n\r\n@keyframes open-sidebar-ani {\r\n    0% {\r\n        right: -330px;\r\n        opacity: 1;\r\n    }\r\n\r\n    100% {\r\n        right: 0px;\r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n@keyframes close-sidebar-ani {\r\n    0% {\r\n        right: 0px;\r\n        opacity: 1;\r\n    }\r\n\r\n    100% {\r\n        right: -330px;\r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n.final-result {\r\n    background-color: rgba(179, 229, 252, 0.5);\r\n}\r\n\r\n.refresh {\r\n    position: fixed;\r\n    bottom: 10px;\r\n    left: 100px;\r\n}\r\n\r\n.result-container {\r\n    display: flex;\r\n    flex-direction: column-reverse;\r\n    transition: all .5s;\r\n    opacity: 1;\r\n    max-height: 230px;\r\n    overflow-y: auto;\r\n    scrollbar-width: thin;\r\n    height: fit-content;\r\n}\r\n\r\n.result {\r\n    padding: 5px;\r\n    width: 200px;\r\n    text-align: center;\r\n    margin-bottom: 5px;\r\n    border-radius: 10px;\r\n    font-weight: bold;\r\n    font-size: 16px;\r\n    cursor: pointer;\r\n    display: flex;\r\n    justify-content: space-between;\r\n}\r\n\r\n.searchbar {\r\n    width: 100%;\r\n}\r\n\r\n.box {\r\n    position: relative;\r\n}\r\n\r\n.input {\r\n    padding: 5px;\r\n    width: 40px;\r\n    height: 35px;\r\n    background: none;\r\n    border: 2px solid black;\r\n    border-radius: 20px;\r\n    box-sizing: border-box;\r\n    font-size: 16px;\r\n    color: black;\r\n    outline: none;\r\n    transition: all .5s;\r\n    opacity: 0;\r\n}\r\n\r\n.show-chapters {\r\n    transition: all .5;\r\n    opacity: 1;\r\n    cursor: pointer;\r\n    pointer-events: auto;\r\n}\r\n\r\n.sidebar-input-container.hide-seek {\r\n    justify-content: flex-end;\r\n}\r\n\r\n.sidebar-input-container:hover .input {\r\n    width: 300px;\r\n    background: #F9F9F9;\r\n    border-radius: 10px;\r\n    opacity: 1;\r\n}\r\n\r\n.sidebar-input-container.hide-seek:hover .input {\r\n    width: 280px;\r\n}\r\n\r\n.open-sidebar-input-container .input {\r\n    width: 300px;\r\n    background: #F9F9F9;\r\n    border-radius: 10px;\r\n    opacity: 1;\r\n}\r\n\r\n.open-sidebar-input-container.hide-seek .input {\r\n    width: 280px;\r\n}\r\n\r\n.box i {\r\n    position: absolute;\r\n    top: 50%;\r\n    right: -6px;\r\n    transform: translate(-50%, -50%);\r\n    font-size: 26px;\r\n    color: black;\r\n    transition: all .2s;\r\n}\r\n\r\n.sidebar-input-container:hover i {\r\n    opacity: 0;\r\n    z-index: -1;\r\n}\r\n\r\n.open-sidebar-input-container i {\r\n    opacity: 0;\r\n    z-index: -1;\r\n}\r\n\r\n.open-searchbar .input {\r\n    width: 300px;\r\n    background: #F9F9F9;\r\n    border-radius: 10px;\r\n    opacity: 1;\r\n}\r\n\r\n.open-searchbar i {\r\n    position: absolute;\r\n    top: 50%;\r\n    right: -6px;\r\n    transform: translate(-50%, -50%);\r\n    font-size: 26px;\r\n    color: black;\r\n    transition: all .2s;\r\n    opacity: 0;\r\n}\r\n\r\n.sidebar-input-container:hover .result-container {\r\n    opacity: 1;\r\n}\r\n\r\n.sidebar-input-container:not(:hover) .input {\r\n    transition-delay: 2s;\r\n}\r\n\r\n.sidebar-input-container:not(:hover) i {\r\n    transition-delay: 2s;\r\n}\r\n\r\n.sidebar-input-container:not(:hover) .result-container {\r\n    transition-delay: 2s;\r\n    opacity: 0;\r\n}\r\n\r\n.open-sidebar-input-container .result-container {\r\n    opacity: 1;\r\n}\r\n\r\n.open-sidebar-input-container .result-container {\r\n    opacity: 0;\r\n}\r\n\r\n.upside-down {\r\n    transform: rotate(180deg);\r\n    transition: transform 0.3s;\r\n}\r\n\r\n@media only screen and (max-width: 768px) {\r\n    .mainSettings {\r\n        padding: 0 !important;\r\n    }\r\n\r\n    .show-close-icon {\r\n        opacity: 1;\r\n    }\r\n\r\n    .searchbar-container:not(:hover) {\r\n        transition-delay: 0s;\r\n    }\r\n\r\n    .sidebar-input-container:not(:hover) .input {\r\n        transition-delay: 0s;\r\n    }\r\n\r\n    .sidebar-input-container:not(:hover) i {\r\n        transition-delay: 0s;\r\n    }\r\n\r\n    .sidebar-input-container:not(:hover) .result-container {\r\n        transition-delay: 0s;\r\n        opacity: 0;\r\n    }\r\n\r\n    .sidebar-input-container:hover .input {\r\n        width: 170px;\r\n    }\r\n\r\n    .open-sidebar-input-container .input {\r\n        width: 170px;\r\n    }\r\n\r\n    .sidebar-input-container.hide-seek {\r\n        justify-content: center;\r\n    }\r\n\r\n    .open-sidebar-input-container.hide-seek {\r\n        justify-content: center;\r\n    }\r\n\r\n    .sidebar-input-container.hide-seek:hover .input {\r\n        width: 170px;\r\n    }\r\n\r\n    .open-sidebar-input-container.hide-seek .input {\r\n        width: 170px;\r\n    }\r\n\r\n    .sidebar-input-container:not(:hover) {\r\n        transition-delay: 0s;\r\n    }\r\n\r\n    .sidebar-input-container:not(:hover) .input,\r\n    i,\r\n    .result-container {\r\n        transition-delay: 0s;\r\n    }\r\n\r\n    .input {\r\n        height: 30px;\r\n    }\r\n\r\n    .close-input-icon {\r\n        left: calc(50vw + 110px);\r\n    }\r\n\r\n    .close-input {\r\n        left: calc(50vw + 110px);\r\n    }\r\n\r\n    .sidebar {\r\n        transition: all 0.5s;\r\n        height: 45dvh;\r\n        padding-bottom: 40px;\r\n    }\r\n\r\n    .defocus-input {\r\n        opacity: 0;\r\n        pointer-events: all;\r\n    }\r\n\r\n    .show-chapters {\r\n        right: -45px;\r\n    }\r\n\r\n    .sidebar {\r\n        width: var(--mobileWidth);\r\n        right: -200px;\r\n    }\r\n\r\n    .sidebar.experience_id-3 {\r\n        width: calc(100vw - 40px);\r\n        height: 80dvh;\r\n    }\r\n\r\n    .sidebar.experience_id-3.close-sideBar {\r\n        height: 45dvh;\r\n        width: 200px;\r\n    }\r\n\r\n    .open-toggle.experience_id-3 {\r\n        right: calc(100vw - 16px);\r\n    }\r\n\r\n    .open-toggle {\r\n        right: 230px;\r\n        opacity: 1;\r\n        bottom: 0px;\r\n        z-index: 1600;\r\n    }\r\n\r\n    .sidebar-container.open-toggle-solo {\r\n        right: 221px;\r\n        opacity: 1;\r\n        z-index: 9999;\r\n    }\r\n\r\n    .close-toggle {\r\n        right: 35px;\r\n        opacity: 1;\r\n        bottom: 35px;\r\n    }\r\n\r\n    .close-toggle.solo {\r\n        right: 28px;\r\n        opacity: 1;\r\n        bottom: 0px;\r\n    }\r\n\r\n    .open-sideBar {\r\n        right: 0;\r\n        opacity: 1;\r\n    }\r\n\r\n    .close-sideBar {\r\n        right: -200px;\r\n        opacity: 0;\r\n    }\r\n\r\n    .result-container {\r\n        padding-bottom: 15px;\r\n    }\r\n\r\n    .mobile-hide {\r\n        display: none;\r\n    }\r\n\r\n    .desktop-hide {\r\n        display: flex;\r\n        width: 100%;\r\n        height: fit-content;\r\n        gap: 8.5px;\r\n        background-color: #E1F5FE;\r\n        padding: 8px;\r\n        border-radius: 5px;\r\n        flex-wrap: wrap;\r\n        margin-top: -10px;\r\n        border-top-left-radius: 0;\r\n        border-top-right-radius: 0;\r\n    }\r\n\r\n    .show-sidebar-chapter-m {\r\n        display: none;\r\n    }\r\n\r\n    .sidebar-itm {\r\n        color: black;\r\n        width: 180px;\r\n        font-weight: lighter;\r\n    }\r\n\r\n    .sidebar-chapter-itm {\r\n        height: 34.5px;\r\n        width: 34.5px;\r\n    }\r\n\r\n    .psalms-btn {\r\n        width: 164px;\r\n    }\r\n\r\n    .sidebar-select {\r\n        font-size: 18px;\r\n    }\r\n\r\n    .show-sidebar-chapter {\r\n        margin-top: -10px;\r\n        border-top-left-radius: 0;\r\n        border-top-right-radius: 0;\r\n    }\r\n\r\n    .sidebar-selected-itm,\r\n    .sidebar-selected-itm-disabled,\r\n    .sidebar-selected-itm-win {\r\n        border-bottom-left-radius: 0;\r\n        border-bottom-right-radius: 0;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .experiences .experience_btn {\r\n        width: 180px;\r\n    }\r\n}\r\n\r\n.arrows-container {\r\n    position: absolute;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 30px;\r\n}\r\n\r\n.arrows-container .arrowUp,\r\n.arrows-container arrowDown {\r\n    cursor: pointer;\r\n}\r\n\r\n.showIcon {\r\n    animation-delay: 0.75s;\r\n    animation: showTheIcon 0.2s linear forwards;\r\n}\r\n\r\n.hideIcon {\r\n    animation-delay: 0.75s;\r\n    animation: hideTheIcon 0.2s linear forwards;\r\n}\r\n\r\n@keyframes showTheIcon {\r\n    from {\r\n        opacity: 0;\r\n    }\r\n\r\n    to {\r\n        opacity: 1;\r\n    }\r\n}\r\n\r\n@keyframes hideTheIcon {\r\n    from {\r\n        opacity: 1;\r\n    }\r\n\r\n    to {\r\n        opacity: 0;\r\n    }\r\n}\r\n\r\n.borderStyle {\r\n    border-radius: 6px;\r\n    padding: 3px;\r\n    border: 2px black solid;\r\n    border-color: var(--textColor) !important;\r\n    color: var(--textColor) !important;\r\n    backdrop-filter: blur(2px);\r\n    margin-bottom: 40px;\r\n    margin-right: -30px;\r\n    font-size: 10px;\r\n    height: 34px;\r\n    width: 34px;\r\n}\r\n\r\n.borderStyle:hover {\r\n    background-color: var(--bgColor);\r\n}\r\n\r\n.item {\r\n    overflow: hidden;\r\n    cursor: pointer;\r\n    flex: 0 0 50%;\r\n    box-sizing: border-box;\r\n    padding: 5px;\r\n    height: 35px !important;\r\n    display: flex !important;\r\n    justify-content: center;\r\n    align-items: center;\r\n    background-color: rgba(255, 255, 255, 0.099);\r\n    border-radius: 5px;\r\n    border: 1px var(--textColor) solid !important;\r\n    backdrop-filter: blur(10px);\r\n    color: var(--textColor) !important;\r\n}",
                "GeoJSONExperience": "@const css = thisBot.tags[\"GeoJSONExperience.css\"];\r\nconst css2 = thisBot.tags[\"App.css\"];\r\nconst { useState, useEffect, useMemo, useCallback, useRef } = os.appHooks;\r\n\r\nconst App = ({ from }) => {\r\n    const [search, setSearch] = useState(that?.query ? that.query : \"\");\r\n    const [page, setPage] = useState(0);\r\n    const [totalPages, setTotalPages] = useState(0);\r\n    const [allPlaces, setAllPlaces] = useState([...Object.values(tags[\"places-new\"])]);\r\n    const forwardBtnRef = useRef(null);\r\n\r\n    globalThis.locationSearch = search;\r\n    globalThis.setLocationSearch = setSearch;\r\n    globalThis.locationPage = page;\r\n    globalThis.setLocationPage = setPage;\r\n\r\n    useEffect(() => {\r\n        setTotalPages(Math.floor((allPlaces.length / 50)));\r\n    }, []);\r\n\r\n    const filterItems = useMemo(() => {\r\n        console.log(\"changed places\")\r\n        if (search === \"\") {\r\n            return [...allPlaces];\r\n        } else {\r\n            setPage(0);\r\n            return allPlaces.filter(place => {\r\n                return place.place.toLowerCase().includes(search.toLowerCase());\r\n            })\r\n        }\r\n    }, [search, allPlaces]);\r\n\r\n    useEffect(() => {\r\n        // if(!configBot.tags.miniMapPortal){\r\n        //     setCurrentExperience(0);\r\n        //     setOpenSidebar(false);\r\n        //     whisper(getBot('system', 'main.importer'), 'createCloseButton')\r\n        // }\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        if (page < totalPages) {\r\n            if (!masks.initMap) {\r\n                forwardBtnRef.current.style = { background: \"#B0BEC5\" }\r\n                setTimeout(() => {\r\n                    forwardBtnRef.current.style = { background: \"none\" }\r\n                }, 100)\r\n            } else {\r\n                forwardBtnRef.current.style = { background: \"none\" }\r\n            }\r\n        } else {\r\n            forwardBtnRef.current.style = { background: \"#CFD8DC\" }\r\n        }\r\n    }, [page, totalPages]);\r\n\r\n    const handleNav = useCallback(async () => {\r\n        if (from === \"repository\") {\r\n            if (globalThis.eventToolApp) {\r\n                RemoveApplicationByID(globalThis.EVENT_PANEL_ID);\r\n                globalThis.EVENT_PANEL_ID = null;\r\n                globalThis.eventToolApp = false;\r\n            }\r\n            let App = await getBot('system', \"ext_canvas.eventTool\").initInterface()\r\n            if (App) {\r\n                let id = uuid();\r\n                globalThis.eventToolApp = true;\r\n                globalThis.EVENT_PANEL_ID = id;\r\n                AddApplication({ id, App: <App initPage={2} id={id} />, minWidth: \"23rem\" });\r\n            }\r\n\r\n            return\r\n        }\r\n        if (globalThis.eventToolApp) {\r\n            RemoveApplicationByID(globalThis.EVENT_PANEL_ID);\r\n            globalThis.EVENT_PANEL_ID = null;\r\n            globalThis.eventToolApp = false;\r\n        }\r\n        if (globalThis.mapToolApp) {\r\n            RemoveApplicationByID(globalThis.MAP_PANEL_ID);\r\n            globalThis.MAP_PANEL_ID = null;\r\n            globalThis.mapToolApp = false;\r\n            return;\r\n        }\r\n    }, [])\r\n\r\n    return <>\r\n        <style>{css2}</style>\r\n        <div class=\"experience-container\" style={{ position: \"relative\" }}>\r\n            <style>{css}</style>\r\n            {!from && <div class=\"experience_title_container\">\r\n                <div class=\"experience_title_intro\">\r\n                    <span class=\"material-symbols-outlined experience_title_icon\">\r\n                        map\r\n                    </span>\r\n                    <span class=\"experience_title\">Bible Locations</span>\r\n                </div>\r\n                <button onClick={() => handleNav()} class=\"experience_title_back\">\r\n                    <span class=\"material-symbols-outlined\">\r\n                        arrow_back\r\n                    </span>\r\n                </button>\r\n            </div>}\r\n            <div class=\"geo-container\">\r\n                <div class=\"geo-container-items\">\r\n                    {\r\n                        filterItems.slice(page * 50, page * 50 + 49).map(item => {\r\n                            return <Buttons place={item} />\r\n                        })\r\n                    }\r\n                </div>\r\n            </div>\r\n            <div class=\"nav-container\" style={{ bottom: \"30px\" }}>\r\n                {\r\n                    <span style={{ background: page > 0 ? \"none\" : \"#CFD8DC\" }} class=\"material-symbols-outlined nav-btn\" onClick={() => {\r\n                        if (page > 0) {\r\n                            setPage(page - 1);\r\n                        }\r\n                    }}>\r\n                        undo\r\n                    </span>\r\n                }\r\n                <input\r\n                    class=\"search location\"\r\n                    placeholder=\"search\"\r\n                    value={search}\r\n                    onInput={e => setSearch(e.target.value)}\r\n                />\r\n                {\r\n                    <span ref={forwardBtnRef} class=\"material-symbols-outlined nav-btn\" onClick={() => {\r\n                        if (page < totalPages) {\r\n                            setPage(page + 1)\r\n                        }\r\n                    }}>\r\n                        redo\r\n                    </span>\r\n                }\r\n            </div>\r\n        </div>\r\n    </>\r\n}\r\n\r\nconst Buttons = ({ place }) => {\r\n    const handleClick = useCallback(() => {\r\n        console.log(\"hello\")\r\n        whisper(thisBot, \"handleGeoJsonSearch\", { place: place });\r\n        setOpenSidebar(false);\r\n        // setCurrentExperience(0);\r\n        // updateCustomHeight(0);\r\n        shout(\"closeShareButton\");\r\n    }, [place]);\r\n    return (\r\n        <>\r\n            <div onClick={() => { handleClick() }} class={`place ${!masks.initMap && locationSearch === \"jeru\" && place.place === \"Jerusalem\" ? \"blink\" : \"\"}`}>\r\n                <span>{place.place}</span>\r\n            </div>\r\n        </>\r\n    )\r\n}\r\n\r\nreturn App;",
                "GeoJSONExperience.css": ".nav-container{\r\n    margin-bottom: 5px;\r\n    margin-top: 5px;\r\n    display: flex;\r\n    gap: 10px;\r\n    width: 100%;\r\n}\r\n\r\n.search {\r\n    width: 100%;\r\n    height: 32px;\r\n    border-radius: 5px;\r\n    border: 1px solid black;\r\n    padding-left: 5px;\r\n}\r\n\r\n.geo-container{\r\n    height: calc(100% - 82px);\r\n    overflow: auto;\r\n    scrollbar-width: none;\r\n    display: flex;\r\n}\r\n\r\n.geo-container-items{\r\n    height: fit-content;\r\n    width: 100%;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    gap: 10px;\r\n    overflow: auto;\r\n    scrollbar-width: none;\r\n    cursor: pointer;\r\n}\r\n\r\n.blink{\r\n    animation: blink-ani ease 0.2s;\r\n    animation-iteration-count: 5;\r\n    animation-fill-mode: forwards;\r\n}\r\n\r\n@keyframes blink-ani {\r\n    0% {\r\n        background-color: #CFD8DC\r\n    }\r\n    50% {\r\n         background-color: #ECEFF1;\r\n    }\r\n    100% {\r\n        background-color: #CFD8DC\r\n    }\r\n}\r\n\r\n.place{\r\n    display: flex;\r\n    width: calc(50% - 25px);\r\n    background-color: #CFD8DC;\r\n    border-radius: 10px;\r\n    justify-content: flex-start;\r\n    align-items: center;\r\n    height: 35px;\r\n    white-space: nowrap;\r\n    word-wrap: break-word;\r\n    padding: 10px;\r\n    overflow: hidden;\r\n}\r\n\r\n.place:hover{\r\n    background-color: #ECEFF1;\r\n}\r\n\r\n.foot-container {\r\n    height: 35px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    margin-bottom: 5px;\r\n}\r\n\r\n.nav-btn{\r\n    border: 1px solid black;\r\n    padding: 3px;\r\n    border-radius: 5px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    font-size: 20px;\r\n    cursor: pointer;\r\n    background: none;\r\n}\r\n\r\n.nav-btn:active{\r\n    background: #ECEFF1\r\n}\r\n\r\n.foot-container .btn:hover {\r\n    background-color: #ECEFF1;\r\n}\r\n\r\n@media only screen and (max-width: 768px) {\r\n    .geo-container{\r\n        height: calc(45dvh - 92px);\r\n    }\r\n    .place{\r\n        width: calc(50% - 25px);\r\n    }\r\n    .search {\r\n        width: 95px;\r\n    }\r\n}",
                "HideAndSeekSideBar": "@os.unregisterApp(\"hideAndSeekSideBar\");\r\nos.registerApp(\"hideAndSeekSideBar\");\r\n\r\nconst { useState, useEffect, useCallback } = os.appHooks;\r\nconst SearchBarHideAndSeek = await thisBot.SearchBarHideAndSeek();\r\n\r\nconst HideSeekUIBar = () => {\r\n\r\n    const [openSidebar, setStateSideBar] = useState(false);\r\n\r\n    const setOpenSidebar = useCallback((val) => {\r\n        globalThis.SearchBarHideAndSeek = val;\r\n        setStateSideBar(val);\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        globalThis.hideAndSeekSidebar = setOpenSidebar;\r\n\r\n        return () => {\r\n            globalThis.hideAndSeekSidebar = false;\r\n        }\r\n    }, [])\r\n\r\n    return <>\r\n        <style>{thisBot.tags['google-icon.css']}</style>\r\n        <style>{thisBot.tags[\"App.css\"]}</style>\r\n        <link href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" rel=\"stylesheet\" />\r\n        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0\" />\r\n        {openSidebar && <>\r\n            <div class={`sidebar-container solo ${openSidebar ? \"open-toggle-solo\" : openSidebar === null ? \"\" : \"close-toggle\"}`}>\r\n                <div class=\"sidebar-toggle\" style={{ 'z-index': 2 }}>\r\n                    <span\r\n                        onCLick={() => {\r\n                            setOpenSidebar(!openSidebar);\r\n                            if (openSidebar) {\r\n                                setCurrentExperience(0);\r\n                                setQuery(\"\");\r\n                                shout(\"playSound\", { soundName: \"SidebarOpen\" });\r\n                            } else {\r\n                                shout(\"playSound\", { soundName: \"SidebarClose\" });\r\n                            }\r\n                        }}\r\n                        class={`material-symbols-outlined show-chapters borderStyle showIcon`}\r\n                    >\r\n                        {!openSidebar ? \"search\" : \"close\"}\r\n                    </span>\r\n                </div>\r\n            </div>\r\n            <div\r\n                id=\"sidebar-bar\"\r\n                class={`sidebar ${openSidebar ? \"open-sideBar\" : openSidebar === null ? \"\" : \"close-sideBar\"}`}\r\n                onPointerEnter={(e) => {\r\n                    if (e.currentTarget.id === \"sidebar-bar\") {\r\n                        setTagMask(gridPortalBot, \"portalZoomable\", false);\r\n                    }\r\n                }}\r\n                onPointerLeave={(e) => {\r\n                    if (e.currentTarget.id === \"sidebar-bar\") {\r\n                        setTagMask(gridPortalBot, \"portalZoomable\", true);\r\n                    }\r\n                }}\r\n            >\r\n                <SearchBarHideAndSeek />\r\n            </div>\r\n        </>}\r\n    </>\r\n\r\n}\r\n\r\nos.compileApp(\"hideAndSeekSideBar\", <HideSeekUIBar />);",
                "LoreCardContentRenderer": "@const LoreCardContentRenderer = ({type , content , link}) => {\r\n    switch(type) {\r\n        case \"a\":\r\n            return <a href={\"#\"} > {content} </a>;\r\n        case \"img\":\r\n            return <img src={link} alt=\"content\" />;\r\n        case \"para\":\r\n            return <p><b>\"\" THIS IS DEMO TEXT \"</b> {content}</p>;\r\n        case \"ol\":\r\n            return <ol>\r\n                {content.map(({type,content, link},index)=><li key={index}> <LoreCardContentRenderer content={content} type={type} link={link} /> </li>)}\r\n            </ol>;\r\n        case \"ul\":\r\n            return <ul>\r\n                {content.map(({type,content, link},index)=><li key={index}> <LoreCardContentRenderer content={content} type={type} link={link} /> </li>)}\r\n            </ul>;\r\n        default:\r\n            return <p>{content}</p>;\r\n    }\r\n}\r\n\r\nreturn {\r\n    LoreCardContentRenderer\r\n}",
                "LoreCardData": "@const data = [\r\n    {\r\n        title: \"Abraham\",\r\n        id: 0,\r\n        data: [\r\n            {\r\n                sideIcon: \"sell\",\r\n                id: 0,\r\n                headingTeritary: \"Tags\",\r\n                contents: [\r\n                    {\r\n                        type: \"ul\",\r\n                        content: [\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Abraham\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Sarah\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Issac\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Jacob\"\r\n                            },\r\n                        ]\r\n                    }\r\n                ]\r\n            },\r\n            {\r\n                sideIcon: \"quick_reference\",\r\n                id: 1,\r\n                headingTeritary: \"References\",\r\n                contents: [\r\n                    {\r\n                        type: \"ul\",\r\n                        content: [\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"https://www.biblestudy.org/\",\r\n                                content: \"Bible Study\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"https://en.wikipedia.org/wiki/Patriarchs_(Bible)\",\r\n                                content: \"Wikipedia\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"https://britishbibleschool.com/\",\r\n                                content: \"Bible School\"\r\n                            },\r\n                        ]\r\n                    }\r\n                ]\r\n            },\r\n            {\r\n                sideIcon: \"attach_file\",\r\n                id: 2,\r\n                headingTeritary: \"Related Media\",\r\n                contents: [\r\n                    {\r\n                        type: 'img',\r\n                        link: \"https://www.biblestudy.org/maps/lineage-from-abraham-to-jesus.webp\",\r\n                        content: \"Lineage\"\r\n                    }\r\n                ]\r\n            },\r\n            {\r\n                sideIcon: \"Topic\",\r\n                id: 3,\r\n                headingTeritary: \"Related Topics\",\r\n                contents: [\r\n                    {\r\n                        type: 'ol',\r\n                        content: [\r\n                            {\r\n                                type: 'a',\r\n                                link: \"https://www.biblestudy.org/maps/life-of-abraham-timeline.html\",\r\n                                content: \"Abraham Timeline\"\r\n                            },\r\n                            {\r\n                                type: 'a',\r\n                                link: \"https://www.biblestudy.org/basicart/who-was-melchizedek.html\",\r\n                                content: \"Who Was Melchizedek?\"\r\n                            },\r\n                            {\r\n                                type: 'a',\r\n                                link: \"https://www.biblestudy.org/maps/where-did-abraham-live.html\",\r\n                                content: \"Abraham's Home\"\r\n                            },\r\n                            {\r\n                                type: 'a',\r\n                                link: \"https://www.biblestudy.org/maps/journey-of-abraham-to-promised-land-and-egypt.html\",\r\n                                content: \"Journey to Canaan\"\r\n                            },\r\n                            {\r\n                                type: 'a',\r\n                                link: \"https://www.biblestudy.org/question/abraham-meets-jesus.html\",\r\n                                content: \" Meeting Jesus\"\r\n                            }\r\n                        ]\r\n                    }\r\n                ]\r\n            },\r\n            {\r\n                sideIcon: \"Info\",\r\n                id: 4,\r\n                headingTeritary: \"About\",\r\n                contents: [\r\n                    {\r\n                        type: 'para',\r\n                        content: \"Demo Text. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.\"\r\n                    },\r\n                    {\r\n                        type: 'para',\r\n                        content: \"It is through Abraham, the spiritual father of faithful Christians (Romans 4:16) and 'Friend of God' (James 2:23), that God started what would become the nation of Israel through his grandson Jacob (the founder of the twelve tribes of Israel).\"\r\n                    },\r\n                    {\r\n                        type: 'para',\r\n                        content: \"Abraham was originally named Abram (Genesis 17:1-5). He left his home in Ur of the Chaldees to live in Haran, but soon moved from there to live in the land of Canaan. ﻿Sarah, whose original name was Sarai, was the wife of Abraham. After God healed her so that she could have a family, she gave birth at 90 to Isaac. Sarah is the only woman in the Bible where her age at death, one-hundred and twenty-seven (127), is recorded.\"\r\n                    }\r\n                ],\r\n            }\r\n        ]\r\n    },\r\n    {\r\n        title: \"Abraham 2\",\r\n        id: 1,\r\n        data: [\r\n            {\r\n                sideIcon: \"sell\",\r\n                id: 0,\r\n                headingTeritary: \"Tags\",\r\n                contents: [\r\n                    {\r\n                        type: \"ul\",\r\n                        content: [\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Abraham\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Sarah\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Issac\"\r\n                            },\r\n                            {\r\n                                type: \"a\",\r\n                                link: \"#\",\r\n                                content: \"# Jacob\"\r\n                            },\r\n                        ]\r\n                    }\r\n                ]\r\n            },\r\n            {\r\n                sideIcon: \"quick_reference\",\r\n                id: 1,\r\n                headingTeritary: \"References\",\r\n                conten