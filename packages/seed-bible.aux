                                        {
                                            "noteId": 2026
                                        },
                                        "of Bethlehem, 123;"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
