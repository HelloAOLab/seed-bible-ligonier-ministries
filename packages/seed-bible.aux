                },
                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/14.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The War of the Kings"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "In those days Amraphel king of Shinar,",
                                        {
                                            "noteId": 4379
                                        },
                                        "Arioch king of Ellasar, Chedorlaomer king of Elam, and Tidal king of Goiim"
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "went to war against Bera king of Sodom, Birsha king of Gomorrah, Shinab king of Admah, Shemeber king of Zeboiim, and the king of Bela (that is, Zoar)."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The latter five came as allies to the Valley of Siddim (that is, the Salt Sea",
                                        {
                                            "noteId": 4380
                                        },
                                        ")."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "For twelve years they had been subject to Chedorlaomer, but in the thirteenth year they rebelled."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "In the fourteenth year, Chedorlaomer and the kings allied with him went out and defeated the Rephaites in Ashteroth-karnaim, the Zuzites in Ham, the Emites in Shaveh-kiriathaim,"
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and the Horites in the area of Mount Seir, as far as El-paran, which is near the desert."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Then they turned back to invade En-mishpat (that is, Kadesh), and they conquered the whole territory of the Amalekites, as well as the Amorites who lived in Hazazon-tamar."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the king of Sodom, the king of Gomorrah, the king of Admah, the king of Zeboiim, and the king of Bela (that is, Zoar) marched out and arrayed themselves for battle in the Valley of Siddim",
                                        {
                                            "noteId": 4381
                                        }
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "against Chedorlaomer king of Elam, Tidal king of Goiim, Amraphel king of Shinar, and Arioch king of Ellasar—four kings against five."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abram Rescues Lot"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Now the Valley of Siddim was full of tar pits, and as the kings of Sodom and Gomorrah fled, some men fell into the pits, but the survivors fled to the hill country."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The four kings seized all the goods of Sodom and Gomorrah and all their food, and they went on their way."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "They also carried off Abram’s nephew Lot and his possessions, since Lot was living in Sodom."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then an escapee came and reported this to Abram the Hebrew. Now Abram was living near the Oaks",
                                        {
                                            "noteId": 4382
                                        },
                                        "of Mamre the Amorite, a brother of Eshcol and Aner, all of whom were bound by treaty",
                                        {
                                            "noteId": 4383
                                        },
                                        "to Abram."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And when Abram heard that his relative had been captured, he mobilized the 318 trained men born in his household, and they set out in pursuit as far as Dan."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "During the night, Abram divided his forces and routed Chedorlaomer’s army, pursuing them as far as Hobah, north of Damascus."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "He retrieved all the goods, as well as his relative Lot and his possessions, together with the women and the rest of the people."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Melchizedek Blesses Abram"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "After Abram returned from defeating Chedorlaomer and the kings allied with him, the king of Sodom went out to meet him in the Valley of Shaveh (that is, the King’s Valley)."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Melchizedek king of Salem brought out bread and wine—since he was priest of God Most High",
                                        {
                                            "noteId": 4384
                                        },
                                        "—"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and he blessed Abram and said:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“Blessed be Abram by God Most High,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "Creator of heaven and earth,"
                                        }
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "and blessed be God Most High,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "who has delivered your enemies into your hand.”"
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        "Then Abram gave Melchizedek a tenth of everything."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The king of Sodom said to Abram, “Give me the people, but take the goods for yourself.”"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But Abram replied to the king of Sodom, “I have raised my hand to the LORD God Most High, Creator of heaven and earth,"
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "that I will not accept even a thread, or a strap of a sandal, or anything that belongs to you, lest you should say, ‘I have made Abram rich.’"
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "I will accept nothing but what my men have eaten and the share for the men who went with me—Aner, Eshcol, and Mamre. They may take their portion.”"
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4379,
                                    "reference": {
                                        "chapter": 14,
                                        "verse": 1
                                    },
                                    "text": "That is, Babylonia; also in verse 9"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4380,
                                    "reference": {
                                        "chapter": 14,
                                        "verse": 3
                                    },
                                    "text": "That is, the Dead Sea"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4381,
                                    "reference": {
                                        "chapter": 14,
                                        "verse": 8
                                    },
                                    "text": "That is, the Valley of the Dead Sea"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4382,
                                    "reference": {
                                        "chapter": 14,
                                        "verse": 13
                                    },
                                    "text": "Or Terebinths or Great Trees"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4383,
                                    "reference": {
                                        "chapter": 14,
                                        "verse": 13
                                    },
                                    "text": "Forms of the Hebrew berit are translated in most passages as covenant."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4384,
                                    "reference": {
                                        "chapter": 14,
                                        "verse": 18
                                    },
                                    "text": "Hebrew El-Elyon; also in verses 19, 20, and 22; cited in Hebrews 7:1"
                                }
                            ],
                            "number": 14
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/15.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_015_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_015_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_015.mp3"
                        },
                        "numberOfVerses": 24,
                        "previousChapterApiLink": "/api/BSB/GEN/13.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_013_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_013_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_013.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_014_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_014_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_014.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/14.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
                            "textDirection": "ltr",
                            "totalNumberOfChapters": 1189,
                            "totalNumberOfVerses": 31086,
                            "website": "https://berean.bible/"
                        }
                    },
                    "headers": {
                        "content-type": "application/json",
                        "last-modified": "Thu, 19 Dec 2024 17:49:01 GMT"
                    },
                    "status": 200,
                    "statusText": ""
                },
                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/15.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "God’s Covenant with Abram"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "After these events, the word of the LORD came to Abram in a vision:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“Do not be afraid, Abram."
                                        },
                                        {
                                            "poem": 2,
                                            "text": "I am your shield,"
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 2,
                                            "text": "your very great reward.”"
                                        }
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But Abram replied, “O Lord GOD, what can You give me, since I remain childless, and the heir of my house is Eliezer of Damascus?”"
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abram continued, “Behold, You have given me no offspring, so a servant in my household will be my heir.”"
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the word of the LORD came to Abram, saying, “This one will not be your heir, but one who comes from your own body will be your heir.”"
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And the LORD took him outside and said, “Now look to the heavens and count the stars, if you are able.” Then He told him, “So shall your offspring be.”",
                                        {
                                            "noteId": 4385
                                        }
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Abram believed the LORD, and it was credited to him as righteousness.",
                                        {
                                            "noteId": 4386
                                        }
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The LORD also told him, “I am the LORD, who brought you out of Ur of the Chaldeans to give you this land to possess.”"
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "God Confirms His Promise"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But Abram replied, “Lord GOD, how can I know that I will possess it?”"
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the LORD said to him, “Bring Me a heifer, a goat, and a ram, each three years old, along with a turtledove and a young pigeon.”"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Abram brought all these to Him, split each of them down the middle, and laid the halves opposite each other. The birds, however, he did not cut in half."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And the birds of prey descended on the carcasses, but Abram drove them away."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "As the sun was setting, Abram fell into a deep sleep, and suddenly great terror and darkness overwhelmed him."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD said to Abram, “Know for certain that your descendants will be strangers in a land that is not their own, and they will be enslaved and mistreated four hundred years."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But I will judge the nation they serve as slaves, and afterward they will depart with many possessions.",
                                        {
                                            "noteId": 4387
                                        }
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "You, however, will go to your fathers in peace and be buried at a ripe old age."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "In the fourth generation your descendants will return here, for the iniquity of the Amorites is not yet complete.”"
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When the sun had set and darkness had fallen, behold, a smoking firepot and a flaming torch appeared and passed between the halves of the carcasses."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "On that day the LORD made a covenant with Abram, saying, “To your descendants I have given this land—from the river of Egypt to the great River Euphrates—"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the land of the Kenites, Kenizzites, Kadmonites,"
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Hittites, Perizzites, Rephaites,"
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Amorites, Canaanites, Girgashites, and Jebusites.”"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4385,
                                    "reference": {
                                        "chapter": 15,
                                        "verse": 5
                                    },
                                    "text": "Cited in Romans 4:18"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4386,
                                    "reference": {
                                        "chapter": 15,
                                        "verse": 6
                                    },
                                    "text": "Cited in Romans 4:3, Romans 4:22, Galatians 3:6, and James 2:23"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4387,
                                    "reference": {
                                        "chapter": 15,
                                        "verse": 14
                                    },
                                    "text": "Cited in Acts 7:6–7"
                                }
                            ],
                            "number": 15
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/16.json",
