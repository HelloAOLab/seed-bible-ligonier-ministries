                "95cec14c-4022-40d8-9226-6ddc6077cfe2GEN 1": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
