                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/18.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Three Visitors"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Then the LORD appeared to Abraham by the Oaks",
                                        {
                                            "noteId": 4399
                                        },
                                        "of Mamre in the heat of the day, while he was sitting at the entrance of his tent."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And Abraham looked up and saw three men standing nearby. When he saw them, he ran from the entrance of his tent to meet them and bowed low to the ground."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“My lord,” said Abraham, “if I have found favor in your sight, please do not pass your servant by."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Let a little water be brought, that you may wash your feet and rest yourselves under the tree."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And I will bring a bit of bread so that you may refresh yourselves. This is why you have passed your servant’s way. After that, you may continue on your way.”",
                                        {
                                            "lineBreak": true
                                        },
                                        "“Yes,” they replied, “you may do as you have said.”"
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Abraham hurried into the tent and said to Sarah, “Quick! Prepare three seahs of fine flour,",
                                        {
                                            "noteId": 4400
                                        },
                                        "knead it, and bake some bread.”"
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Meanwhile, Abraham ran to the herd, selected a tender and choice calf, and gave it to a servant, who hurried to prepare it."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Then Abraham brought curds and milk and the calf that had been prepared, and he set them before the men and stood by them under the tree as they ate."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Sarah Laughs at the Promise"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Where is your wife Sarah?” they asked.",
                                        {
                                            "lineBreak": true
                                        },
                                        "“There, in the tent,” he replied."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD said, “I will surely return to you at this time next year, and your wife Sarah will have a son!”",
                                        {
                                            "lineBreak": true
                                        },
                                        "Now Sarah was behind him, listening at the entrance to the tent."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And Abraham and Sarah were already old and well along in years; Sarah had passed the age of childbearing."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So she laughed to herself, saying, “After I am worn out and my master is old, will I now have this pleasure?”"
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the LORD asked Abraham, “Why did Sarah laugh and say, ‘Can I really bear a child when I am old?’"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Is anything too difficult for the LORD? At the appointed time I will return to you—in about a year—and Sarah will have a son.”",
                                        {
                                            "noteId": 4401
                                        }
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But Sarah was afraid, so she denied it and said, “I did not laugh.”",
                                        {
                                            "lineBreak": true
                                        },
                                        "“No,” replied the LORD, “but you did laugh.”"
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abraham Intercedes for Sodom"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When the men got up to leave, they looked out over Sodom, and Abraham walked along with them to see them off."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the LORD said, “Shall I hide from Abraham what I am about to do?"
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abraham will surely become a great and powerful nation, and through him all the nations of the earth will be blessed."
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "For I have chosen him, so that he will command his children and his household after him to keep the way of the LORD by doing what is right and just, in order that the LORD may bring upon Abraham what He has promised.”"
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD said, “The outcry against Sodom and Gomorrah is great. Because their sin is so grievous,"
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "I will go down to see if their actions fully justify the outcry that has reached Me. If not, I will find out.”"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the two men turned away and went toward Sodom, but Abraham remained standing before the LORD."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Abraham stepped forward and said, “Will You really sweep away the righteous with the wicked?"
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "What if there are fifty righteous ones in the city? Will You really sweep it away and not spare the place for the sake of the fifty righteous ones who are there?"
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Far be it from You to do such a thing—to kill the righteous with the wicked, so that the righteous and the wicked are treated alike. Far be it from You! Will not the Judge of all the earth do what is right?”"
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So the LORD replied, “If I find fifty righteous ones within the city of Sodom, on their account I will spare the whole place.”"
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Abraham answered, “Now that I have ventured to speak to the Lord—though I am but dust and ashes—"
                                    ],
                                    "number": 27,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "suppose the fifty righteous ones lack five. Will You destroy the whole city for the lack of five?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "He replied, “If I find forty-five there, I will not destroy it.”"
                                    ],
                                    "number": 28,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Once again Abraham spoke to the LORD, “Suppose forty are found there?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "He answered, “On account of the forty, I will not do it.”"
                                    ],
                                    "number": 29,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Abraham said, “May the Lord not be angry, but let me speak further. Suppose thirty are found there?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "He replied, “If I find thirty there, I will not do it.”"
                                    ],
                                    "number": 30,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Abraham said, “Now that I have ventured to speak to the Lord, suppose twenty are found there?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "He answered, “On account of the twenty, I will not destroy it.”"
                                    ],
                                    "number": 31,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Finally, Abraham said, “May the Lord not be angry, but let me speak once more. Suppose ten are found there?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "And He answered, “On account of the ten, I will not destroy it.”"
                                    ],
                                    "number": 32,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When the LORD had finished speaking with Abraham, He departed, and Abraham returned home."
                                    ],
                                    "number": 33,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4399,
                                    "reference": {
                                        "chapter": 18,
                                        "verse": 1
                                    },
                                    "text": "Or Terebinths or Great Trees"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4400,
                                    "reference": {
                                        "chapter": 18,
                                        "verse": 6
                                    },
                                    "text": "3 seahs is approximately 19.8 dry quarts or 21.9 liters (probably about 24.5 pounds or 11.1 kilograms of flour)."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4401,
                                    "reference": {
                                        "chapter": 18,
                                        "verse": 14
                                    },
                                    "text": "Cited in Romans 9:9"
                                }
                            ],
                            "number": 18
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/19.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_019_G.mp3",
