                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/17.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "Abraham to Father Many Nations"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "When Abram was ninety-nine years old, the LORD appeared to him and said, “I am God Almighty.",
                                        {
                                            "noteId": 4393
                                        },
                                        "Walk before Me and be blameless."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "I will establish My covenant between Me and you, and I will multiply you exceedingly.”"
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Abram fell facedown, and God said to him,"
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "“As for Me, this is My covenant with you: You will be the father of many nations."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "No longer will you be called Abram,",
                                        {
                                            "noteId": 4394
                                        },
                                        "but your name will be Abraham,",
                                        {
                                            "noteId": 4395
                                        },
                                        "for I have made you a father of many nations.",
                                        {
                                            "noteId": 4396
                                        }
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "I will make you exceedingly fruitful; I will make nations of you, and kings will descend from you."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "I will establish My covenant as an everlasting covenant between Me and you and your descendants after you, to be your God and the God of your descendants after you."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And to you and your descendants I will give the land where you are residing—all the land of Canaan—as an eternal possession; and I will be their God.”"
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Covenant of Circumcision"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "God also said to Abraham, “You must keep My covenant—you and your descendants in the generations after you."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "This is My covenant with you and your descendants after you, which you are to keep: Every male among you must be circumcised."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "You are to circumcise the flesh of your foreskin, and this will be a sign of the covenant between Me and you."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Generation after generation, every male must be circumcised when he is eight days old, including those born in your household and those purchased from a foreigner—even those who are not your offspring."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Whether they are born in your household or purchased, they must be circumcised. My covenant in your flesh will be an everlasting covenant."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But if any male is not circumcised, he will be cut off from his people; he has broken My covenant.”"
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then God said to Abraham, “As for Sarai your wife, do not call her Sarai, for her name is to be Sarah.",
                                        {
                                            "noteId": 4397
                                        }
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And I will bless her and will surely give you a son by her. I will bless her, and she will be the mother of nations; kings of peoples will descend from her.”"
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Abraham fell facedown. Then he laughed and said to himself, “Can a child be born to a man who is a hundred years old? Can Sarah give birth at the age of ninety?”"
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And Abraham said to God, “O that Ishmael might live under Your blessing!”"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But God replied, “Your wife Sarah will indeed bear you a son, and you are to name him Isaac.",
                                        {
                                            "noteId": 4398
                                        },
                                        "I will establish My covenant with him as an everlasting covenant for his descendants after him."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "As for Ishmael, I have heard you, and I will surely bless him; I will make him fruitful and multiply him greatly. He will become the father of twelve rulers, and I will make him into a great nation."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But I will establish My covenant with Isaac, whom Sarah will bear to you at this time next year.”"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When He had finished speaking with Abraham, God went up from him."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "On that very day Abraham took his son Ishmael and all those born in his household or purchased with his money—every male among the members of Abraham’s household—and he circumcised them, just as God had told him."
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Abraham was ninety-nine years old when he was circumcised,"
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and his son Ishmael was thirteen;"
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abraham and his son Ishmael were circumcised on the same day."
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And all the men of Abraham’s household—both servants born in his household and those purchased from foreigners—were circumcised with him."
                                    ],
                                    "number": 27,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4393,
                                    "reference": {
                                        "chapter": 17,
                                        "verse": 1
                                    },
                                    "text": "Hebrew El-Shaddai"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4394,
                                    "reference": {
                                        "chapter": 17,
                                        "verse": 5
                                    },
                                    "text": "Abram means exalted father."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4395,
                                    "reference": {
                                        "chapter": 17,
                                        "verse": 5
                                    },
                                    "text": "Abraham means father of many."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4396,
                                    "reference": {
                                        "chapter": 17,
                                        "verse": 5
                                    },
                                    "text": "Cited in Romans 4:17"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4397,
                                    "reference": {
                                        "chapter": 17,
                                        "verse": 15
                                    },
                                    "text": "Both Sarai and Sarah mean princess; the change in spelling may reflect the difference in dialect between Ur and Canaan."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4398,
                                    "reference": {
                                        "chapter": 17,
                                        "verse": 19
                                    },
                                    "text": "Isaac means he laughs."
                                }
                            ],
                            "number": 17
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/18.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_018_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_018_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_018.mp3"
                        },
                        "numberOfVerses": 27,
                        "previousChapterApiLink": "/api/BSB/GEN/16.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_016_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_016_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_016.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_017_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_017_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_017.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/17.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
