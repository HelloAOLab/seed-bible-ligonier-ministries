                "db610436-2507-4341-b45e-a2c0ff2422d9/api/BSB/GEN/10.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Table of Nations"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "This is the account of Noah’s sons Shem, Ham, and Japheth, who also had sons after the flood."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Japhethites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Japheth:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Gomer, Magog, Madai, Javan, Tubal, Meshech, and Tiras."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Gomer:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Ashkenaz, Riphath, and Togarmah."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the sons of Javan:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Elishah, Tarshish, the Kittites, and the Rodanites.",
                                        {
                                            "noteId": 4358
                                        }
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "From these, the maritime peoples separated into their territories, according to their languages, by clans within their nations."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Hamites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Ham:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Cush, Mizraim, Put, and Canaan."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Cush:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Seba, Havilah, Sabtah,",
                                        {
                                            "noteId": 4359
                                        },
                                        "Raamah, and Sabteca.",
                                        {
                                            "lineBreak": true
                                        },
                                        "And the sons of Raamah:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Sheba and Dedan."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Cush was the father of Nimrod, who began to be a mighty one",
                                        {
                                            "noteId": 4360
                                        },
                                        "on the earth."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "He was a mighty hunter before",
                                        {
                                            "noteId": 4361
                                        },
                                        "the LORD; so it is said, “Like Nimrod, a mighty hunter before the LORD.”"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "His kingdom began in Babylon, Erech, Accad, and Calneh, in the land of Shinar.",
                                        {
                                            "noteId": 4362
                                        }
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "From that land he went forth into Assyria, where he built Nineveh, Rehoboth-Ir, Calah,"
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and Resen, which is between Nineveh and the great city of Calah."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Mizraim was the father of the Ludites, the Anamites, the Lehabites, the Naphtuhites,"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Pathrusites, the Casluhites (from whom the Philistines came), and the Caphtorites.",
                                        {
                                            "noteId": 4363
                                        }
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Canaan was the father of Sidon his firstborn,",
                                        {
                                            "noteId": 4364
                                        },
                                        "and of the Hittites,"
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Jebusites, the Amorites, the Girgashites,"
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Hivites, the Arkites, the Sinites,"
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Arvadites, the Zemarites, and the Hamathites.",
                                        {
                                            "lineBreak": true
                                        },
                                        "Later the Canaanite clans were scattered,"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and the borders of Canaan extended from Sidon toward Gerar as far as Gaza, and then toward Sodom, Gomorrah, Admah, and Zeboiim, as far as Lasha."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "These are the sons of Ham according to their clans, languages, lands, and nations."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Semites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And sons were also born to Shem, the older brother of Japheth;",
                                        {
                                            "noteId": 4365
                                        },
                                        "Shem was the forefather of all the sons of Eber."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Shem:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Elam, Asshur, Arphaxad, Lud, and Aram."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Aram:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Uz, Hul, Gether, and Mash.",
                                        {
                                            "noteId": 4366
                                        }
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Arphaxad was the father of Shelah,",
                                        {
                                            "noteId": 4367
                                        },
                                        "and Shelah was the father of Eber."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Two sons were born to Eber: One was named Peleg,",
                                        {
                                            "noteId": 4368
                                        },
                                        "because in his days the earth was divided, and his brother was named Joktan."
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Joktan was the father of Almodad, Sheleph, Hazarmaveth, Jerah,"
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Hadoram, Uzal, Diklah,"
                                    ],
                                    "number": 27,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Obal, Abimael, Sheba,"
                                    ],
                                    "number": 28,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Ophir, Havilah, and Jobab. All these were sons of Joktan."
                                    ],
                                    "number": 29,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Their territory extended from Mesha to Sephar, in the eastern hill country."
                                    ],
                                    "number": 30,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "These are the sons of Shem, according to their clans, languages, lands, and nations."
                                    ],
                                    "number": 31,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "All these are the clans of Noah’s sons, according to their generations and nations. From these the nations of the earth spread out after the flood."
                                    ],
                                    "number": 32,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4358,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 4
                                    },
                                    "text": "SP and some MT manuscripts (see also LXX and 1 Chronicles 1:7); most MT manuscripts Dodanites"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4359,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 7
                                    },
                                    "text": "Sabtah is a variant of Sabta; see 1 Chronicles 1:9."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4360,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 8
                                    },
                                    "text": "Or who established himself as a mighty warrior or who became the first fearless leader"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4361,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 9
                                    },
                                    "text": "Or in defiance of; twice in this verse"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4362,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 10
                                    },
                                    "text": "That is, Babylonia"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4363,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 14
                                    },
                                    "text": "Some translators adjust the Hebrew word order to the Casluhites, and the Caphtorites (from whom the Philistines came); see also Jeremiah 47:4 and Amos 9:7."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4364,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 15
                                    },
                                    "text": "Or of the Sidonians, the foremost"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4365,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 21
                                    },
                                    "text": "Or Shem, whose older brother was Japheth"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4366,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 23
                                    },
                                    "text": "Hebrew; LXX and 1 Chronicles 1:17 Meshech"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4367,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 24
                                    },
                                    "text": "Hebrew; LXX (see also Luke 3:35–36) And Arphaxad was the father of Cainan, and Cainan was the father of Shelah,"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4368,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 25
                                    },
                                    "text": "Peleg means division."
                                }
                            ],
                            "number": 10
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/11.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_011_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_011_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_011.mp3"
                        },
                        "numberOfVerses": 32,
                        "previousChapterApiLink": "/api/BSB/GEN/9.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_009_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_009_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_009.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_010_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_010_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_010.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/10.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
