                            "souer": "https://openbible.com/audio/souer/BSB_02_Exo_001.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_02_Exo_002_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_02_Exo_002_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_02_Exo_002.mp3"
                        },
                        "thisChapterLink": "/api/BSB/EXO/2.json",
