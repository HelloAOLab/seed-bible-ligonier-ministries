                "confetti.scss": ".confetti-wrapper {\r\n  position: relative;\r\n  min-height: 100%;\r\n  overflow: hidden;\r\n}\r\n\r\n[class|=\"confetti\"] {\r\n  position: absolute;\r\n}\r\n\r\n$colors: (#2971f9, #ef3d4d, #f9ca16, #7d3af2);\r\n\r\n@for $i from 0 through 150 {\r\n  $w: random(8);\r\n  $l: random(100);\r\n  .confetti-#{$i} {\r\n    width: #{$w}px;\r\n    height: #{$w*0.4}px;\r\n    background-color: nth($colors, random(4));\r\n    top: 150%;\r\n    left: unquote($l+\"%\");\r\n    opacity: random() + 0.5;\r\n    transform: rotate(#{random()*360}deg);\r\n\t  animation: drop-#{$i} unquote(3+random()+\"s\") unquote(random()+\"s\") infinite;\r\n\t  animation-timing-function: ease-in-out;\r\n  }\r\n  \r\n  @keyframes drop-#{$i} {\r\n\t50% {\r\n\t  top: unquote(random(10)+\"%\");\r\n\t  left: unquote($l+random(15)+\"%\");\r\n\t}\r\n    100% {\r\n      top: 110%;\r\n      left: unquote($l+random(15)+\"%\");\r\n    }\r\n  }\r\n}",
                "dimension": "home_1",
                "explodeParent": "@let parentSection = getBot(byTag(\"isSection\", true), byTag(\"sectionName\", that.sectionName));\r\nconst isSingleBook = that.isSingleBook;\r\n\r\nif (isSingleBook) {\r\n    parentSection = getBot(byTag(\"isBook\", true), byTag(\"bookName\", that.sectionName));\r\n}\r\n\r\nif(parentSection?.tags?.isInExplodedView || !globalThis.hideSeekPlaying) return;\r\n\r\nparentSection && !isSingleBook  && parentSection.setAsExplodedView({focusON: parentSection.tags.sectionRank === 7 || globalThis.skipAnimation});\r\nconst sectionExplodeSound = [\"String_01c\" , \"String_02e\" , \"String_04g\" , \"String_05a\" ,  \"String_07e\" , \"String_08f\" , \"String_10a\" , \"String_11c\"];\r\nawait os.sleep(globalThis.skipAnimation ? 700 : 1000);\r\n\r\nconst soundName = sectionExplodeSound[globalThis.skipAnimation ? 7 - parentSection.tags.sectionRank : parentSection.tags.sectionRank];\r\n\r\nshout(\"playSound\",{soundName});\r\n\r\nif (isSingleBook) {\r\n        try {\r\n            parentSection.shiftFocus({onlyZ: true, duration: 0.8});\r\n        }catch {\r\n        }\r\n        parentSection.tryToHighlightSelf({});\r\n        await os.sleep(400);\r\n        parentSection.unhighlightSelf({delayInSeconds: 0.20});\r\n        await os.sleep(200);\r\n}\r\n\r\nawait os.sleep(globalThis.skipAnimation ? 700 : 1000);\r\n\r\nif (!globalThis.skipAnimation){\r\n    if(!isSingleBook) {\r\n        await thisBot.highlightBooksinSection({sectionRank: parentSection.tags.sectionRank, validInteger: that.validInteger});\r\n    }\r\n}",
                "focusOnBook": "@\r\nreturn\r\nlet bookName = that.bookname;\r\nsetVersesState([])\r\nlet bookArrangementObj = getBot(\"system\", \"introduction.manager\").tags.bibleArrangementsArray[0];\r\n// os.log(bookArrangementObj,'bookArrangementObj')\r\nlet name = null;\r\nlet sectionName = null;\r\nlet commonName = null;\r\nupdateCustomHeight(0)\r\ntry{\r\n    setVersesState([])\r\n}catch{\r\n    os.log('not globaled yet')\r\n}\r\n   let MainBot =  getBot('phrase','firstPhrase')\r\n\r\n\r\nfor(let i = 0; i < bookArrangementObj.length; i++){\r\n    name = bookArrangementObj[i].name;\r\n    // os.log(bookArrangementObj[i].sections,i)\r\n    let sections = Object.keys(bookArrangementObj[i].sections);\r\n    for(let j = 0; j < sections.length; j++){\r\n        sectionName = sections[j];\r\n        let sectionArray = bookArrangementObj[i].sections[sections[j]];\r\n        for(let k = 0; k < sectionArray.length; k++){\r\n            if(sectionArray[k].commonName === that.bookname){\r\n                commonName = sectionArray[k].commonName;\r\n            }\r\n            if(commonName){\r\n                break\r\n            }\r\n        }\r\n        if(commonName){\r\n            break\r\n        }\r\n    }\r\n    if(commonName){\r\n        break\r\n    }\r\n}\r\n\r\nif(!commonName) globalThis.arrowActionsFreeze = false;\r\n\r\nasync function openBook(bookBot,commonName){\r\n    shout('closeFormMenu')\r\n    if(bookBot.masks.isSelected)\r\n    {\r\n        bible.openAt(`${bookBot.tags.bookName} ${that.chapter}:1`)\r\n        await os.sleep(100)\r\n        updateCustomHeight(0.8)\r\n        globalThis.arrowActionsFreeze = false;\r\n    }\r\n    else\r\n    {\r\n        setTagMask(bookBot, \"searchSelect\", {commonName: commonName, chapter: that.chapter}, \"tempLocal\");\r\n        await bookBot.interact().then(async () => {\r\n            if(!bookBot.masks.isSelected)\r\n            {\r\n                setTagMask(bookBot, \"searchSelect\", {commonName: commonName, chapter: that.chapter}, \"tempLocal\");\r\n                await bookBot.interact().then(async () => {\r\n                    if(!bookBot.masks.isSelected)\r\n                    {\r\n                        setTagMask(bookBot, \"searchSelect\", {commonName: commonName, chapter: that.chapter}, \"tempLocal\");\r\n                        await bookBot.interact();\r\n                    }\r\n                })\r\n            }\r\n\r\n        });\r\n        globalThis.arrowActionsFreeze = false;\r\n    }\r\n    try{\r\n        setVersesState([])\r\n    }catch{\r\n        os.log('setVersesState not global yet')\r\n    }\r\n}\r\n\r\nlet interactWithBook = () => {\r\n    let bookBot = getBot(byTag(\"bookName\", commonName), byTag(\"isBook\", true));\r\n    // console.log(bookBot);\r\n   if(bookBot){\r\n        os.focusOn(bookBot, {\r\n            duration: 1,\r\n            easing: \"quadratic\",\r\n            // zoom: 10\r\n        }).then(async() => {\r\n            // os.log(commonName,'commonName')\r\n           openBook(bookBot,commonName);\r\n        })\r\n    }\r\n}\r\n\r\nlet interactWithSection = async () => {\r\n    let sectionBot = getBot(byTag(\"isSection\", true), byTag('sectionName',sectionName.toLowerCase()));\r\n    os.log(sectionBot,sectionName,'sectionBotdd');\r\n\r\n    // Double time is for interaction and select\r\n    await sectionBot.interact({ notATour: true});\r\n    await sectionBot.interact({ notATour: true});\r\n    interactWithBook();\r\n    // setTimeout(() => {\r\n        // let bookBot = getBot(byTag(\"bookName\", commonName));\r\n        // os.focusOn(bookBot, {\r\n        //     duration: 1,\r\n        //     easing: \"quadratic\",\r\n        //     zoom: 10\r\n        // }).then(() => {\r\n        //     whisper(bookBot, \"interact\", {center: true, chapter: that.chapter, stayClose: true})\r\n        //     bible.openAt(`${commonName} ${that.chapter}:1`)\r\n        // })\r\n        // interactWithBook()\r\n    // }, 4000)\r\n}\r\n\r\n// isMainWordLowerCover\r\n\r\n// infoLabel\r\n\r\nconst mainWordBibleOldTestament = getBot(\"isOldTestament\", true);\r\nconst mainWordBibleNewTestament = getBot(\"isNewTestament\", true);\r\n\r\nconst bookTestament = globalThis.findNameRank(commonName)?.testament === \"Old Testament\" ? mainWordBibleOldTestament : mainWordBibleNewTestament;\r\nif(bookTestament) {\r\n    bookTestament.convertIntoArrangement();\r\n    await os.sleep(4000);    \r\n}\r\n\r\nlet bibleLowerCover = getBot(byTag(\"isMainWordLowerCover\", true));\r\nlet infoLabelBot = getBot(\"infoLabel\");\r\nlet sectionBot = getBot(byTag(\"sectionName\", sectionName));\r\nlet bookBot = getBot(byTag(\"bookName\", commonName));\r\nlet formMenu = getBot(\"system\", \"baseElements.formMenu\");\r\n\r\nwhisper(formMenu, \"closeFormMenu\");\r\n\r\n// os.log(bookBot,'bookBot1');\r\nif(bookBot){\r\n    // openBook(bookBot,commonName)\r\n    interactWithBook();\r\n}else{\r\n    interactWithSection();\r\n}  ",
                "getQuizData": "@let quizUrl = \"https://docs.google.com/spreadsheets/d/e/2PACX-1vTCHSKTi8n4i085NJv6-yvWCpKkr_Zvmj9WYc5q2PGql1xzzqiMMDMOirsD2jPehoJal_OdMdg3hg2j/pub?gid=0&single=true&output=tsv\"\r\nlet quizData = await web.get(quizUrl).then(e => {\r\n    return e.data;\r\n}).catch(e => {\r\n    os.toast(e);\r\n    return null;\r\n})\r\n\r\nfunction tsvJSON(tsv){\r\n\r\n    var lines=tsv.split(\"\\n\");\r\n\r\n    var result = [];\r\n\r\n    var headers=lines[0].split(\"\\t\");\r\n    for(let i = 0; i < headers.length; i++){\r\n        headers[i] = headers[i].replace(\"\\r\", \"\")\r\n    }\r\n\r\n    for(var i=1;i<lines.length;i++){\r\n        var obj = {};\r\n        var currentline=lines[i].split(\"\\t\");\r\n        for(var j=0;j<headers.length;j++){\r\n            obj[headers[j]] = currentline[j].replace(\"\\r\", \"\");\r\n        }\r\n        result.push(obj);\r\n    }\r\n\r\n    //return result; //JavaScript object\r\n    return result; //JSON\r\n}\r\n\r\nlet QUIZJson;\r\n\r\nif(quizData){\r\n    try{\r\n        QUIZJson = tsvJSON(quizData);\r\n        for(let i = 0; i< QUIZJson.length; i++){\r\n            QUIZJson[i][\"options\"] = [\r\n                {\r\n                    v: QUIZJson[i][\"option1\"]\r\n                },\r\n                {\r\n                    v: QUIZJson[i][\"option2\"]\r\n                },\r\n                {\r\n                    v: QUIZJson[i][\"option3\"]\r\n                },\r\n                {\r\n                    v: QUIZJson[i][\"option4\"]\r\n                }\r\n            ];\r\n            delete(QUIZJson[i][\"option1\"]);\r\n            delete(QUIZJson[i][\"option2\"]);\r\n            delete(QUIZJson[i][\"option3\"]);\r\n            delete(QUIZJson[i][\"option4\"]);\r\n        }\r\n        return QUIZJson;\r\n    }catch(e){\r\n        os.toast(e);\r\n        return e\r\n    }\r\n}else{\r\n    return null;\r\n}",
                "google-icon.css": ".material-symbols-outlined {\r\n  font-variation-settings:\r\n  'FILL' 0,\r\n  'wght' 400,\r\n  'GRAD' 0,\r\n  'opsz' 24\r\n}",
                "handleGeoJsonSearch": "@let geoJson;\r\nconsole.log(that)\r\nif(that.place.place === that.place.geojson){\r\n    geoJson = await web.get(`https://raw.githubusercontent.com/Bored-Wizard/isreal_geojson/main/${that.place.geojson}.geojson`);\r\n}else{\r\n    geoJson = await web.get(`https://raw.githubusercontent.com/openbibleinfo/Bible-Geocoding-Data/main/geometry/${that.place.geojson}.geojson`);\r\n}\r\nif(geoJson.status === 200){\r\n    whisper(getBot('system', 'ext_geoImporter.importer'), \"loadMap\", {file: geoJson.data, loadGame: that?.loadGame ? true : false})\r\n}else{\r\n    os.toast(\"Something went wrong while retrieving the data\");\r\n}",
                "hide-seek.css": ".welcome-copy {\r\n    font-size: 16px;   \r\n}\r\n\r\n.welcome-copy .buttons {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    width: 100%;\r\n    align-items: center;\r\n}",
                "highlightBooksinSection": "@// .filter((bookBot)=> (bookBot.tags.bookRank % 3) === that.validInteger)\r\n\r\nlet bookBots = getBots(byTag(\"#bookRank\" , (bookRank)=> !!bookRank && bookRank>-1),byTag(\"sectionRank\",that.sectionRank));\r\n\r\nbookBots = bookBots.sort((a,b)=>b.tags.bookRank - a.tags.bookRank);\r\n\r\nawait os.sleep(300);\r\n\r\nlet strings = {\r\n    '5': {\r\n        0: \"String_06c\",\r\n        1: \"String_08f\",\r\n        2: \"String_09g\",\r\n        3: \"String_10a\",\r\n        4: \"String_11c\"\r\n        },\r\n    \"12\":{\r\n            0: \"String_01c\",\r\n            1: \"String_03f\",\r\n            2: \"String_04g\",\r\n            3: \"String_05a\",\r\n            4: \"String_06c\",\r\n            5: \"String_08f\",\r\n            6: \"String_09g\",\r\n            7: \"String_10a\",\r\n            8: \"String_11c\",\r\n            9: \"String_13f\",\r\n            10: \"String_14g\",\r\n            11: \"String_11c\"\r\n        },\r\n        \"9\":{\r\n            0: \"String_01c\",\r\n            1: \"String_03f\",\r\n            2: \"String_04g\",\r\n            3: \"String_05a\",\r\n            4: \"String_06c\",\r\n            5: \"String_08f\",\r\n            6: \"String_09g\",\r\n            7: \"String_10a\",\r\n            8: \"String_11c\"\r\n            },\r\n        \"17\":{\r\n            0: \"String_01c\",\r\n            1: \"String_03f\",\r\n            2: \"String_04g\",\r\n            3: \"String_06c\",\r\n            4: \"String_07e\",\r\n            5: \"String_09g\",\r\n            6: \"String_02e\",\r\n            7: \"String_05a\",\r\n            8: \"String_06c\",\r\n            9: \"String_08f\",\r\n            10: \"String_09g\",\r\n            11: \"String_11c\",\r\n            12: \"String_04g\",\r\n            13: \"String_06c\",\r\n            14: \"String_08f\",\r\n            15: \"String_09g\",\r\n            16: \"String_11c\",\r\n        },\r\n        \"4\":{\r\n            0:\"String_06c\",\r\n            1:\"String_08f\",\r\n            2:\"String_09g\",\r\n            3:\"String_11c\",\r\n        },\r\n        '21':{\r\n            0: \"String_01c\",\r\n            1: \"String_03f\",\r\n            2: \"String_04g\",\r\n            3: \"String_06c\",\r\n            4: \"String_07e\",\r\n            5: \"String_09g\",\r\n            6: \"String_02e\",\r\n            7: \"String_05a\",\r\n            8: \"String_06c\",\r\n            9: \"String_08f\",\r\n            10: \"String_09g\",\r\n            11: \"String_11c\",\r\n            12: \"String_04g\",\r\n            13: \"String_06c\",\r\n            14: \"String_08f\",\r\n            15: \"String_09g\",\r\n            16: \"String_11c\",\r\n            17: \"String_12e\",\r\n            18: \"String_13f\",\r\n            19: \"String_14g\",\r\n            20: \"String_16c\",\r\n        },\r\n        \"1\":{\r\n            0:'String_06c'\r\n        }\r\n}\r\n\r\nfor(let i = 0;i<bookBots.length; i++) {\r\n    if (globalThis.skipAnimation || !globalThis.hideSeekPlaying){\r\n        continue;\r\n    }\r\n    let obj = strings[bookBots.length];\r\n    const book = bookBots[i];\r\n    try {\r\n        book.shiftFocus({onlyZ: true, duration: 0.4});\r\n    }catch {\r\n        \r\n    }\r\n    book.tryToHighlightSelf({highlightingFrom: \"transition\", unhighlightDelayInSeconds: (0.25 - 0.2)});\r\n    shout(\"playSound\",{soundName: obj[i]});\r\n    await os.sleep(250);\r\n}\r\n\r\nawait os.sleep(500); ",
                "initLandBetweenExperience": "const landBetweenManager = getBot(\"isLandBetweenManager\", true);\r\n\r\nsetTag(configBot, \"gridPortal\", null);\r\nsetTag(configBot, \"mapPortal\", \"theLandBetween\");\r\nshout(\"clearUi\")\r\nlandBetweenManager.initializeLandBetween();\r\nsetTagMask(introductionManager, \"isASectionMakingTourGuide\", true);\r\nsetTagMask(thisBot, \"isInBibleAnimation\", true);",
                "initialize": "@if (configBot.tags.systemPortal) return;\r\nawait os.unregisterApp('searchBar');\r\nawait os.registerApp('searchBar', thisBot);\r\nconst css = thisBot.tags[\"App.css\"];\r\nconst { useState, useEffect, useMemo, useCallback } = os.appHooks;\r\nif (typeof introductionSearchBar === \"undefined\") {\r\n    globalThis.introductionSearchBar = thisBot;\r\n}\r\n\r\n\r\nmasks['constants'] = []\r\nif (!masks['currentTraySwap']) {\r\n    masks['currentTraySwap'] = 0\r\n}\r\nif (!masks.index)\r\n    masks.index = 0\r\nconst App = () => {\r\n    const [openSidebar, setOpenSidebar] = useState(false);\r\n    const [currentExperience, setCurrentExperience] = useState(0);\r\n    globalThis.setCurrentExperience = setCurrentExperience\r\n    globalThis.currentExperience = currentExperience\r\n    const [isUsersHidden, setHideUsers] = useState(false)\r\n    const [transIcon, setTransIcon] = useState(true)\r\n    const [Name, setName] = useState(masks[\"currentTray\"] ? getBot('id', masks[\"currentTray\"]).tags.currentBook : 'GRID')\r\n    const [theDimension, setDimension] = useState(masks['currentDimension'] || 'home')\r\n    const [dimensionNum, setDimensionNum] = useState(masks['currentDimensionNum'] || 1)\r\n    const [options, setOptions] = useState(false)\r\n    const [update, setUpdate] = useState(false)\r\n    globalThis.setOptions = setOptions\r\n    const SearchBar = thisBot.SearchBar();\r\n    // Define a dynamic experiences object\r\n    const [experiences, setExperiences] = useState({\r\n        0: <SearchBar />,\r\n    });\r\n    globalThis.SetExperiences = setExperiences\r\n    // Memoize the current experience based on `currentExperience`\r\n    const Experience = useMemo(() => thisBot.SearchBar(), [openSidebar]);\r\n\r\n\r\n\r\n    globalThis.setOpenSidebar = setOpenSidebar;\r\n    globalThis.openSidebar = openSidebar;\r\n    globalThis.currentExperience = currentExperience;\r\n    globalThis.setCurrentExperience = setCurrentExperience;\r\n\r\n    function Swap(direaction) {\r\n        let bots = SortBots()\r\n        if (direaction === 'up' && masks.index !== bots.length - 1)\r\n            masks.index++\r\n        else if (direaction === 'down' && masks.index !== 0)\r\n            masks.index--\r\n        else if (masks.index === 0)\r\n            masks.index = bots.length - 1\r\n        else if (masks.index === bots.length - 1)\r\n            masks.index = 0\r\n        // os.log(bots[masks.index])\r\n        let current = getBot('id', bots[masks.index][1])\r\n        current.onPointerEnter()\r\n        os.focusOn(current, { zoom: 20, space: 'local' })\r\n    }\r\n\r\n    const SortBots = useCallback(() => {\r\n        const bots = getBots(\"unhighlighting\")\r\n        const tempArray = []\r\n        for (const bot of bots) {\r\n            tempArray.push([bot.tags[dim + 'Z'], bot.id])\r\n        }\r\n        // os.log(tempArray)\r\n        return tempArray.sort((a, b) => a[0] - b[0]).reverse();\r\n    }, [])\r\n    useEffect(() => {\r\n        const interval = setInterval(() => {\r\n            setName(masks[\"currentTray\"] && masks[\"currentTray\"] !== null ? getBot('id', masks[\"currentTray\"]).tags.currentBook : 'Canvas')\r\n        }, 10)\r\n        return () => clearInterval(interval);\r\n    }, [])\r\n\r\n    return <>\r\n        <style>{css}</style>\r\n        <link href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" rel=\"stylesheet\" />\r\n        <link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0\" />\r\n        {<div class={`sidebar-container experience_id-${currentExperience} ${openSidebar ? \"open-toggle\" : openSidebar === null ? \"\" : \"close-toggle\"}`}>\r\n            {null/*<span\r\n                onClick={() => {\r\n                    CloseAllInNav()\r\n                    shout(\"playSound\", { soundName: \"SidebarClose\" });\r\n                    setOpenSidebar(false);\r\n                    if (setQuery) {\r\n                        setQuery(\"\");\r\n                    }\r\n                }}\r\n                class=\"borderStyle material-symbols-outlined\"\r\n            >\r\n                close\r\n            </span>*/}\r\n        </div>}\r\n        <>\r\n            <div\r\n                id=\"sidebar-bar\"\r\n                style={{ zIndex: '9999', background: 'white !important' }}\r\n                onPointerEnter={(e) => {\r\n                    if (e.currentTarget.id === \"sidebar-bar\") {\r\n                        setTagMask(gridPortalBot, \"portalZoomable\", false);\r\n                    }\r\n                }}\r\n                onPointerLeave={(e) => {\r\n                    if (e.currentTarget.id === \"sidebar-bar\") {\r\n                        setTagMask(gridPortalBot, \"portalZoomable\", true);\r\n                    }\r\n                }}\r\n                class={`sidebar experience_id-${currentExperience} ${openSidebar ? \"open-sideBar\" : openSidebar === null ? \"close-sideBar\" : \"close-sideBar\"}`}>\r\n                <style>\r\n                    {\r\n                        `\r\n                      :root {\r\n                        --mobileWidth: ${currentExperience === 3 ? '100%' : '200px'};\r\n                        }\r\n                    `\r\n                    }\r\n                </style>\r\n                {openSidebar && <Experience />}\r\n            </div>\r\n        </>\r\n    </>\r\n}\r\n\r\nfunction generateQuery(params) {\r\n    let queryArray = [];\r\n    for (let key in params) {\r\n        if (params.hasOwnProperty(key)) {\r\n            queryArray.push(encodeURIComponent(key) + '=' + encodeURIComponent(params[key]));\r\n        }\r\n    }\r\n    return queryArray.join('&');\r\n}\r\n\r\n// Function to attach query string to URL\r\nfunction attachQueryToURL(url, params) {\r\n    const queryString = generateQuery(params);\r\n    return url + (url.includes('?') ? '&' : '?') + queryString;\r\n}\r\n\r\nconst setTranslation = async () => {\r\n    let translationId = configBot.tags.translationId\r\n    if (translationId) {\r\n        // console.log(translationId, \"translation id\")\r\n        // os.toast(`Loading ${translationId} translation`)\r\n        // let url = `https://aolab-bible-api.netlify.app/api/translations/getTranslation`;\r\n        // let params = {\r\n        //     uid: translationId\r\n        // }\r\n        // let queryUrl = attachQueryToURL(url, params);\r\n        // let result = await web.get(queryUrl);\r\n        // if (result.status === 200 && result.data.data) {\r\n        //     let translation = JSON.parse(result.data.data.translation);\r\n        //     console.log(translation, \"translationdata\")\r\n        //     let bookData = await web.get(translation.listOfBooksApiLink);\r\n\r\n        //     let book0 = bookData.data.books[0];\r\n        //     ChangeTranslation(translation.id, book0, translation.origin);\r\n        //     setTagMask(thisBot, \"selectedTranslation\", translation, \"local\");\r\n        // } else {\r\n        //     console.log(translationId, \"translation adding\")\r\n        //     let available_translations_req = await web.get(\"https://bible.helloao.org/api/available_translations.json\");\r\n        //     let trValue = {\r\n        //         pass: false,\r\n        //         value: null\r\n        //     };\r\n        //     if (available_translations_req.status === 200) {\r\n        //         setTagMask(thisBot, \"allTranslations\", available_translations_req.data.translations, \"local\");\r\n        //         available_translations_req.data.translations.map(translationData => {\r\n        //             if (translationData.id.toLowerCase() === translationId.toLowerCase()) {\r\n        //                 trValue.pass = true;\r\n        //                 trValue.value = translationData;\r\n        //             }\r\n        //         })\r\n        //         let bookData = await web.get(`https://bible.helloao.org/api/${trValue.value.id}/books.json`);\r\n        //         let book0 = bookData.data.books[0];\r\n        //         ChangeTranslation(trValue.value.id, book0, \"https://bible.helloao.org\");\r\n        //         setTagMask(thisBot, \"selectedTranslation\", trValue.value, \"local\");\r\n        //     }\r\n        // }\r\n        // configBot.tags.translationId = null;\r\n        // return\r\n    } else {\r\n        if (!masks?.selectedTranslation) {\r\n            return\r\n        }\r\n        let selectedTranslation = masks?.selectedTranslation;\r\n        if (selectedTranslation?.listOfBooksApiLink?.includes(\"https\")) {\r\n            web.get(`${selectedTranslation.listOfBooksApiLink}`).then(e => {\r\n                let book0 = e.data.books[0];\r\n                ChangeTranslation(selectedTranslation.id, book0, selectedTranslation.origin);\r\n            }).catch(e => {\r\n                console.log(e)\r\n            })\r\n        } else {\r\n            web.get(`https://bible.helloao.org/api/${selectedTranslation.id}/books.json`).then(e => {\r\n                let book0 = e.data.books[0];\r\n                ChangeTranslation(selectedTranslation.id, book0, \"https://bible.helloao.org\");\r\n            }).catch(e => {\r\n                console.log(e)\r\n            })\r\n        }\r\n    }\r\n}\r\n\r\nconst tr = () => {\r\n    if (globalThis?.ChangeTranslation) {\r\n        setTranslation()\r\n    } else {\r\n        setTimeout(() => {\r\n            tr()\r\n        }, 500)\r\n    }\r\n}\r\n\r\ntr()\r\n\r\nos.compileApp('searchBar', <App />);\r\n",
                "lore-card.css": "html {\r\n  font-size: 62.5%;\r\n  box-sizing: border-box;\r\n  font-family: 'Pacifico'; \r\n}\r\n\r\n*, *::after, *::before {\r\n    margin: 0;\r\n    padding: 0;\r\n    box-sizing: border-box;\r\n}\r\n\r\n.material-symbols-outlined {\r\n  font-variation-settings:\r\n  'FILL' 0,\r\n  'wght' 400,\r\n  'GRAD' 0,\r\n  'opsz' 24\r\n}\r\n\r\n/* Width */\r\n::-webkit-scrollbar {\r\n  width: 2px;\r\n  height: 2px;\r\n}\r\n\r\n/* Track */\r\n::-webkit-scrollbar-track {\r\n  box-shadow: inset 0 0 2px rgb(219, 210, 210);\r\n  border-radius: 2px;\r\n}\r\n\r\n/* Handle */\r\n::-webkit-scrollbar-thumb {\r\n  border-radius: 5px;\r\n  background: darkgray;\r\n}\r\n\r\n/* Handle on hover */\r\n::-webkit-scrollbar-thumb:hover {\r\n  background: rgb(197, 194, 194)\r\n}\r\n\r\n\r\n.lore-card-container {\r\n    width: 100vw;\r\n    height: 100dvh;\r\n    background: transparent;\r\n    overflow: hidden;\r\n    top: 0;\r\n    left: 0;\r\n}\r\n\r\n.lore-card-container a {\r\n    text-decoration: underline;\r\n}\r\n\r\n.lore-cards-user-actions {\r\n    position: fixed;\r\n    z-index: inherit;\r\n    right: 15px;\r\n    bottom: 15px;\r\n}\r\n\r\n.lore-cards-left-actions {\r\n    position: fixed;\r\n    z-index: 10;\r\n    left: 15px;\r\n    bottom: 15px;\r\n}\r\n\r\n.description__programming {\r\n    text-align: center;\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    width: 60rem;\r\n    height: 72rem;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    transform: translate(-50%,-50%);\r\n}\r\n\r\n.description__programming__card {\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    backface-visibility: hidden;\r\n    text-align: center;\r\n    width: 53.33%;\r\n    height: 66.66%;\r\n    transform-origin: bottom left;\r\n    box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);\r\n    transform: translateX(0);\r\n    border-radius: 12px;\r\n    background-color: orangered;\r\n    transition: all 1s; \r\n}\r\n\r\n\r\n.description_card_front {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    border-radius: inherit;\r\n    height: 100%;\r\n    width: 100%;\r\n    background-color: inherit;\r\n    transform: rotateY(0);\r\n    z-index: 2;\r\n}\r\n\r\n.description_card_front > .content {\r\n    height: calc(100% - 100px);\r\n    overflow: auto;\r\n    text-align: justify;\r\n    padding: 8px 2rem;\r\n}\r\n\r\n.description_card_front_footer {\r\n    position: absolute;\r\n    bottom: 0;\r\n    left: 0;\r\n    display: flex;\r\n    width: 100%;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    padding: 0.8rem 1.6rem;\r\n    flex-direction: row-reverse;\r\n}\r\n\r\n.description_card_back {\r\n    position: absolute;\r\n    top: 0;\r\n    z-index: 1;\r\n    left: 0;\r\n    border-radius: inherit;\r\n    height: 100%;\r\n    width: 100%;\r\n    display: grid;\r\n    place-items: center;\r\n    padding: inherit;\r\n    background-image: linear-gradient(to bottom right, #fff, rgba(0, 0, 0, 1));\r\n    transform: rotateY(180deg);\r\n}\r\n\r\n.description_card_back img {\r\n    width: 13rem;\r\n    animation: rotateCircle 1s linear infinite;\r\n}\r\n\r\n\r\n.description__programming__card--0 {\r\n    background-color:  white;\r\n    transform: rotateZ(-8deg) translateX(-50%) translateY(-50%);\r\n    color: black;\r\n    z-index: 10;\r\n}\r\n\r\n.description__programming__card--1 {\r\n    background-color:  black;\r\n    transform: rotateZ(-4deg) translateX(-50%) translateY(-50%);\r\n    color: white;\r\n    z-index: 20;\r\n}\r\n\r\n.description__programming__card--2 {\r\n    background-color:  white;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(-50%);\r\n    color: black;\r\n    z-index: 30;\r\n}\r\n\r\n.description__programming__card--3 {\r\n    background-color:  black;\r\n    transform: rotateZ(4deg) translateX(-50%) translateY(-50%);\r\n    z-index: 40;\r\n    color: white;\r\n}\r\n\r\n.description__programming__card--4 {\r\n    background-color:  white;\r\n    transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n    z-index: 50;\r\n    color: black;\r\n}\r\n\r\n\r\n.description__programming__card--0.focus-out {\r\n    opacity: 0.85;\r\n    transform: scale(0.95) rotateZ(-8deg) translateX(-50%) translateY(-50%);\r\n}\r\n\r\n\r\n.description__programming__card--1.focus-out {\r\n    opacity: 0.85;\r\n    transform: scale(0.95) rotateZ(-4deg) translateX(-50%) translateY(-50%);\r\n}\r\n\r\n\r\n.description__programming__card--2.focus-out {\r\n    opacity: 0.85;\r\n    transform: scale(0.95) rotateZ(0deg) translateX(-50%) translateY(-50%);\r\n}\r\n\r\n\r\n.description__programming__card--3.focus-out {\r\n    opacity: 0.85;\r\n    transform: scale(0.95) rotateZ(4deg) translateX(-50%) translateY(-50%);\r\n}\r\n\r\n\r\n.description__programming__card--4.focus-out {\r\n    opacity: 0.85;\r\n    transform: scale(0.95) rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n}\r\n\r\n.heading__teritary.title {\r\n    text-align: center;\r\n    flex: 1;\r\n}\r\n\r\n.heading__teritary {\r\n    padding: 1rem;\r\n}\r\n\r\n.description__programming__card--0 p {\r\n      border-bottom: 2px solid #000;\r\n}\r\n\r\n.description__programming__card--1 p {\r\n      border-bottom: 2px solid white;\r\n}\r\n\r\n.description__programming__card--2 p {\r\n      border-bottom: 2px solid #000;\r\n}\r\n\r\n.description__programming__card--3 p {\r\n      border-bottom: 2px solid #fff;\r\n}\r\n\r\n.description__programming__card--4 p {\r\n      border-bottom: 2px solid #000;\r\n}\r\n\r\ndiv.description_card_front > .content > * {\r\n    font-size: 1.4rem;\r\n    line-height: 1.3;\r\n    padding: 8px 0;\r\n}\r\n\r\ndiv.description_card_front > .content > ul, div.description_card_front > .content > ol {\r\n    padding: 8px 15px;\r\n}\r\n\r\n\r\ndiv.description__programming__card--0 * {\r\n    text-shadow: -1px 1px 1px white;\r\n    color: black !important;\r\n}\r\n\r\ndiv.description__programming__card--1 * {\r\n    text-shadow: -1px 1px 1px black;\r\n    color: white !important;\r\n}\r\n\r\ndiv.description__programming__card--2 * {\r\n    text-shadow: -1px 1px 1px white;\r\n    color: black !important;\r\n}\r\n\r\ndiv.description__programming__card--3 * {\r\n    text-shadow: -1px 1px 1px black;\r\n    color: white !important;\r\n}\r\n\r\ndiv.description__programming__card--4 * {\r\n    text-shadow: -1px 1px 1px white;\r\n    color: black !important;\r\n}\r\n\r\n.description__programming__card__icon--small {\r\n    height: 2rem;\r\n    width: 2rem;\r\n    font-size: 2rem;\r\n    position: absolute;\r\n    top: 2rem;\r\n    left: 2rem;\r\n}\r\n\r\n.description__programming__card__icon--0 {\r\n    font-size: 1.6rem;\r\n    text-decoration: none;\r\n    font-family: sans-serif;\r\n    color: transparent;\r\n}\r\n\r\n.description__programming__card__icon--1 {\r\n    height: 4rem;\r\n    width: 4rem;\r\n    padding-bottom: 2rem;\r\n}\r\n\r\n.description__programming__card p {\r\n    font-size: 1.2rem;\r\n}\r\n\r\n\r\n.description__programming__card.target {\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1.05) !important;\r\n    z-index: 60;\r\n    opacity: 1 !important;\r\n}\r\n\r\n.description__programming__card.target::after {\r\n    position: fixed;\r\n    top: 54px;\r\n    left: -20%;\r\n    content: \"\";\r\n    width: 140%;\r\n    height: calc(100% - 110px);\r\n    z-index: -1;\r\n    opacity: 0.7;\r\n    backdrop-filter: blur(2px);\r\n    -webkit-backdrop-filter: blur(2px);\r\n}\r\n\r\n.description__programming__card.target .description_card_back img{\r\n    animation: none;\r\n}\r\n\r\n.description__programming__card.collected .description_card_back {\r\n    animation: comeUp 0s linear forwards 1.5s, goDown 0s linear forwards 4.5s;\r\n}\r\n\r\n.description__programming__card.collected.description__programming__card--0 {\r\n    transform-origin: bottom left;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1);\r\n    animation: flipBack 1s linear forwards 1s, flipUp 2s linear forwards 4s , rotate0 0.5s linear forwards 6s;\r\n}\r\n\r\n.description__programming__card.collected.description__programming__card--1 {\r\n    transform-origin: bottom left;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1);\r\n    animation: flipBack 1s linear forwards 1s, flipUp 2s linear forwards 4s , rotate1 0.5s linear forwards 6s;\r\n}\r\n\r\n.description__programming__card.collected.description__programming__card--2 {\r\n    transform-origin: bottom left;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1);\r\n    animation: flipBack 1s linear forwards 1s, flipUp 2s linear forwards 4s , rotate2 0.5s linear forwards 6s;\r\n}\r\n\r\n.description__programming__card.collected.description__programming__card--3 {\r\n    transform-origin: bottom left;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1);\r\n    animation: flipBack 1s linear forwards 1s, flipUp 2s linear forwards 4s , rotate3 0.5s linear forwards 6s;\r\n}\r\n\r\n.description__programming__card.collected.description__programming__card--4 {\r\n    transform-origin: bottom left;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1);\r\n    animation: flipBack 1s linear forwards 1s, flipUp 2s linear forwards 4s , rotate4 0.5s linear forwards 6s;\r\n}\r\n\r\n.description__programming__card.startpoint {\r\n    transform-origin: bottom;\r\n    transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(180deg);\r\n}\r\n\r\n.description__programming__card.startpoint .description_card_back {\r\n    z-index: 3;\r\n    animation: goDown 0s linear forwards 1.5s;\r\n}\r\n\r\n.description__programming__card.startpoint.description__programming__card--0 {\r\n    animation: flipUp 2s linear forwards 1s, rotate0 0.5s linear forwards 3s;\r\n}\r\n\r\n.description__programming__card.startpoint.description__programming__card--1 {\r\n    animation: flipUp 2s linear forwards 1s, rotate1 0.5s linear forwards 3s;\r\n}\r\n\r\n.description__programming__card.startpoint.description__programming__card--2 {\r\n    animation: flipUp 2s linear forwards 1s, rotate2 0.5s linear forwards 3s;\r\n}\r\n\r\n.description__programming__card.startpoint.description__programming__card--3 {\r\n    animation: flipUp 2s linear forwards 1s, rotate3 0.5s linear forwards 3s;\r\n}\r\n\r\n.description__programming__card.startpoint.description__programming__card--4 {\r\n    animation: flipUp 2s linear forwards 1s, rotate4 0.5s linear forwards 3s;\r\n}\r\n\r\n\r\n@keyframes rotate0 { \r\n    0% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(-8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n}\r\n\r\n@keyframes rotate1 { \r\n    0% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(-4deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n}\r\n\r\n@keyframes rotate2 { \r\n    0% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n}\r\n\r\n@keyframes rotate3 { \r\n    0% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(4deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n}\r\n\r\n@keyframes rotate4 { \r\n    0% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%);\r\n        transform-origin: bottom left;\r\n    }\r\n}\r\n\r\n\r\n@keyframes comeUp { \r\n    0% {\r\n        z-index: 1;\r\n    }\r\n\r\n    100% {\r\n        z-index: 3;\r\n    }\r\n}\r\n\r\n@keyframes goDown { \r\n    0% {\r\n        z-index: 3;\r\n    }\r\n\r\n    100% {\r\n        z-index: 1;\r\n    }\r\n}\r\n\r\n@keyframes flipBack { \r\n    0% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(0deg);\r\n        transform-origin: bottom;\r\n    }\r\n    100% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(180deg);\r\n        transform-origin: bottom;\r\n    }\r\n}\r\n\r\n@keyframes flipUp { \r\n    0% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(180deg);\r\n        transform-origin: bottom;\r\n    }\r\n\r\n    49.99% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(0deg);\r\n        transform-origin: bottom;\r\n    }\r\n\r\n    50% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(0deg);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    60% {\r\n        transform: rotateZ(0deg) translateX(-50%) translateY(calc(-50% + 4rem)) scale(1) rotateY(0deg);\r\n        transform-origin: bottom left;\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(8deg) translateX(-50%) translateY(-50%) scale(1) rotateY(0deg);\r\n        transform-origin: bottom left;\r\n    }\r\n}\r\n\r\n@keyframes rotateCircle { \r\n    0% {\r\n        transform: rotateZ(0deg);\r\n    }\r\n\r\n    100% {\r\n        transform: rotateZ(360deg);\r\n    }\r\n}\r\n\r\n\r\n@media (max-width: 700px) {\r\n  .description__programming {\r\n    width: 92vw;\r\n    height: 100%;\r\n  }\r\n\r\n  .description__programming__card {\r\n    width: 90%;\r\n    height: calc(100% - 22rem);\r\n  }\r\n}\r\n\r\n@media (max-width: 540px) {\r\n    lore-card-container {\r\n        height: 100dvh;\r\n    }\r\n}",
                "onAppSetup": "@// console.log(that, \"appSetup\")",
                "onEggHatch": "@tags.testLaunch = false;",
                "onGridClick": "@// setOpenSidebar(false)\r\n// os.downloadBots([thisBot],'boto')\r\nif(globalThis.hideAndSeekSidebar) globalThis.hideAndSeekSidebar(false)",
