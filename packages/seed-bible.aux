                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_005.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/5.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
