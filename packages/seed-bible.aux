                },
                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/10.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Table of Nations"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "This is the account of Noah’s sons Shem, Ham, and Japheth, who also had sons after the flood."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Japhethites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Japheth:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Gomer, Magog, Madai, Javan, Tubal, Meshech, and Tiras."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Gomer:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Ashkenaz, Riphath, and Togarmah."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the sons of Javan:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Elishah, Tarshish, the Kittites, and the Rodanites.",
                                        {
                                            "noteId": 4358
                                        }
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "From these, the maritime peoples separated into their territories, according to their languages, by clans within their nations."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Hamites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Ham:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Cush, Mizraim, Put, and Canaan."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Cush:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Seba, Havilah, Sabtah,",
                                        {
                                            "noteId": 4359
                                        },
                                        "Raamah, and Sabteca.",
                                        {
                                            "lineBreak": true
                                        },
                                        "And the sons of Raamah:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Sheba and Dedan."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Cush was the father of Nimrod, who began to be a mighty one",
                                        {
                                            "noteId": 4360
                                        },
                                        "on the earth."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "He was a mighty hunter before",
                                        {
                                            "noteId": 4361
                                        },
                                        "the LORD; so it is said, “Like Nimrod, a mighty hunter before the LORD.”"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "His kingdom began in Babylon, Erech, Accad, and Calneh, in the land of Shinar.",
                                        {
                                            "noteId": 4362
                                        }
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "From that land he went forth into Assyria, where he built Nineveh, Rehoboth-Ir, Calah,"
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and Resen, which is between Nineveh and the great city of Calah."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Mizraim was the father of the Ludites, the Anamites, the Lehabites, the Naphtuhites,"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Pathrusites, the Casluhites (from whom the Philistines came), and the Caphtorites.",
                                        {
                                            "noteId": 4363
                                        }
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Canaan was the father of Sidon his firstborn,",
                                        {
                                            "noteId": 4364
                                        },
                                        "and of the Hittites,"
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Jebusites, the Amorites, the Girgashites,"
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Hivites, the Arkites, the Sinites,"
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the Arvadites, the Zemarites, and the Hamathites.",
                                        {
                                            "lineBreak": true
                                        },
                                        "Later the Canaanite clans were scattered,"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and the borders of Canaan extended from Sidon toward Gerar as far as Gaza, and then toward Sodom, Gomorrah, Admah, and Zeboiim, as far as Lasha."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "These are the sons of Ham according to their clans, languages, lands, and nations."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Semites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And sons were also born to Shem, the older brother of Japheth;",
                                        {
                                            "noteId": 4365
                                        },
                                        "Shem was the forefather of all the sons of Eber."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Shem:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Elam, Asshur, Arphaxad, Lud, and Aram."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The sons of Aram:",
                                        {
                                            "lineBreak": true
                                        },
                                        "Uz, Hul, Gether, and Mash.",
                                        {
                                            "noteId": 4366
                                        }
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Arphaxad was the father of Shelah,",
                                        {
                                            "noteId": 4367
                                        },
                                        "and Shelah was the father of Eber."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Two sons were born to Eber: One was named Peleg,",
                                        {
                                            "noteId": 4368
                                        },
                                        "because in his days the earth was divided, and his brother was named Joktan."
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Joktan was the father of Almodad, Sheleph, Hazarmaveth, Jerah,"
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Hadoram, Uzal, Diklah,"
                                    ],
                                    "number": 27,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Obal, Abimael, Sheba,"
                                    ],
                                    "number": 28,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Ophir, Havilah, and Jobab. All these were sons of Joktan."
                                    ],
                                    "number": 29,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Their territory extended from Mesha to Sephar, in the eastern hill country."
                                    ],
                                    "number": 30,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "These are the sons of Shem, according to their clans, languages, lands, and nations."
                                    ],
                                    "number": 31,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "All these are the clans of Noah’s sons, according to their generations and nations. From these the nations of the earth spread out after the flood."
                                    ],
                                    "number": 32,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4358,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 4
                                    },
                                    "text": "SP and some MT manuscripts (see also LXX and 1 Chronicles 1:7); most MT manuscripts Dodanites"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4359,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 7
                                    },
                                    "text": "Sabtah is a variant of Sabta; see 1 Chronicles 1:9."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4360,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 8
                                    },
                                    "text": "Or who established himself as a mighty warrior or who became the first fearless leader"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4361,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 9
                                    },
                                    "text": "Or in defiance of; twice in this verse"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4362,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 10
                                    },
                                    "text": "That is, Babylonia"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4363,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 14
                                    },
                                    "text": "Some translators adjust the Hebrew word order to the Casluhites, and the Caphtorites (from whom the Philistines came); see also Jeremiah 47:4 and Amos 9:7."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4364,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 15
                                    },
                                    "text": "Or of the Sidonians, the foremost"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4365,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 21
                                    },
                                    "text": "Or Shem, whose older brother was Japheth"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4366,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 23
                                    },
                                    "text": "Hebrew; LXX and 1 Chronicles 1:17 Meshech"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4367,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 24
                                    },
                                    "text": "Hebrew; LXX (see also Luke 3:35–36) And Arphaxad was the father of Cainan, and Cainan was the father of Shelah,"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4368,
                                    "reference": {
                                        "chapter": 10,
                                        "verse": 25
                                    },
                                    "text": "Peleg means division."
                                }
                            ],
                            "number": 10
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/11.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_011_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_011_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_011.mp3"
                        },
                        "numberOfVerses": 32,
                        "previousChapterApiLink": "/api/BSB/GEN/9.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_009_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_009_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_009.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_010_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_010_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_010.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/10.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
                            "textDirection": "ltr",
                            "totalNumberOfChapters": 1189,
                            "totalNumberOfVerses": 31086,
                            "website": "https://berean.bible/"
                        }
                    },
                    "headers": {
                        "content-type": "application/json",
                        "last-modified": "Thu, 19 Dec 2024 17:49:01 GMT"
                    },
                    "status": 200,
                    "statusText": ""
                },
                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/11.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Tower of Babel"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Now the whole world had one language and a common form of speech."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And as people journeyed eastward,",
                                        {
                                            "noteId": 4369
                                        },
                                        "they found a plain in the land of Shinar",
                                        {
                                            "noteId": 4370
                                        },
                                        "and settled there."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And they said to one another, “Come, let us make bricks and bake them thoroughly.” So they used brick instead of stone, and tar instead of mortar."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Come,” they said, “let us build for ourselves a city with a tower that reaches to the heavens, that we may make a name for ourselves and not be scattered over the face of all the earth.”"
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD came down to see the city and the tower that the sons of men were building."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And the LORD said, “If they have begun to do this as one people speaking the same language, then nothing they devise will be beyond them."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Come, let Us go down and confuse their language, so that they will not understand one another’s speech.”"
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So the LORD scattered them from there over the face of all the earth, and they stopped building the city."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "That is why it is called Babel,",
                                        {
                                            "noteId": 4371
                                        },
                                        "for there the LORD confused the language of the whole world, and from that place the LORD scattered them over the face of all the earth."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Genealogy from Shem to Abram"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "This is the account of Shem. Two years after the flood, when Shem was 100 years old, he became the father of Arphaxad."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Arphaxad, Shem lived 500 years and had other sons and daughters."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Arphaxad was 35 years old, he became the father of Shelah."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Shelah, Arphaxad lived 403 years and had other sons and daughters.",
                                        {
                                            "noteId": 4372
                                        }
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Shelah was 30 years old, he became the father of Eber."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Eber, Shelah lived 403 years and had other sons and daughters."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Eber was 34 years old, he became the father of Peleg."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Peleg, Eber lived 430 years and had other sons and daughters."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Peleg was 30 years old, he became the father of Reu."
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Reu, Peleg lived 209 years and had other sons and daughters."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Reu was 32 years old, he became the father of Serug."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Serug, Reu lived 207 years and had other sons and daughters."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Serug was 30 years old, he became the father of Nahor."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Nahor, Serug lived 200 years and had other sons and daughters."
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Nahor was 29 years old, he became the father of Terah."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And after he had become the father of Terah, Nahor lived 119 years and had other sons and daughters."
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Terah was 70 years old, he became the father of Abram, Nahor, and Haran."
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Terah’s Descendants"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "This is the account of Terah. Terah became the father of Abram, Nahor, and Haran. And Haran became the father of Lot."
                                    ],
                                    "number": 27,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "During his father Terah’s lifetime, Haran died in his native land, in Ur of the Chaldeans."
                                    ],
                                    "number": 28,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Abram and Nahor took wives for themselves. Abram’s wife was named Sarai, and Nahor’s wife was named Milcah; she was the daughter of Haran, who was the father of both Milcah and Iscah."
                                    ],
                                    "number": 29,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But Sarai was barren; she had no children."
                                    ],
                                    "number": 30,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Terah took his son Abram, his grandson Lot son of Haran, and his daughter-in-law Sarai the wife of Abram, and they set out from Ur of the Chaldeans for the land of Canaan. But when they arrived in Haran, they settled there."
                                    ],
                                    "number": 31,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Terah lived 205 years, and he died in Haran."
                                    ],
                                    "number": 32,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4369,
                                    "reference": {
                                        "chapter": 11,
                                        "verse": 2
                                    },
                                    "text": "Or from the east or in the east"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4370,
                                    "reference": {
                                        "chapter": 11,
                                        "verse": 2
                                    },
                                    "text": "That is, Babylonia"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4371,
                                    "reference": {
                                        "chapter": 11,
                                        "verse": 9
                                    },
                                    "text": "Or Babylon; the Hebrew word for Babel sounds like the Hebrew for confused."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4372,
                                    "reference": {
                                        "chapter": 11,
                                        "verse": 13
                                    },
                                    "text": "Hebrew; LXX (see also Luke 3:35–36) 12 When Arphaxad was 135 years old, he became the father of Cainan. 13 And after he had become the father of Cainan, Arphaxad lived 430 years and had other sons and daughters, and then he died. When Cainan had lived 130 years, he became the father of Shelah. And after he had become the father of Shelah, Cainan lived 330 years and had other sons and daughters. Note that LXX also adds 100 years to the ages of Shelah, Eber, Peleg, Reu, Serug, and Nahor in this genealogy."
                                }
                            ],
                            "number": 11
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/12.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_012_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_012_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_012.mp3"
                        },
                        "numberOfVerses": 32,
                        "previousChapterApiLink": "/api/BSB/GEN/10.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_010_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_010_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_010.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_011_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_011_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_011.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/11.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
                            "textDirection": "ltr",
                            "totalNumberOfChapters": 1189,
