                            "souer": "https://openbible.com/audio/souer/BSB_05_Deu_010.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_05_Deu_011_G.mp3",
