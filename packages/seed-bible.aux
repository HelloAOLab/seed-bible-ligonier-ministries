                },
                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/12.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Call of Abram"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Then the LORD said to Abram, “Leave your country, your kindred, and your father’s household, and go to the land I will show you.",
                                        {
                                            "noteId": 4373
                                        }
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "I will make you into a great nation,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and I will bless you;"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "I will make your name great,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "so that you will be a blessing."
                                        }
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "I will bless those who bless you"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and curse those who curse you;"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "and all the families of the earth"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "will be blessed through you."
                                        },
                                        {
                                            "noteId": 4374
                                        },
                                        {
                                            "poem": 2,
                                            "text": "”"
                                        }
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Abram departed, as the LORD had directed him, and Lot went with him. Abram was seventy-five years old when he left Haran."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And Abram took his wife Sarai, his nephew Lot, and all the possessions and people they had acquired in Haran, and set out for the land of Canaan.",
                                        {
                                            "lineBreak": true
                                        },
                                        "When they came to the land of Canaan,"
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abram traveled through the land as far as the site of the Oak",
                                        {
                                            "noteId": 4375
                                        },
                                        "of Moreh at Shechem. And at that time the Canaanites were in the land."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD appeared to Abram and said, “I will give this land to your offspring.",
                                        {
                                            "noteId": 4376
                                        },
                                        "” So Abram built an altar there to the LORD, who had appeared to him."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "From there Abram moved on to the hill country east of Bethel and pitched his tent, with Bethel to the west and Ai to the east. There he built an altar to the LORD, and he called on the name of the LORD."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Abram journeyed on toward the Negev."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abram and Sarai in Egypt"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Now there was a famine in the land. So Abram went down to Egypt to live there for a while because the famine was severe."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "As he was about to enter Egypt, he said to his wife Sarai, “Look, I know that you are a beautiful woman,"
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and when the Egyptians see you, they will say, ‘This is his wife.’ Then they will kill me but will let you live."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Please say you are my sister, so that I will be treated well for your sake, and on account of you my life will be spared.”"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So when Abram entered Egypt, the Egyptians saw that the woman was very beautiful."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "When Pharaoh’s officials saw Sarai, they commended her to him, and she was taken into the palace of Pharaoh."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "He treated Abram well on her account, and Abram acquired sheep and cattle, male and female donkeys, menservants and maidservants, and camels."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The LORD, however, afflicted Pharaoh and his household with severe plagues because of Abram’s wife Sarai."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So Pharaoh summoned Abram and asked, “What have you done to me? Why didn’t you tell me she was your wife?"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Why did you say, ‘She is my sister,’ so that I took her as my wife? Now then, here is your wife. Take her and go!”"
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Pharaoh gave his men orders concerning Abram, and they sent him away with his wife and all his possessions."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4373,
                                    "reference": {
                                        "chapter": 12,
                                        "verse": 1
                                    },
                                    "text": "Cited in Acts 7:3"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4374,
                                    "reference": {
                                        "chapter": 12,
                                        "verse": 3
                                    },
                                    "text": "See Galatians 3:8"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4375,
                                    "reference": {
                                        "chapter": 12,
                                        "verse": 6
                                    },
                                    "text": "Or Terebinth or Great Tree"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4376,
                                    "reference": {
                                        "chapter": 12,
                                        "verse": 7
                                    },
                                    "text": "Cited in Galatians 3:16"
                                }
                            ],
                            "number": 12
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/13.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_013_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_013_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_013.mp3"
                        },
                        "numberOfVerses": 20,
                        "previousChapterApiLink": "/api/BSB/GEN/11.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_011_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_011_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_011.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_012_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_012_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_012.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/12.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
                            "textDirection": "ltr",
