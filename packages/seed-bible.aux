                            "souer": "https://openbible.com/audio/souer/BSB_05_Deu_002.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_05_Deu_003_G.mp3",
