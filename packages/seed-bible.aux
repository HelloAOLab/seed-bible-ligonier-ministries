        "914d0372-d388-48ca-bbff-6ccdfe2beffe": {
            "id": "914d0372-d388-48ca-bbff-6ccdfe2beffe",
            "space": "shared",
            "tags": {
                "abIDOrigin": "stuck-plum-damselfly (1)",
                "aoIDOrigin": "linear-gray-louse",
                "auxCodeOrigin": "weak-plum-toucan (1).aux",
                "contentType": "text/xml",
