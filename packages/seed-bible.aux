        "68732b17-b132-4488-abd5-c619c3aea389": {
            "id": "68732b17-b132-4488-abd5-c619c3aea389",
            "space": "shared",
            "tags": {
                "App.css": "body {overflow: hidden; background: #212121}\r\n\r\n* {\r\n  /* -webkit-touch-callout: none;\r\n  -webkit-user-select: none;\r\n  -moz-user-select: none;\r\n  -ms-user-select: none;\r\n  user-select: none; */\r\n}\r\n\r\n.book-container{\r\n  width: fit-content;\r\n  height: fit-content;\r\n  display: flex;\r\n  flex-direction: row;\r\n}\r\n\r\n.blinker{\r\n  animation: fadeAnimation linear 0.3s;\r\n  animation-iteration-count: 5;\r\n  animation-fill-mode: forwards;\r\n}\r\n\r\n@keyframes fadeAnimation {\r\n    0% {\r\n        background-color: #CFD8DC;\r\n    }\r\n    100% {\r\n        background-color: #F2F6F7;\r\n    }\r\n}\r\n\r\n.pointer-1 {\r\n    width: 10px;\r\n    height: 10px;\r\n    background-color: white;\r\n    border-radius: 5px;\r\n    position: absolute;\r\n    top: 5px;\r\n    left: 0;\r\n}\r\n\r\n.dash-line {\r\n    height: 2px;\r\n    width: 150px;\r\n    background-color: white;\r\n    position: absolute;\r\n    top: 9px;\r\n    left: 7px;\r\n}\r\n\r\n.book-section {\r\n    height: fit-content;\r\n    width: 320px;\r\n    background-color: white;\r\n    position: absolute;\r\n    left: 157px;\r\n    top: -20px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: flex-start;\r\n    padding: 20px;\r\n    padding-top: 10px;\r\n    border-radius: 10px;\r\n}\r\n\r\n.title-container {\r\n    height: 35px;\r\n    width: fit-content;\r\n    background-color: white;\r\n    padding: 5px;\r\n    color: black;\r\n    display: flex;\r\n    padding-right: 30px;\r\n    align-items: center;\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n    margin-bottom: 15px;\r\n}\r\n\r\n.chapter-container {\r\n    width: 100%;\r\n    background-color: white;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    flex-direction: row;\r\n    max-height: 500px;\r\n    /* gap: 11px; */\r\n    overflow-y: auto;\r\n    min-height: fit-content;\r\n    scrollbar-width: thin;\r\n    padding: 2px;\r\n    justify-content: flex-start;\r\n    align-items: flex-start;\r\n}\r\n\r\n.chapter {\r\n    height: 40px;\r\n    width: 40px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    transition: 0.3;\r\n    background-color: #F2F6F7;\r\n    border-radius: 10px;\r\n    cursor: pointer;\r\n    margin: 3px;\r\n}\r\n\r\n.chapter:hover{\r\n  background-color: #CFD8DC;\r\n}\r\n\r\n.footer {\r\n    display: flex;\r\n    align-items: center;\r\n    position: absolute;\r\n    top: 15px;\r\n    right: 15px;\r\n    justify-content: flex-end;\r\n}\r\n\r\n.close-btn {\r\n    font-size: 20px;\r\n    color: #CFD8DC;\r\n}\r\n\r\n.close-btn:hover{\r\n  color: #FF8A65;\r\n}\r\n\r\n@media only screen and (max-width: 768px) {\r\n  /* For mobile phones: */\r\n  .pointer-1{\r\n    display: none;\r\n  }\r\n\r\n  .dash-line{\r\n    display: none;\r\n  }\r\n\r\n  .title-container{\r\n    padding-left: 15px;\r\n  }\r\n\r\n  .book-section {\r\n    max-height: 600px;\r\n    background-color: white;\r\n    position: fixed;\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: flex-start;\r\n    padding: 15px;\r\n    padding-top: 10px;\r\n    border-radius: 10px;\r\n    min-height: fit-content;\r\n    right: 0;\r\n    left: 0;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    top: 200px;\r\n  }\r\n  \r\n  .chapter-container {\r\n    width: 100%;\r\n    background-color: white;\r\n    display: flex;\r\n    flex-wrap: wrap;\r\n    flex-direction: row;\r\n    max-height: 500px;\r\n    overflow-y: auto;\r\n    min-height: fit-content;\r\n    scrollbar-width: thin;\r\n    padding: 2px;\r\n    justify-content: center;\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .chapter {\r\n    height: 35px;\r\n    width: 35px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    transition: 0.3;\r\n    margin: 5px;\r\n  }\r\n}",
                "BookUrl": "https://bible.helloao.org/api/BSB/books.json",
                "abIDOrigin": "positive-rose-cockroach (3)",
                "aoIDOrigin": "linear-gray-louse",
                "auxCodeOrigin": "happy-aqua-bee.aux",
                "bookData": "@let BookData = await web.get(masks?.booksLink || tags.BookUrl)\r\n\r\nlet Books = [];\r\nlet PsalmsData = [\r\n    {\r\n        commonName: \"1 Psalms\",\r\n        startingBook: 0,\r\n        endingBook: 40\r\n    },\r\n    {\r\n        commonName: \"2 Psalms\",\r\n        startingBook: 41,\r\n        endingBook: 71\r\n    },\r\n    {\r\n        commonName: \"3 Psalms\",\r\n        startingBook: 72,\r\n        endingBook: 88\r\n    },\r\n    {\r\n        commonName: \"4 Psalms\",\r\n        startingBook: 89,\r\n        endingBook: 105\r\n    },\r\n    {\r\n        commonName: \"5 Psalms\",\r\n        startingBook: 106,\r\n        endingBook: 149\r\n    },\r\n];\r\n\r\nfor (let i = 0; i < BookData.data.books.length; i++) {\r\n    Books.push(BookData.data.books[i]);\r\n}\r\nreturn Books",
                "closeFormMenu": "@os.unregisterApp('formMenu')",
                "dimension": "home_1",
                "getApp": "@const { useState, useEffect, useCallback, useMemo } = os.appHooks;\r\nconst css = thisBot.tags[\"App.css\"];\r\n\r\nconst App = ({chapter}) => {\r\n    const [open, setOpen] = useState(false);\r\n    const [bookName, setBookName] = useState(\"\");\r\n    const [book, setBook] = useState(null);\r\n    \r\n    const changeForm = (form) => {\r\n        const selectedBot = getBot(byID(tags.selectedBot))\r\n        selectedBot.tags.form = form\r\n        setTimeout(() => {\r\n            shout('closeFormMenu')\r\n        }, 900)\r\n    }\r\n\r\n    const closeApp = ({book, chapter}) => {\r\n        bible.openAt(`${book} ${chapter}:1`);\r\n        updateCustomHeight(0.8)\r\n        shout('closeFormMenu')\r\n    }\r\n\r\n    const renderChapters = useMemo(() => {\r\n        if(book){\r\n            let renderJSX = [];\r\n            if(book.startingBook || book.startingBook === 0){\r\n                for(let i = book.startingBook; i < book.endingBook + 1; i++){\r\n                    renderJSX.push(<div className={`chapter ${chapter === i + 1 ? \"blinker\" : \"\"}`} onClick={() => closeApp({book: book.commonName, chapter: i + 1})}><span>{i+1}</span></div>)\r\n                }\r\n            }else{\r\n                for(let i = 0; i < book.numberOfChapters; i++){\r\n                    renderJSX.push(<div className={`chapter ${chapter === i + 1 ? \"blinker\" : \"\"}`} onClick={() => closeApp({book: book.commonName, chapter: i + 1})}><span>{i+1}</span></div>)\r\n                }\r\n            }\r\n            console.log(renderJSX)\r\n            return [...renderJSX]\r\n        }else{\r\n            return []\r\n        }\r\n    }, [book])\r\n    useEffect(() => {\r\n        setTimeout(() => {\r\n            setOpen(true)\r\n        }, 10)\r\n    }, [])\r\n\r\n    const init = () => {\r\n        let selectedBookBot = getBot(byTag(\"id\", masks.selectedBot));\r\n        let bookPromise = thisBot.bookData();\r\n        Promise.resolve(bookPromise).then((data) => {\r\n            let bookfound = false;\r\n            for(let i = 0; i < data.length; i++){\r\n                switch(selectedBookBot.tags.bookName){\r\n                    case(data[i].commonName): {\r\n                        setBook(data[i]);\r\n                        setBookName(data[i].commonName);\r\n                        bookfound = true;\r\n                        break\r\n                    }\r\n                    case(\"1 Psalms\"): {\r\n                        setBook({\r\n                            startingBook: 0,\r\n                            endingBook: 40\r\n                        });\r\n                        setBookName(\"1 Psalms\");\r\n                        bookfound = true;\r\n                        break\r\n                    }\r\n                    case(\"2 Psalms\"): {\r\n                        setBook({\r\n                            startingBook: 41,\r\n                            endingBook: 71\r\n                        });\r\n                        setBookName(\"2 Psalms\");\r\n                        bookfound = true;\r\n                        break\r\n                    }\r\n                    case(\"3 Psalms\"): {\r\n                        setBook({\r\n                            startingBook: 72,\r\n                            endingBook: 88\r\n                        });\r\n                        setBookName(\"3 Psalms\");\r\n                        bookfound = true;\r\n                        break\r\n                    }\r\n                    case(\"4 Psalms\"): {\r\n                        setBook({\r\n                            startingBook: 89,\r\n                            endingBook: 105\r\n                        });\r\n                        setBookName(\"4 Psalms\");\r\n                        bookfound = true;\r\n                        break\r\n                    }\r\n                    case(\"5 Psalms\"): {\r\n                        setBook({\r\n                            startingBook: 106,\r\n                            endingBook: 149\r\n                        });\r\n                        setBookName(\"5 Psalms\");\r\n                        bookfound = true;\r\n                        break\r\n                    }\r\n                }\r\n            }\r\n            if(!bookfound){\r\n                console.log(selectedBookBot.tags.bookName)\r\n                // os.toast(\"something went wrong\");\r\n            }\r\n        }).catch(() => {\r\n            // os.toast(\"something went wrong\");\r\n        })\r\n    }\r\n\r\n    useEffect(() => {\r\n        init();\r\n    }, [])\r\n\r\n    useEffect(() => {\r\n        if(book && chapter){\r\n            if(chapter > book?.numberOfChapters || (chapter < book?.startingBook - 1 || chapter - 1 > book?.endingBook)){\r\n                os.toast(\"that chapter doesn't exist\")\r\n            }\r\n        }\r\n    }, [book])\r\n\r\n\r\n    return (\r\n        <>\r\n            <style>{css}</style>\r\n            <link href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" rel=\"stylesheet\" />\r\n\r\n            {book &&\r\n                <div className=\"book-container\">\r\n                    <div className=\"pointer-1\"></div>\r\n                    <div className=\"dash-line\"></div>\r\n                    <div\r\n                    className=\"book-section\"\r\n                    id=\"chapterContainer\"\r\n                    onPointerEnter={() => {\r\n                        setTagMask(gridPortalBot, \"portalZoomable\", false);\r\n                    }}\r\n                    onPointerLeave={(e) => {\r\n                        if (e.currentTarget.id == \"chapterContainer\"){\r\n                            setTagMask(gridPortalBot, \"portalZoomable\", true);\r\n                        }\r\n                    }}\r\n                    >\r\n                        <div className=\"title-container\">\r\n                            <span>{bookName}</span>\r\n                        </div>\r\n                        <div\r\n                        className=\"chapter-container\"\r\n                        >\r\n                            {\r\n                                renderChapters.map(chapter => {\r\n                                    return chapter\r\n                                })\r\n                            }\r\n                        </div>\r\n                        <div class=\"footer\">\r\n                            <span onClick={closeApp} class=\"close-btn\">X</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            }\r\n        </>\r\n    )\r\n}\r\n\r\nreturn App\r\n",
                "onGridClick": "@whisper(thisBot, \"closeFormMenu\");",
                "openFormMenu": "@await os.unregisterApp('formMenu')\r\nawait os.registerApp('formMenu', thisBot)\r\n\r\nconst App = thisBot.getApp()\r\n\r\nvar pointerX = gridPortalBot.tags.pointerPixelX\r\nvar pointerY = gridPortalBot.tags.pointerPixelY\r\n\r\nif(that.center){\r\n    pointerX = \"50vw\";\r\n    pointerY = \"50dvh\";\r\n}else{\r\n    pointerX = gridPortalBot.tags.pointerPixelX + \"px\"\r\n    pointerY = gridPortalBot.tags.pointerPixelY + \"px\"\r\n}\r\nmasks.selectedBot = that.id\r\nos.compileApp('formMenu',\r\n    <div onClick={() => whisper(thisBot, \"closeFormMenu\")} className=\"form-app-container\" style={{position: 'absolute', left: `${pointerX}`, top: `${pointerY}`}}>\r\n        <App chapter={that.chapter ? that.chapter : null} />\r\n    </div>\r\n);\r\n",
                "system": "baseElements.formMenu"
            }
        },
