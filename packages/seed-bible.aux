                    "statusText": ""
                },
                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/DEU/5.json": {
                    "data": {
                        "book": {
                            "commonName": "Deuteronomy",
                            "firstChapterApiLink": "/api/BSB/DEU/1.json",
                            "id": "DEU",
                            "lastChapterApiLink": "/api/BSB/DEU/34.json",
                            "name": "Deuteronomy",
                            "numberOfChapters": 34,
                            "order": 5,
                            "sha256": "df873168e1395e1474b634411d26d8f18c000e6473f87f89609c390b9312833e",
                            "title": "Deuteronomy",
                            "totalNumberOfVerses": 959,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Covenant at Horeb"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Then Moses summoned all Israel and said to them:",
                                        {
                                            "noteId": 3624
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        "Hear, O Israel, the statutes and ordinances that I declare in your hearing this day. Learn them and observe them carefully."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The LORD our God made a covenant with us at Horeb.",
                                        {
                                            "noteId": 3625
                                        }
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "He did not make this covenant with our fathers, but with all of us who are alive here today."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The LORD spoke with you face to face out of the fire on the mountain."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Ten Commandments"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "At that time I was standing between the LORD and you to declare to you the word of the LORD, because you were afraid of the fire and would not go up the mountain. And He said:"
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "“I am the LORD your God, who brought you out of the land of Egypt, out of the house of slavery."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall have no other gods before Me.",
                                        {
                                            "noteId": 3626
                                        }
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not make for yourself an idol in the form of anything in the heavens above, on the earth below, or in the waters beneath."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "You shall not bow down to them or worship them; for I, the LORD your God, am a jealous God, visiting the iniquity of the fathers on their children to the third and fourth generations of those who hate Me,"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "but showing loving devotion to a thousand generations",
                                        {
                                            "noteId": 3627
                                        },
                                        "of those who love Me and keep My commandments."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not take the name of the LORD your God in vain, for the LORD will not leave anyone unpunished who takes His name in vain."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Observe the Sabbath day by keeping it holy, as the LORD your God has commanded you."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Six days you shall labor and do all your work,"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "but the seventh day is a Sabbath to the LORD your God, on which you must not do any work—neither you, nor your son or daughter, nor your manservant or maidservant, nor your ox or donkey or any of your livestock, nor the foreigner within your gates, so that your manservant and maidservant may rest as you do."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Remember that you were a slave in the land of Egypt, and that the LORD your God brought you out of there with a mighty hand and an outstretched arm. That is why the LORD your God has commanded you to keep the Sabbath day."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Honor your father and your mother, as the LORD your God has commanded you, so that your days may be long and that it may go well with you in the land that the LORD your God is giving you.",
                                        {
                                            "noteId": 3628
                                        }
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not murder.",
                                        {
                                            "noteId": 3629
                                        }
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not commit adultery.",
                                        {
                                            "noteId": 3630
                                        }
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not steal.",
                                        {
                                            "noteId": 3631
                                        }
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not bear false witness against your neighbor.",
                                        {
                                            "noteId": 3632
                                        }
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "You shall not covet",
                                        {
                                            "noteId": 3633
                                        },
                                        "your neighbor’s wife. You shall not covet your neighbor’s house or field, or his manservant or maidservant, or his ox or donkey, or anything that belongs to your neighbor.”"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Moses Intercedes for the People"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The LORD spoke these commandments in a loud voice to your whole assembly out of the fire, the cloud, and the deep darkness on the mountain; He added nothing more. And He wrote them on two tablets of stone and gave them to me."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And when you heard the voice out of the darkness while the mountain was blazing with fire, all the heads of your tribes and your elders approached me,"
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and you said, “Behold, the LORD our God has shown us His glory and greatness, and we have heard His voice out of the fire. Today we have seen that a man can live even if God speaks with him."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But now, why should we die? For this great fire will consume us, and we will die, if we hear the voice of the LORD our God any longer."
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "For who of all flesh has heard the voice of the living God speaking out of the fire, as we have, and survived?"
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Go near and listen to all that the LORD our God says. Then you can tell us everything the LORD our God tells you; we will listen and obey.”"
                                    ],
                                    "number": 27,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the LORD heard the words you spoke to me, and He said to me, “I have heard the words that these people have spoken to you. They have done well in all that they have spoken."
                                    ],
                                    "number": 28,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "If only they had such a heart to fear Me and keep all My commandments always, so that it might be well with them and with their children forever."
                                    ],
                                    "number": 29,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Go and tell them: ‘Return to your tents.’"
                                    ],
                                    "number": 30,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But you stand here with Me, that I may speak to you all the commandments and statutes and ordinances you are to teach them to follow in the land that I am giving them to possess.”"
                                    ],
                                    "number": 31,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So be careful to do as the LORD your God has commanded you; you are not to turn aside to the right or to the left."
                                    ],
                                    "number": 32,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "You must walk in all the ways that the LORD your God has commanded you, so that you may live and prosper and prolong your days in the land that you will possess."
                                    ],
                                    "number": 33,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 3624,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 1
                                    },
                                    "text": "Note that Deuteronomy 5:1 through Deuteronomy 26:19 may be presented as a continuous section of unbroken speech by Moses. In place of multiple levels of nested quotes, this section has been set apart with a double space."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3625,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 2
                                    },
                                    "text": "That is, Mount Sinai, or possibly a mountain in the range containing Mount Sinai"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3626,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 7
                                    },
                                    "text": "Or besides Me"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3627,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 10
                                    },
                                    "text": "Hebrew loving devotion to thousands; forms of the Hebrew chesed are translated here and in most cases throughout the Scriptures as loving devotion; the range of meaning includes love, goodness, kindness, faithfulness, and mercy, as well as loyalty to a covenant."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3628,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 16
                                    },
                                    "text": "Cited in Matthew 15:4, Matthew 19:19, Mark 7:10, Luke 18:20, and Ephesians 6:2–3"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3629,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 17
                                    },
                                    "text": "Cited in Matthew 5:21, Matthew 19:18, Mark 10:19, Luke 18:20, Romans 13:9, and James 2:11"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3630,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 18
                                    },
                                    "text": "Cited in Matthew 5:27, Matthew 19:18, Mark 10:19, Luke 18:20, Romans 13:9, and James 2:11"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3631,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 19
                                    },
                                    "text": "Cited in Matthew 19:18, Mark 10:19, Luke 18:20, and Romans 13:9"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3632,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 20
                                    },
                                    "text": "Cited in Matthew 19:18, Mark 10:19, and Luke 18:20"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 3633,
                                    "reference": {
                                        "chapter": 5,
                                        "verse": 21
                                    },
                                    "text": "Cited in Romans 7:7 and Romans 13:9"
                                }
                            ],
                            "number": 5
                        },
                        "nextChapterApiLink": "/api/BSB/DEU/6.json",
