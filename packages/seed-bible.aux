                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_003.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/3.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
