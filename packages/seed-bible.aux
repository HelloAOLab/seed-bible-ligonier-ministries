                },
                "370e0448-45e1-4f47-ac4d-7f1db6b0b2ce/api/BSB/GEN/6.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "Corruption on the Earth"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Now when men began to multiply on the face of the earth and daughters were born to them,"
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "the sons of God saw that the daughters of men were beautiful, and they took as wives whomever they chose."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So the LORD said, “My Spirit will not contend with man forever,",
                                        {
                                            "noteId": 4346
                                        },
                                        "for he is mortal; his days shall be 120 years.”"
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The Nephilim were on the earth in those days—and afterward as well—when the sons of God had relations with the daughters of men. And they bore them children who became the mighty men of old, men of renown."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD saw that the wickedness of man was great upon the earth, and that every inclination of the thoughts of his heart was altogether evil all the time."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And the LORD regretted that He had made man on the earth, and He was grieved in His heart."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So the LORD said, “I will blot out man, whom I have created, from the face of the earth—every man and beast and crawling creature and bird of the air—for I am grieved that I have made them.”"
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Noah’s Favor with God"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Noah, however, found favor in the eyes of the LORD."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "This is the account of Noah. Noah was a righteous man, blameless in his generation; Noah walked with God."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And Noah had three sons: Shem, Ham, and Japheth."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Now the earth was corrupt in the sight of God, and full of violence."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And God looked upon the earth and saw that it was corrupt; for all living creatures",
                                        {
                                            "noteId": 4347
                                        },
                                        "on the earth had corrupted their ways."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Preparing the Ark"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then God said to Noah, “The end of all living creatures has come before Me, because through them the earth is full of violence. Now behold, I will destroy both them and the earth."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Make for yourself an ark of gopher wood;",
                                        {
                                            "noteId": 4348
                                        },
                                        "make rooms in the ark and coat it with pitch inside and out."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And this is how you are to build it: The ark is to be 300 cubits long, 50 cubits wide, and 30 cubits high.",
                                        {
                                            "noteId": 4349
                                        }
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "You are to make a roof",
                                        {
                                            "noteId": 4350
                                        },
                                        "for the ark, finish its walls a cubit from the top,",
                                        {
                                            "noteId": 4351
                                        },
                                        "place a door in the side of the ark, and build lower, middle, and upper decks."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And behold, I will bring floodwaters upon the earth to destroy every creature under the heavens that has the breath of life. Everything on the earth will perish."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But I will establish My covenant with you, and you will enter the ark—you and your sons and your wife and your sons’ wives with you."
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And you are to bring two of every living creature into the ark—male and female—to keep them alive with you."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Two of every kind of bird and animal and crawling creature will come to you to be kept alive."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "You are also to take for yourself every kind of food that is eaten and gather it as food for yourselves and for the animals.”"
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Noah did everything precisely as God had commanded him."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4346,
                                    "reference": {
                                        "chapter": 6,
                                        "verse": 3
                                    },
                                    "text": "LXX and Syriac My Spirit will not remain in man forever"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4347,
                                    "reference": {
                                        "chapter": 6,
                                        "verse": 12
                                    },
                                    "text": "Literally all flesh; similarly in verses 13, 17, and 19"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4348,
                                    "reference": {
                                        "chapter": 6,
                                        "verse": 14
                                    },
                                    "text": "Gopher is an unknown kind of tree; possibly cypress or cedar."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4349,
                                    "reference": {
                                        "chapter": 6,
                                        "verse": 15
                                    },
                                    "text": "The ark was approximately 450 feet long, 75 feet wide, and 45 feet high (137.2 meters long, 22.9 meters wide, and 13.7 meters high)."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4350,
                                    "reference": {
                                        "chapter": 6,
                                        "verse": 16
                                    },
                                    "text": "Or skylight or window"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4351,
                                    "reference": {
                                        "chapter": 6,
                                        "verse": 16
                                    },
                                    "text": "A cubit is approximately 18 inches or 45.7 centimeters."
                                }
                            ],
                            "number": 6
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/7.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_007_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_007_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_007.mp3"
                        },
                        "numberOfVerses": 22,
                        "previousChapterApiLink": "/api/BSB/GEN/5.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_005_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_005_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_005.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_006_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_006_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_006.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/6.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
