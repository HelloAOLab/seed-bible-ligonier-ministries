                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The following came up from Tel-melah, Tel-harsha, Cherub, Addan,",
                                        {
                                            "noteId": 2038
                                        },
                                        "and Immer, but could not prove that their families were descended from Israel:"
                                    ],
                                    "number": 59,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "the descendants of Delaiah,",
                                        {
                                            "lineBreak": true
                                        },
                                        "the descendants of Tobiah,",
                                        {
                                            "lineBreak": true
                                        },
                                        "and the descendants of Nekoda,",
                                        {
                                            "lineBreak": true
                                        },
                                        "652 in all."
                                    ],
                                    "number": 60,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And from among the priests: the descendants of Hobaiah,",
                                        {
                                            "lineBreak": true
                                        },
                                        "the descendants of Hakkoz,",
                                        {
                                            "lineBreak": true
                                        },
                                        "and the descendants of Barzillai (who had married a daughter of Barzillai the Gileadite and was called by their name)."
                                    ],
                                    "number": 61,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "These men searched for their family records, but they could not find them and so were excluded from the priesthood as unclean."
                                    ],
                                    "number": 62,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The governor ordered them not to eat the most holy things until there was a priest to consult the Urim and Thummim.",
                                        {
                                            "noteId": 2039
                                        }
                                    ],
                                    "number": 63,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The whole assembly numbered 42,360,"
                                    ],
                                    "number": 64,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "in addition to their 7,337 menservants and maidservants, as well as their 200 male and female singers."
                                    ],
                                    "number": 65,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "They had 736 horses, 245 mules,"
                                    ],
                                    "number": 66,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "435 camels, and 6,720 donkeys."
                                    ],
                                    "number": 67,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Offerings by the Exiles"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When they arrived at the house of the LORD in Jerusalem, some of the heads of the families gave freewill offerings to rebuild the house of God on its original site."
                                    ],
                                    "number": 68,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "According to their ability, they gave to the treasury for this work 61,000 darics of gold,",
                                        {
                                            "noteId": 2040
                                        },
                                        "5,000 minas of silver,",
                                        {
                                            "noteId": 2041
                                        },
                                        "and 100 priestly garments."
                                    ],
                                    "number": 69,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So the priests, the Levites, the singers, the gatekeepers, and the temple servants, along with some of the people, settled in their own towns; and the rest of the Israelites",
                                        {
                                            "noteId": 2042
                                        },
                                        "settled in their towns."
                                    ],
                                    "number": 70,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 2022,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 2
                                    },
                                    "text": "Parallel text at Nehemiah 7:7 accompanied by Zerubbabel, Jeshua, Nehemiah, Azariah, Raamiah, Nahamani, Mordecai, Bilshan, Mispereth, Bigvai, Nehum, and Baanah"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2023,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 10
                                    },
                                    "text": "Bani is a variant of Binnui; see Nehemiah 7:15."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2024,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 18
                                    },
                                    "text": "Jorah is a variant of Hariph; see Nehemiah 7:24."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2025,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 20
                                    },
                                    "text": "Gibbar is a variant of Gibeon; see Nehemiah 7:25."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2026,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 21
                                    },
                                    "text": "Literally the sons; here and in verses 25, 26, 33, and 34"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2027,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 24
                                    },
                                    "text": "Azmaveth is a variant of Beth-azmaveth; see Nehemiah 7:28."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2028,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 25
                                    },
                                    "text": "LXX (see also Nehemiah 7:29); Hebrew Kiriath-arim"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2029,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 31
                                    },
                                    "text": "Or of West Elam"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2030,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 40
                                    },
                                    "text": "Hodaviah is a variant of Hodevah; see Nehemiah 7:43."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2031,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 43
                                    },
                                    "text": "Hebrew The Nethinim; also in verses 58 and 70"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2032,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 44
                                    },
                                    "text": "Siaha is a variant of Sia; see Nehemiah 7:47."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2033,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 46
                                    },
                                    "text": "Alternate MT reading (see also Nehemiah 7:48); the other alternate reads Shamlai"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2034,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 50
                                    },
                                    "text": "Nephusim is a variant of Nephushesim; see Nehemiah 7:52."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2035,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 52
                                    },
                                    "text": "Bazluth is a variant of Bazlith; see Nehemiah 7:54."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2036,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 55
                                    },
                                    "text": "Peruda is a variant of Perida; see Nehemiah 7:57."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2037,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 57
                                    },
                                    "text": "Ami is a variant of Amon; see Nehemiah 7:59."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2038,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 59
                                    },
                                    "text": "Addan is a variant of Addon; see Nehemiah 7:61."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2039,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 63
                                    },
                                    "text": "Literally Lights and Perfections"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2040,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 69
                                    },
                                    "text": "Or 61,000 gold drachmas; that is, approximately 1,129.7 pounds or 512.4 kilograms of gold coins"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2041,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 69
                                    },
                                    "text": "5,000 minas is approximately 3.14 tons or 2.85 metric tons of silver."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2042,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 70
                                    },
                                    "text": "Or all Israel"
                                }
                            ],
                            "number": 2
                        },
                        "nextChapterApiLink": "/api/BSB/EZR/3.json",
