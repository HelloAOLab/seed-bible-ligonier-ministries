                                            "noteId": 2032
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        "the descendants of Padon,"
                                    ],
                                    "number": 44,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "the descendants of Lebanah,",
                                        {
                                            "lineBreak": true
                                        },
                                        "the descendants of Hagabah,",
                                        {
                                            "lineBreak": true
                                        },
