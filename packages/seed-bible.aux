                },
                "370e0448-45e1-4f47-ac4d-7f1db6b0b2ce/api/BSB/GEN/8.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Ark Rests on Ararat"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "But God remembered Noah and all the animals and livestock that were with him in the ark. And God sent a wind over the earth, and the waters began to subside."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The springs of the deep and the floodgates of the heavens were closed, and the rain from the sky was restrained."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The waters receded steadily from the earth, and after 150 days the waters had gone down."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "On the seventeenth day of the seventh month, the ark came to rest on the mountains of Ararat."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And the waters continued to recede until the tenth month, and on the first day of the tenth month the tops of the mountains became visible."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Noah Sends a Raven and a Dove"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "After forty days Noah opened the window he had made in the ark"
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and sent out a raven. It kept flying back and forth until the waters had dried up from the earth."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Noah sent out",
                                        {
                                            "noteId": 4355
                                        },
                                        "a dove to see if the waters had receded from the surface of the ground."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "But the dove found no place to rest her foot, and she returned to him in the ark, because the waters were still covering the surface of all the earth. So he reached out his hand and brought her back inside the ark."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Noah waited seven more days and again sent out the dove from the ark."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And behold, the dove returned to him in the evening with a freshly plucked olive leaf in her beak. So Noah knew that the waters had receded from the earth."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Noah waited seven more days and sent out the dove again, but this time she did not return to him."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Exiting the Ark"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "In Noah’s six hundred and first year, on the first day of the first month, the waters had dried up from the earth. So Noah removed the covering from the ark and saw that the surface of the ground was dry."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "By the twenty-seventh day of the second month, the earth was fully dry."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then God said to Noah,"
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "“Come out of the ark, you and your wife, along with your sons and their wives."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Bring out all the living creatures that are with you—birds, livestock, and everything that crawls upon the ground—so that they can spread out over the earth and be fruitful and multiply upon it.”"
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Noah came out, along with his sons and his wife and his sons’ wives."
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Every living creature, every creeping thing, and every bird—everything that moves upon the earth—came out of the ark, kind by kind."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Noah Builds an Altar"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Noah built an altar to the LORD. And taking from every kind of clean animal and clean bird, he offered burnt offerings on the altar."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "When the LORD smelled the pleasing aroma, He said in His heart, “Never again will I curse the ground because of man, even though every inclination of his heart is evil from his youth. And never again will I destroy all living creatures as I have done."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "As long as the earth endures,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "seedtime and harvest,"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "cold and heat,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "summer and winter,"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "day and night"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "shall never cease.”"
                                        }
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4355,
                                    "reference": {
                                        "chapter": 8,
                                        "verse": 8
                                    },
                                    "text": "Literally sent out from him or sent out from it"
                                }
                            ],
                            "number": 8
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/9.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_009_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_009_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_009.mp3"
                        },
                        "numberOfVerses": 22,
                        "previousChapterApiLink": "/api/BSB/GEN/7.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_007_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_007_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_007.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_008_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_008_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_008.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/8.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
