                            "souer": "https://openbible.com/audio/souer/BSB_10_2Sa_004.mp3"
                        },
                        "thisChapterLink": "/api/BSB/2SA/4.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
