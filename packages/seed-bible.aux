                                    ],
                                    "number": 33,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "the men of Jericho, 345;"
                                    ],
                                    "number": 34,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "and the descendants of Senaah, 3,630."
                                    ],
                                    "number": 35,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The priests:",
                                        {
                                            "lineBreak": true
                                        },
                                        "The descendants of Jedaiah (through the house of Jeshua), 973;"
                                    ],
                                    "number": 36,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "the descendants of Immer, 1,052;"
