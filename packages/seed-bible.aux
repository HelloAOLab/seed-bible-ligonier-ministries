                "45ca5da5-6b2d-40f5-8cd8-20128997c3d3/api/BSB/EXO/2.json": {
                    "data": {
                        "book": {
                            "commonName": "Exodus",
                            "firstChapterApiLink": "/api/BSB/EXO/1.json",
                            "id": "EXO",
                            "lastChapterApiLink": "/api/BSB/EXO/40.json",
                            "name": "Exodus",
                            "numberOfChapters": 40,
                            "order": 2,
                            "sha256": "f036511ae774f868007d0f0b59ff020699f21228d9293b390f4fc9d3f6f2dee2",
                            "title": "Exodus",
                            "totalNumberOfVerses": 1213,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Birth and Adoption of Moses"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Now a man of the house of Levi married a daughter of Levi,"
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "and she conceived and gave birth to a son. When she saw that he was a beautiful child, she hid him for three months."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But when she could no longer hide him, she got him a papyrus basket",
                                        {
                                            "noteId": 1598
                                        },
                                        "and coated it with tar and pitch. Then she placed the child in the basket and set it among the reeds along the bank of the Nile."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And his sister stood at a distance to see what would happen to him."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Soon the daughter of Pharaoh went down to bathe in the Nile, and her attendants were walking along the riverbank. And when she saw the basket among the reeds, she sent her maidservant to retrieve it."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "When she opened it, she saw the child, and behold, the little boy was crying. So she had compassion on him and said, “This is one of the Hebrew children.”"
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then his sister said to Pharaoh’s daughter, “Shall I go and call one of the Hebrew women to nurse the child for you?”"
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Go ahead,” Pharaoh’s daughter told her. And the girl went and called the boy’s mother."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Pharaoh’s daughter said to her, “Take this child and nurse him for me, and I will pay your wages.” So the woman took the boy and nursed him."
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When the child had grown older, she brought him to Pharaoh’s daughter, and he became her son. She named him Moses",
                                        {
                                            "noteId": 1599
                                        },
                                        "and explained, “I drew him out of the water.”"
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Rejection and Flight of Moses"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "One day, after Moses had grown up, he went out to his own people",
                                        {
                                            "noteId": 1600
                                        },
                                        "and observed their hard labor. He saw an Egyptian beating a Hebrew, one of his own people."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "After looking this way and that and seeing no one, he struck down the Egyptian and hid his body in the sand."
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The next day Moses went out and saw two Hebrews fighting. He asked the one in the wrong, “Why are you attacking your companion?”"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But the man replied, “Who made you ruler and judge over us?",
                                        {
                                            "noteId": 1601
                                        },
                                        "Are you planning to kill me as you killed the Egyptian?",
                                        {
                                            "noteId": 1602
                                        },
                                        "”",
                                        {
                                            "lineBreak": true
                                        },
                                        "Then Moses was afraid and thought, “This thing I have done has surely become known.”"
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When Pharaoh heard about this matter, he sought to kill Moses. But Moses fled from Pharaoh and settled in the land of Midian, where he sat down beside a well."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Now the priest of Midian had seven daughters, and they came to draw water and fill the troughs to water their father’s flock."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And when some shepherds came along and drove them away, Moses rose up to help them and watered their flock."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When the daughters returned to their father Reuel,",
                                        {
                                            "noteId": 1603
                                        },
                                        "he asked them, “Why have you returned so early today?”"
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“An Egyptian rescued us from the shepherds,” they replied. “He even drew water for us and watered the flock.”"
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“So where is he?” their father asked. “Why did you leave the man behind? Invite him to have something to eat.”"
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Moses agreed to stay with the man, and he gave his daughter Zipporah to Moses in marriage."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And she gave birth to a son, and Moses named him Gershom,",
                                        {
                                            "noteId": 1604
                                        },
                                        "saying, “I have become a foreigner in a foreign land.”"
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "God Hears the Cry of the Israelites"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "After a long time, the king of Egypt died. The Israelites groaned and cried out under their burden of slavery, and their cry for deliverance from bondage ascended to God."
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So God heard their groaning, and He remembered His covenant with Abraham, Isaac, and Jacob."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "God saw the Israelites and took notice."
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 1598,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 3
                                    },
                                    "text": "The Hebrew can also mean ark; also in verse 5; see Genesis 6:14."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 1599,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 10
                                    },
                                    "text": "Moses sounds like a Hebrew term that means to lift out."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 1600,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 11
                                    },
                                    "text": "Or his brothers"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 1601,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 14
                                    },
                                    "text": "Cited in Acts 7:27 and Acts 7:35"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 1602,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 14
                                    },
                                    "text": "LXX Are you planning to kill me as you killed the Egyptian yesterday? Cited in Acts 7:28"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 1603,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 18
                                    },
                                    "text": "Reuel was also called Jethro; see Exodus 3:1."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 1604,
                                    "reference": {
                                        "chapter": 2,
                                        "verse": 22
                                    },
                                    "text": "Gershom sounds like the Hebrew for foreigner."
                                }
                            ],
                            "number": 2
                        },
                        "nextChapterApiLink": "/api/BSB/EXO/3.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_02_Exo_003_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_02_Exo_003_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_02_Exo_003.mp3"
                        },
                        "numberOfVerses": 25,
                        "previousChapterApiLink": "/api/BSB/EXO/1.json",
                        "previousChapterAudioLinks": {
