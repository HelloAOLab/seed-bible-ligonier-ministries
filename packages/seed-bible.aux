        "23208dec-e5ab-4db8-b232-680c8a2932f6": {
            "id": "23208dec-e5ab-4db8-b232-680c8a2932f6",
            "space": "shared",
            "tags": {
                "Button": "@const Button = ({ children, onClick, isDisabled, secondaryAlt, small, secondary = false, color = \"\", backgroundColor = \"\", style = {}, varient = \"\" }) => {\r\n    return <>\r\n        <style>{thisBot.tags[\"button.css\"]}</style>\r\n        <button\r\n            disabled={isDisabled}\r\n            onClick={(e) => {\r\n                shout(\"playSound\", { soundName: \"DialogClick\" });\r\n                onClick(e);\r\n            }}\r\n            className={`custom-button ${small ? 'small' : ''} ${secondaryAlt ? \"secondaryAlt secondaryAltAlt\" : \"\"}  ${secondary ? 'secondaryAlt' : \"\"} ${varient}`}\r\n            style={{\r\n                color,\r\n                backgroundColor,\r\n                ...style\r\n            }}\r\n        >\r\n            {children}\r\n        </button>\r\n    </>\r\n}\r\n\r\nreturn Button;",
                "ButtonsCover": "@const ButtonsCover = ({ children, secondary, style = {} }) => {\r\n    return <>\r\n        <style>{thisBot.tags[\"button-cover.css\"]}</style>\r\n        <div style={style} className={`button-cover ${secondary ? 'secondary' : ''}`}>\r\n            {children}\r\n        </div >\r\n    </>;\r\n}\r\n\r\nreturn ButtonsCover;",
                "Checkbox": "@const Checkbox = ({ checked, small, onClick, style }) => {\n    return (\n        <>\n            <style>{thisBot.tags[\"Checkbox.css\"]}</style>\n            <div style={style} className={`checkbox ${small && 'small'}`} onClick={(e) => {\n                e.stopPropagation();\n                onClick(!checked);\n            }}>\n                {checked ? <span style={{ backgroundColor: \"#D36433\", color: \"white\" }} class=\"material-symbols-outlined unfollow checked color-inherit\">\n                    check_box\n                </span> :\n                    <span style={{ fontSize: \"20px\" }} class=\"material-symbols-outlined unfollow unchecked color-inherit\">\n                        check_box_outline_blank\n                    </span>\n                }\n            </div>\n        </>\n    );\n}\n\nreturn Checkbox;",
                "Checkbox.css": ".checkbox .checked {\n    color: #4459F3;\n}\n\n.checkbox {\n    color: #5F5E5C;\n    cursor: pointer;\n}\n\n.checkbox span {\n    font-size: 24px !important;\n}\n\n.checkbox.small span {\n    font-size: 18px !important;\n}",
                "Chips": "@const Chip = ({ label, onDelete }) => {\n    return (\n        <>\n            <style>{thisBot.tags['chips.css']}</style>\n            <div className=\"chip\">\n                <span className=\"chip-label\">{label}</span>\n                <button className=\"chip-close\" onClick={onDelete}>\n                    <span class=\"material-symbols-outlined\">\n                        close\n                    </span>\n                </button>\n            </div>\n        </>\n    );\n};\n\nreturn Chip;",
                "Confetti": "@const Confetti = () => {\r\n    let numberArr = []\r\n\r\n    for (var i = 0; i < 149; i++) {\r\n        numberArr.push(i)\r\n    }\r\n    \r\n    return (<>\r\n        <style>{tags['Confetti.css']}</style>\r\n        <style>{tags['Confetti.scss']}</style>\r\n        <div className=\"wrapper-confetti\">\r\n            {numberArr.map(num => <div className={`confetti-${num}`} />)}\r\n        </div>\r\n    </>)\r\n}\r\n\r\nreturn Confetti;",
