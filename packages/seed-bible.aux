                "0adcbe28-8b46-4c7d-a42f-eef4dcf2bbb7/api/BSB/GEN/16.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "9ae507188093d846873e8affd9e88c21ac55abdbc6d8adb9beb220345494f0f1",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "Hagar and Ishmael"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Now Abram’s wife Sarai had borne him no children, but she had an Egyptian maidservant named Hagar."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So Sarai said to Abram, “Look now, the LORD has prevented me from bearing children. Please go to my maidservant; perhaps I can build a family by her.”",
                                        {
                                            "lineBreak": true
                                        },
                                        "And Abram listened to the voice of Sarai."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So after he had lived in Canaan for ten years, his wife Sarai took her Egyptian maidservant Hagar and gave her to Abram to be his wife."
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And he slept with Hagar, and she conceived. But when Hagar realized that she was pregnant, she began to despise her mistress.",
                                        {
                                            "noteId": 4388
                                        }
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Sarai said to Abram, “May the wrong done to me be upon you! I delivered my servant into your arms, and ever since she saw that she was pregnant, she has treated me with contempt. May the LORD judge between you and me.”"
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Here,” said Abram, “your servant is in your hands. Do whatever you want with her.” Then Sarai treated Hagar so harshly that she fled from her."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Now the angel",
                                        {
                                            "noteId": 4389
                                        },
                                        "of the LORD found Hagar by a spring of water in the desert—the spring along the road to Shur."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "“Hagar, servant of Sarai,” he said, “where have you come from, and where are you going?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "“I am running away from my mistress Sarai,” she replied."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So the angel of the LORD told her, “Return to your mistress and submit to her authority.”"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Then the angel added, “I will greatly multiply your offspring so that they will be too numerous to count.”"
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The angel of the LORD proceeded:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“Behold, you have conceived and will bear a son."
                                        },
                                        {
                                            "poem": 2,
                                            "text": "And you shall name him Ishmael,"
                                        },
                                        {
                                            "noteId": 4390
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 2,
                                            "text": "for the LORD has heard your cry of affliction."
                                        }
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "He will be a wild donkey of a man,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and his hand will be against everyone,"
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and everyone’s hand against him;"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "he will live in hostility"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "toward all his brothers.”"
                                        }
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Hagar gave this name to the LORD who had spoken to her: “You are the God who sees me,",
                                        {
                                            "noteId": 4391
                                        },
                                        "” for she said, “Here I have seen the One who sees me!”"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Therefore the well was called Beer-lahai-roi.",
                                        {
                                            "noteId": 4392
                                        },
                                        "It is located between Kadesh and Bered."
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Hagar bore Abram a son, and Abram gave the name Ishmael to the son she had borne."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Abram was eighty-six years old when Hagar bore Ishmael to him."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 4388,
                                    "reference": {
                                        "chapter": 16,
                                        "verse": 4
                                    },
                                    "text": "Or her mistress became despised in her sight"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4389,
                                    "reference": {
                                        "chapter": 16,
                                        "verse": 7
                                    },
                                    "text": "Or Angel; also in verses 9, 10, and 11; corresponding pronouns may also be capitalized."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4390,
                                    "reference": {
                                        "chapter": 16,
                                        "verse": 11
                                    },
                                    "text": "Ishmael means God hears."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4391,
                                    "reference": {
                                        "chapter": 16,
                                        "verse": 13
                                    },
                                    "text": "Hebrew El-Roi"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 4392,
                                    "reference": {
                                        "chapter": 16,
                                        "verse": 14
                                    },
                                    "text": "Beer-lahai-roi means well of the Living One who sees me."
                                }
                            ],
                            "number": 16
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/17.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_017_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_017_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_017.mp3"
                        },
                        "numberOfVerses": 16,
                        "previousChapterApiLink": "/api/BSB/GEN/15.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_015_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_015_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_015.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_016_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_016_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_016.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/16.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
