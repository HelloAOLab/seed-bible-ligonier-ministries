                            "souer": "https://openbible.com/audio/souer/BSB_04_Num_036.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_05_Deu_001_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_05_Deu_001_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_05_Deu_001.mp3"
                        },
                        "thisChapterLink": "/api/BSB/DEU/1.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseNotes": null,
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "17c5ac87e26de77bf1f09c1c3ee0c3fafeb3c876849038e8df9b64a7a9504674",
                            "shortName": "BSB",
