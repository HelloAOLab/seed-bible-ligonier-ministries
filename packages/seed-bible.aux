                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_002.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/2.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
