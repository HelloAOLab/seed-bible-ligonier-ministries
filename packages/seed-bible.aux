                "aiSettings.css": ".aiSettings-container {\r\n    font-family: sans-serif;\r\n    padding: 16px;\r\n    width: 280px;\r\n    height: 100%;\r\n    overflow: scroll;\r\n}\r\n\r\n\r\n.ai-chat {\r\n    display: flex;\r\n    flex-direction: row;\r\n    justify-content: start;\r\n    align-items: center;\r\n    gap: 10px;\r\n    /* margin-bottom: 30px; */\r\n}\r\n.ai-photo-positions{\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: start;\r\n    align-items: center;\r\n    gap: 20px;\r\n}\r\n\r\n.position-item{\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n    align-items: center;\r\n}",
                "aoIDOrigin": "linear-gray-louse",
                "color": "pink",
                "createAccountSettings.css": ".createAccount-settings {\r\n    width: 280px;\r\n    height: 100vh;\r\n    display: flex;\r\n    flex-direction: column;\r\n    font-family: 'Segoe UI', Arial, sans-serif;\r\n    border-left: 1px solid #e0e0e0;\r\n    background-color: #f0f1f1;\r\n    padding: 10px;\r\n    overflow-y: scroll;\r\n    overflow-x: hidden;\r\n}\r\n\r\n.subtitle {\r\n            font-size: 16px;\r\n            color: #666;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        .profile-photo-section {\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 16px;\r\n            margin-bottom: 32px;\r\n        }\r\n\r\n        .profile-photo {\r\n            width: 64px;\r\n            height: 64px;\r\n            border-radius: 50%;\r\n            background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            position: relative;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .profile-photo img {\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover;\r\n            border-radius: 50%;\r\n        }\r\n\r\n        .add-photo-btn {\r\n            background-color: #D2691E;\r\n            color: white;\r\n            border: none;\r\n            padding: 8px 16px;\r\n            border-radius: 20px;\r\n            font-size: 14px;\r\n            font-weight: 500;\r\n            cursor: pointer;\r\n            transition: background-color 0.2s;\r\n        }\r\n\r\n        .add-photo-btn:hover {\r\n            background-color: #B8860B;\r\n        }\r\n\r\n        .form-group {\r\n            margin-bottom: 24px;\r\n        }\r\n\r\n        .form-label {\r\n            font-size: 16px;\r\n            font-weight: 600;\r\n            color: #000;\r\n            margin-bottom: 8px;\r\n            display: block;\r\n        }\r\n\r\n        .form-input {\r\n            width: 100%;\r\n            padding: 16px;\r\n            background-color: #e8e8e8;\r\n            border: none;\r\n            border-radius: 8px;\r\n            font-size: 16px;\r\n            color: #333;\r\n            outline: none;\r\n            transition: background-color 0.2s;\r\n        }\r\n\r\n        .form-input:focus {\r\n            background-color: #ddd;\r\n        }\r\n\r\n        .form-input::placeholder {\r\n            color: #999;\r\n        }\r\n\r\n        .helper-text {\r\n            font-size: 14px;\r\n            color: #666;\r\n            margin-top: 6px;\r\n        }\r\n\r\n        .optional-label {\r\n            color: #999;\r\n            font-weight: 400;\r\n        }\r\n\r\n        .uid-section {\r\n            margin-bottom: 40px;\r\n        }\r\n\r\n        .uid-label {\r\n            font-size: 16px;\r\n            font-weight: 600;\r\n            color: #000;\r\n            margin-bottom: 8px;\r\n        }\r\n\r\n        .uid-display {\r\n            background-color: #e8e8e8;\r\n            padding: 16px;\r\n            border-radius: 8px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n        }\r\n\r\n        .uid-text {\r\n            font-size: 16px;\r\n            color: #666;\r\n            font-family: monospace;\r\n        }\r\n\r\n        .copy-icon {\r\n            width: 20px;\r\n            height: 20px;\r\n            cursor: pointer;\r\n            opacity: 0.6;\r\n        }\r\n\r\n        .copy-icon:hover {\r\n            opacity: 1;\r\n        }\r\n\r\n        .button-section {\r\n            position: absolute;\r\n            bottom: 0;\r\n            left: 0;\r\n            right: 0;\r\n            padding: 16px;\r\n            background-color: #f5f5f5;\r\n        }\r\n\r\n        .save-btn {\r\n            width: 100%;\r\n            background-color: #D2691E;\r\n            color: white;\r\n            border: none;\r\n            padding: 16px;\r\n            border-radius: 8px;\r\n            font-size: 16px;\r\n            font-weight: 600;\r\n            cursor: pointer;\r\n            margin-bottom: 12px;\r\n            transition: background-color 0.2s;\r\n        }\r\n\r\n        .save-btn:hover {\r\n            background-color: #B8860B;\r\n        }\r\n\r\n        .cancel-btn {\r\n            width: 100%;\r\n            background-color: transparent;\r\n            color: #333;\r\n            border: none;\r\n            padding: 16px;\r\n            border-radius: 8px;\r\n            font-size: 16px;\r\n            font-weight: 500;\r\n            cursor: pointer;\r\n            transition: background-color 0.2s;\r\n        }\r\n\r\n        .cancel-btn:hover {\r\n            background-color: #e8e8e8;\r\n        }\r\n\r\n        /* Profile photo placeholder */\r\n        .profile-photo::before {\r\n            content: '';\r\n            position: absolute;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%);\r\n            width: 40px;\r\n            height: 40px;\r\n            background: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"white\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/></svg>') no-repeat center;\r\n            background-size: contain;\r\n        }",
                "globalStyles.css": "*{\r\n    \r\n}",
                "main.css": ":root {\r\n    --primary-color: #F0F1F1;\r\n    --secondary-color: #FFFFFF;\r\n    --gray-color: #606060;\r\n    --whitegray-color: #E6E6E6;\r\n    --gray2-color: #CCCCCD;\r\n}\r\n\r\n.disabled {\r\n    color: #929292 !important;\r\n    cursor: not-allowed;\r\n}\r\n\r\n#tiptapEditor {\r\n    background-color: var(--themeBackground);\r\n}\r\n\r\n.layout {\r\n    background-color: var(--themeSideMenu) !important;\r\n    height: 100vh;\r\n    width: 100vw;\r\n    display: flex;\r\n    flex-direction: row;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    overflow: hidden;\r\n    position: absolute;\r\n    left: 0;\r\n    top: 0;\r\n    padding: 1px;\r\n}\r\n\r\n.content {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    overflow: hidden;\r\n    border-radius: 10px;\r\n    /* box-shadow: 0px 0px 9px 0px rgba(0, 0, 0, 0.15); */\r\n    height: fit-content;\r\n    padding: 0 6px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n.formatting-toolbar {\r\n    display: flex;\r\n    align-items: center;\r\n    background-color: white;\r\n    padding: 4px 0px;\r\n    gap: 4px;\r\n    border-radius: 8px;\r\n    border: 1px solid #E1E3EA;\r\n    background: #E6E6E6;\r\n    margin: 10px 0px;\r\n}\r\n\r\n.toolbar-btn {\r\n    background: none;\r\n    border: none;\r\n    cursor: pointer;\r\n    padding: 4px;\r\n    border-radius: 4px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n}\r\n\r\n.toolbar-btn:hover {\r\n    background-color: #f0f0f0;\r\n}\r\n\r\n.toolbar-btn.active {\r\n    background-color: #e0e0e0;\r\n}\r\n\r\n.toolbar-btn .material-icons {\r\n    color: #333;\r\n    font-size: 20px;\r\n}\r\n\r\n.toolbar-divider {\r\n    width: 1px;\r\n    height: 24px;\r\n    background-color: #ccc;\r\n    margin: 0 8px;\r\n}\r\n\r\n\r\n\r\n.flexElementGap-0 {\r\n    display: flex;\r\n    align-items: center;\r\n    flex-direction: row;\r\n    gap: 0;\r\n}\r\n\r\n.flexElementGap-2 {\r\n    display: flex;\r\n    align-items: center;\r\n    flex-direction: row;\r\n    gap: 2px;\r\n}\r\n\r\n.flexElementGap-4 {\r\n    display: flex;\r\n    align-items: center;\r\n    flex-direction: row;\r\n    gap: 4px;\r\n}\r\n\r\n.flexElementGap-10 {\r\n    display: flex;\r\n    align-items: center;\r\n    flex-direction: row;\r\n    gap: 10px;\r\n}\r\n\r\n.flexColumn-10 {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 10px;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n.softText {\r\n    color: var(--themeText1);\r\n    font-family: \"Helvetica Neue\";\r\n    font-size: 14px;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    line-height: normal;\r\n}\r\n\r\n.mediumText {\r\n    color: var(--themeText1);\r\n    font-family: \"Open Sans\";\r\n    font-size: 14px;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    line-height: normal;\r\n    margin-top: 0;\r\n    margin-bottom: 35px;\r\n}\r\n\r\n.blackText {\r\n    color: var(--themeText2);\r\n    font-family: \"Helvetica Neue\";\r\n    font-size: 16px;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    line-height: normal;\r\n}\r\n\r\n.selectInput {\r\n    border-radius: 8px;\r\n    border: 1px solid #E1E3EA;\r\n    background: #E6E6E6;\r\n    color: #5F5E5C;\r\n    font-family: Inter;\r\n    font-size: 15px;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    line-height: normal;\r\n    height: 44px;\r\n    padding: 0 15px;\r\n    outline: none;\r\n    border: none;\r\n    padding: 10px;\r\n}\r\n\r\n.routerOptions {\r\n    display: flex;\r\n    flex-direction: row;\r\n    gap: 10px;\r\n    /* justify-content: center; */\r\n    align-items: center;\r\n    margin: 21px 0px;\r\n}\r\n\r\n.routerTitle {\r\n    display: flex;\r\n    flex-direction: row;\r\n    gap: 10px;\r\n    align-items: center;\r\n    margin: 21px 0px;\r\n}",
                "page.css": ".pageContainer {\r\n  height: 100%;\r\n  width: 100%;\r\n  background-color: var(--themeBackground);\r\n  padding: 30px 0%;\r\n  overflow: scroll;\r\n  border-radius: 12px;\r\n  user-select: text;\r\n  overflow: hidden;\r\n}\r\n\r\n.overlay-animated-text {\r\n  position: relative;\r\n  display: inline-block;\r\n  color: #111; /* or any text color you want */\r\n  z-index: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.overlay-animated-text::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  top: 0;\r\n  left: -100%;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: linear-gradient(\r\n    120deg,\r\n    rgba(255, 255, 255, 0) 0%,\r\n    rgba(255, 255, 255, 0.6) 50%,\r\n    rgba(255, 255, 255, 0) 100%\r\n  );\r\n  animation: textOverlayShine 1s infinite;\r\n  z-index: 1;\r\n  pointer-events: none;\r\n}\r\n\r\n@keyframes textOverlayShine {\r\n  0% {\r\n    left: -100%;\r\n  }\r\n  100% {\r\n    left: 100%;\r\n  }\r\n}\r\n\r\n\r\n\r\n@keyframes backgroundFlash {\r\n  0% {\r\n    background-color: #f0f0f0;\r\n    /* light gray */\r\n  }\r\n\r\n  50% {\r\n    background-color: #d6d6d6;\r\n    /* medium gray */\r\n  }\r\n\r\n  100% {\r\n    background-color: #f0f0f0;\r\n  }\r\n\r\n}\r\n\r\n.tabHighlightBg {\r\n  animation: backgroundFlash 1s ease-out;\r\n}\r\n\r\n\r\n::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.bookTitle {\r\n  /* font-family: 'Helvetica Neue', sans-serif; */\r\n  font-size: 32px;\r\n  margin-bottom: 60px;\r\n  font-weight: 500;\r\n  font-family: var(--text-bookchapter-font);\r\n  color: var(--text-bookchapter-color);\r\n  /* font-family: 'Montserrat', sans-serif; */\r\n  /* font-size: 22px; */\r\n  font-weight: var(--text-bookchapter-weight);\r\n  text-align: var(--text-bookchapter-alignment);\r\n  text-decoration: var(--text-bookchapter-text-decoration);\r\n  margin-top: var(--text-bookchapter-margin-top);\r\n  margin-bottom: var(--text-bookchapter-margin-bottom);\r\n  /* margin-left: var(--text-bookchapter-margin-left); */\r\n  /* margin-right: var(--text-bookchapter-margin-right}\r\n */\r\n  margin-left: calc(var(--text-bookchapter-margin-left) + 1vw);\r\n  margin-right: calc(var(--text-bookchapter-margin-right) + 1vw);\r\n}\r\n\r\n\r\n.sectionTitle {\r\n  font-family: var(--text-heading-font);\r\n  color: var(--text-heading-color);\r\n  /* font-family: 'Montserrat', sans-serif; */\r\n  font-size: 22px;\r\n  font-weight: var(--text-heading-weight);\r\n  text-align: var(--text-heading-alignment);\r\n  text-decoration: var(--text-heading-text-decoration);\r\n  margin-top: var(--text-heading-margin-top);\r\n  margin-bottom: var(--text-heading-margin-bottom);\r\n  /* margin-left: var(--text-heading-margin-left); */\r\n  /* margin-right: var(--text-heading-margin-right); */\r\n  margin-left: calc(var(--text-heading-margin-left) + 1vw);\r\n  margin-right: calc(var(--text-heading-margin-right) + 1vw);\r\n\r\n}\r\n\r\n\r\n.sectionText {\r\n  font-family: var(--text-verse-font);\r\n  color: var(--text-verse-color);\r\n  /* font-family: 'EB Garamond', sans-serif; */\r\n  font-size: 20px;\r\n  font-weight: var(--text-verse-weight);\r\n  font-style: var(--text-verse-font-style);\r\n  text-align: var(--text-verse-alignment);\r\n  text-decoration: var(--text-verse-text-decoration);\r\n  line-height: var(--text-verse-margin-top);\r\n\r\n}\r\n\r\n.sectionCover {\r\n  /* margin-left: var(--text-verse-margin-left); */\r\n  /* margin-right: var(--text-verse-margin-right); */\r\n  margin-left: calc(var(--text-verse-margin-left) + 1vw);\r\n  margin-right: calc(var(--text-verse-margin-right) + 1vw);\r\n}\r\n\r\n.sectionTextNumber {\r\n  color: #287F71;\r\n  font-family: 'EB Garamond', sans-serif;\r\n  font-size: 16px;\r\n  font-weight: 700;\r\n  line-height: 30px;\r\n  font-style: normal;\r\n  margin: 0 5px;\r\n}\r\n\r\n.tabDrop {\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: transparent;\r\n  border-radius: 12px;\r\n}\r\n\r\n.tabEntered {\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background: rgb(190, 187, 187);\r\n  border-radius: 12px;\r\n}\r\n\r\n\r\n.editVerseTitle {\r\n  border-radius: 6px 6px 0px 0px;\r\n  background: #4459F3;\r\n  width: fit-content;\r\n  padding: 10px 30px;\r\n  color: white;\r\n  position: absolute;\r\n  top: -42px;\r\n  font-size: 17px;\r\n}\r\n\r\n.swap-btn {}",
                "settings.css": ".settings-sidebar {\r\n  width: 280px;\r\n  height: 100vh;\r\n  /* background-color: var(--primary-color); */\r\n  /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); */\r\n  display: flex;\r\n  flex-direction: column;\r\n  font-family: 'Segoe UI', Arial, sans-serif;\r\n  border-left: 1px solid #e0e0e0;\r\n  background-color: var(--themeSideMenu) !important;\r\n}\r\n\r\n.spin {\r\n  animation: spin 1s linear infinite;\r\n}\r\n\r\n\r\n.settings-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 12px 16px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.settings-header h2 {\r\n  font-size: 18px;\r\n  font-weight: 600;\r\n  margin: 0;\r\n  color: #333;\r\n}\r\n\r\n.close-button {\r\n  background: none;\r\n  border: none;\r\n  font-size: 24px;\r\n  cursor: pointer;\r\n  color: #666;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 24px;\r\n  height: 24px;\r\n  padding: 0;\r\n}\r\n\r\n.settings-tabs {\r\n  display: flex;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.tab-button {\r\n  flex: 1;\r\n  padding: 12px 16px;\r\n  background: none;\r\n  border: none;\r\n  border-bottom: 2px solid transparent;\r\n  font-size: 14px;\r\n  cursor: pointer;\r\n  font-weight: 500;\r\n  color: #666;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.tab-button.active {\r\n  color: #4365de;\r\n  border-bottom-color: #4365de;\r\n}\r\n\r\n.settings-divider {\r\n  height: 1px;\r\n  background-color: #c5c4c4;\r\n  margin: 8px 0;\r\n}\r\n\r\n.settings-content {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 0 5px;\r\n  overflow-x: hidden;\r\n  padding: 15px 0px;\r\n}\r\n\r\n.space-item {\r\n  display: flex;\r\n  padding: 2px 16px;\r\n  border-radius: 4px;\r\n  margin: 8px;\r\n  cursor: pointer;\r\n  align-items: center;\r\n  color: var(--themeText1);\r\n}\r\n\r\n.space-item.selected {\r\n  /* background-color: #e7f0ff; */\r\n}\r\n\r\n.space-icon {\r\n  width: 36px;\r\n  height: 36px;\r\n  /* background-color: #4365de; */\r\n  border-radius: 6px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-right: 12px;\r\n}\r\n\r\n.space-icon .material-icons {\r\n  color: white;\r\n  font-size: 20px;\r\n}\r\n\r\n.space-details {\r\n  display: flex;\r\n  /* justify-content: space-between; */\r\n  width: 100%;\r\n  flex-direction: row;\r\n  padding: 0px 10px;\r\n  align-items: center;\r\n  color: var(--themeText1);\r\n}\r\n\r\n.space-name {\r\n  font-weight: 500;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.space-description {\r\n  font-size: 13px;\r\n  color: var(--themeText1);\r\n  line-height: 1.4;\r\n}\r\n\r\n.settings-list {\r\n  padding: 8px 0;\r\n}\r\n\r\n.settings-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 16px;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s;\r\n  color: var(--themeText1);\r\n}\r\n\r\n.settings-item:hover {\r\n  background-color: #f7f7f7;\r\n}\r\n\r\n.item-icon {\r\n  width: 24px;\r\n  margin-right: 12px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  /* color: var(--themeText1); */\r\n}\r\n\r\n.item-icon .material-icons {\r\n  font-size: 16px;\r\n  /* color: var(--themeText1); */\r\n}\r\n\r\n.item-text {\r\n  flex: 1;\r\n  font-size: 16px;\r\n  /* color: var(--themeText1); */\r\n  font-weight: 500;\r\n  font-family: \"Helvetica Neue\";\r\n}\r\n\r\n.item-chevron {\r\n  color: #999;\r\n}\r\n\r\n/* Custom styling for specific icons */\r\n.settings-item .material-icons {\r\n  font-size: 20px;\r\n}\r\n\r\n.sidebarLine {\r\n  margin-top: 25px;\r\n  width: 100%;\r\n  height: 1px;\r\n  background-color: var(--gray2-color);\r\n}\r\n\r\n\r\n.sub-settings-list {\r\n  margin-left: 30px;\r\n}\r\n\r\n.sub-item {\r\n  color: var(--themeText2) !important;\r\n}\r\n\r\n.space-description {\r\n  color: var(--themeText1);\r\n  font-family: \"Open Sans\";\r\n  font-size: 12px;\r\n  font-style: normal;\r\n  font-weight: 400;\r\n  line-height: normal;\r\n  padding: 0 20px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n\r\n.activeAccount {\r\n  padding: 10px;\r\n  display: flex;\r\n  flex-direction: row;\r\n  justify-content: start;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.create-profile-btn {\r\n  background-color: #4459F3;\r\n  color: white;\r\n  border: none;\r\n  /* border-radius: 8px; */\r\n  padding: 9px 10px;\r\n  font-size: 10px;\r\n  font-weight: 500;\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  transition: background-color 0.2s ease;\r\n  font-family: inherit;\r\n}\r\n\r\n.create-profile-btn:hover {\r\n  background-color: #4459F3;\r\n}\r\n\r\n.create-profile-btn:active {\r\n  transform: translateY(1px);\r\n}\r\n\r\n\r\n\r\n.form-input {\r\n  width: 100%;\r\n  padding: 16px;\r\n  background-color: #e8e8e8;\r\n  border: none;\r\n  border-radius: 8px;\r\n  font-size: 16px;\r\n  color: #333;\r\n  outline: none;\r\n  transition: background-color 0.2s;\r\n}\r\n\r\n.form-input:focus {\r\n  background-color: #ddd;\r\n}",
                "sidebar.css": ".sidebar-1 {\r\n    padding: 15px;\r\n    width: 280px;\r\n    height: 100dvh;\r\n    position: relative;\r\n    /* transition: width 0.3s ease; */\r\n    background-color: var(--themeSideMenu);\r\n    padding-top: 50px;\r\n    /* padding-top: 50px; */\r\n}\r\n.customCheckboxWrapper {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding-left: 4px;\r\n  padding-right: 2px;\r\n}\r\n\r\n.customCheckbox {\r\n  appearance: none;\r\n  width: 16px;\r\n  height: 16px;\r\n  border: 2px solid #4459F3; /* orange border */\r\n  border-radius: 4px;\r\n  background-color: white;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s, border 0.2s;\r\n  position: relative;\r\n  margin-bottom: 6px;\r\n}\r\n\r\n.customCheckbox:checked {\r\n  background-color: #4459F3; /* orange fill */\r\n  border-color: #4459F3;\r\n}\r\n\r\n.customCheckbox:checked::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 2px;\r\n  left: 4px;\r\n  width: 4px;\r\n  height: 8px;\r\n  border: solid white;\r\n  border-width: 0 2px 2px 0;\r\n  transform: rotate(45deg);\r\n}\r\n\r\n.tab.selected {\r\n    border: 2px solid var(--primary-color);\r\n    /* background-color: rgba(255, 165, 0, 0.1); */\r\n}\r\n\r\n.multiSelectActions {\r\n     display: flex;\r\n    justify-content: start;\r\n    align-items: center;\r\n    gap: 10px;\r\n    margin-bottom: 13px;\r\n}\r\n\r\n.floatSidebar {\r\n    position: fixed;\r\n    top: 0;\r\n    left: -100%;\r\n    /* hide it initially off screen */\r\n    z-index: 1000;\r\n    height: 100dvh;\r\n    transition: left 0.3s ease;\r\n}\r\n\r\n.floatProfileSection {\r\n    left: -300px !important;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .sidebar-1 {\r\n        position: fixed;\r\n        top: 0;\r\n        left: -100%;\r\n        /* hide it initially off screen */\r\n        z-index: 1000;\r\n        height: 100dvh;\r\n        /* transition: left 0.3s ease; */\r\n    }\r\n\r\n\r\n    .profileSection {\r\n        left: -300px !important;\r\n    }\r\n\r\n    profileSection .open,\r\n    .open {\r\n        left: 0 !important;\r\n        /* slide into view */\r\n    }\r\n\r\n\r\n}\r\n\r\n.sidebar-collapsed {\r\n    padding: 15px 8px;\r\n    width: 60px;\r\n    height: 100vh;\r\n    position: relative;\r\n    background: var(--themeSideMenu);\r\n    /* transition: width 0.3s ease; */\r\n}\r\n\r\n.optionsButton {\r\n    display: none !important;\r\n}\r\n\r\n.headbar {\r\n    display: flex;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    gap: 15px;\r\n    justify-content: space-between;\r\n    color: var(--themeText1);\r\n    font-weight: 700;\r\n}\r\n\r\n.collapsedMenu {\r\n    display: flex;\r\n    justify-content: center;\r\n    width: 100%;\r\n    cursor: pointer;\r\n    margin-bottom: 30px;\r\n}\r\n\r\n.sidebarLine {\r\n    margin-top: 25px;\r\n    width: 100%;\r\n    height: 1px;\r\n    background-color: var(--gray2-color);\r\n}\r\n\r\n.menuOptions {\r\n    display: flex;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 10px;\r\n}\r\n\r\n.menuOptions span:first-child {\r\n    cursor: pointer;\r\n}\r\n\r\n.canvasOptions {\r\n    display: flex;\r\n    flex-direction: row;\r\n    gap: 12px;\r\n}\r\n\r\n.searchSection {\r\n    display: flex;\r\n    align-items: center;\r\n    background: var(--whitegray-color);\r\n    padding: 5px;\r\n    border-radius: 10px;\r\n    margin-top: 25px;\r\n    color: var(--themeText1);\r\n}\r\n\r\n.searchSection input {\r\n    background: transparent;\r\n    border: none;\r\n    outline: none;\r\n}\r\n\r\n.tabsContainer {\r\n    display: flex;\r\n    gap: 16px;\r\n    margin-top: 25px;\r\n    justify-content: space-between;\r\n    color: var(--themeText1);\r\n    font-weight: 700;\r\n    margin-bottom: 27px;\r\n    align-items: center;\r\n}\r\n\r\n.tabs {\r\n    margin-left: 10px;\r\n    height: 100%;\r\n}\r\n\r\n.addIconCollapsed {\r\n    width: 50px;\r\n    background: var(--whitegray-color);\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n    height: 45px;\r\n    align-items: center;\r\n    justify-content: center;\r\n    display: flex\r\n}\r\n\r\n.tabs-collapsed {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    margin-top: 20px;\r\n    gap: 15px;\r\n}\r\n\r\n.tab {\r\n    color: var(--themeText1);\r\n    display: flex;\r\n    flex-direction: row;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    cursor: pointer;\r\n    user-select: none;\r\n    /* -webkit-user-drag: element; */\r\n}\r\n\r\n.activeTab {\r\n    background: white;\r\n    color: black;\r\n    display: flex;\r\n    flex-direction: row;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    cursor: pointer;\r\n    border-radius: 8px;\r\n    user-select: none;\r\n    /* -webkit-user-drag: element; */\r\n    /* padding-left: 5px; */\r\n    padding-bottom: 3px;\r\n}\r\n\r\n.activeTabCollapsed {\r\n    flex-direction: row;\r\n    cursor: pointer;\r\n    border-radius: 5px;\r\n    user-select: none;\r\n    width: 50px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 45px;\r\n    padding: 0;\r\n    padding-top: 3px;\r\n    background: #C1C8F4;\r\n    border: #4459F3 1px solid;\r\n    color: #4459F3;\r\n}\r\n\r\n.collabsedTab {\r\n    flex-direction: row;\r\n    cursor: pointer;\r\n    border-radius: 5px;\r\n    user-select: none;\r\n    width: 50px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 45px;\r\n    padding: 0;\r\n    padding-top: 3px;\r\n    background: transparent;\r\n    border: black 1px solid;\r\n    color: black;\r\n}\r\n\r\n.tabInfo {\r\n    display: flex;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    margin-top: 10px;\r\n    gap: 10px;\r\n}\r\n\r\n.tabInfoCollapsed {\r\n    display: flex;\r\n    justify-content: center;\r\n    padding: 8px 0;\r\n}\r\n\r\n.addIcon {\r\n    background-color: var(--whitegray-color);\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n}\r\n\r\n.profileSection {\r\n    position: absolute;\r\n    left: 0;\r\n    bottom: 0px;\r\n    display: flex;\r\n    flex-direction: row;\r\n    gap: 10px;\r\n    justify-content: space-around;\r\n    width: 280px;\r\n    background: var(--themeSideMenu);\r\n    align-items: center;\r\n    height: 70px;\r\n\r\n}\r\n\r\n.profileSection-collapsed {\r\n    position: absolute;\r\n    left: 6px;\r\n    bottom: 26px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 15px;\r\n    width: 100%;\r\n    align-items: center;\r\n    background: var(--themeSideMenu);\r\n}\r\n\r\n.dot {\r\n    display: flex;\r\n    flex-direction: row;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    /* width: 50px; */\r\n    gap: 0px;\r\n}\r\n\r\n.activeBg:hover~.layout {\r\n    pointer-events: none;\r\n}\r\n\r\n.activeBg {\r\n    background: #4459F34D;\r\n    border-radius: 3px;\r\n    width: 20px;\r\n    height: 20px;\r\n    border: 1px solid #4459F3;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    cursor: pointer;\r\n}\r\n\r\n.activeBg span {\r\n    width: 8px;\r\n    height: 8px;\r\n    background-color: #4459F3;\r\n    border-radius: 2px;\r\n    display: block;\r\n}\r\n\r\n.bg span {\r\n    cursor: pointer;\r\n    width: 8px;\r\n    height: 8px;\r\n    background-color: var(--gray2-color);\r\n    border-radius: 2px;\r\n    display: block;\r\n}\r\n\r\n.userProfile {\r\n    background: #4459F3;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    border-radius: 50%;\r\n    height: 30px;\r\n    width: 31px;\r\n    color: white;\r\n}\r\n\r\n.icon-button {\r\n    cursor: pointer;\r\n    color: var(--themeText1);\r\n}\r\n\r\n\r\n.triangle-up {\r\n    width: 0;\r\n    height: 0;\r\n    border-left: 12px solid transparent;\r\n    border-right: 12px solid transparent;\r\n    border-bottom: 18px solid #202020;\r\n    position: absolute;\r\n    top: -10px;\r\n    right: 29px;\r\n}\r\n\r\n.externalPopupSettings {\r\n    left: 101% !important;\r\n    border-radius: 0px !important;\r\n    ;\r\n    height: 90% !important;\r\n    ;\r\n    position: absolute !important;\r\n    ;\r\n    border: transparent 1px solid !important;\r\n    ;\r\n}\r\n\r\n.popupSettings {\r\n    position: relative;\r\n    width: 225px !important;\r\n    height: fit-content;\r\n    padding: 10px;\r\n    background: #202020;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 2px;\r\n    border-radius: 15px;\r\n}\r\n\r\n\r\n.popupSettings .itemSettings {\r\n    display: flex !important;\r\n    flex-direction: row;\r\n    gap: 6px;\r\n    justify-content: start !important;\r\n    align-items: center;\r\n    background: transparent;\r\n    width: 100%;\r\n    color: #FFF;\r\n    font-family: \"Helvetica Neue\";\r\n    font-size: 14px;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    line-height: normal;\r\n    border-radius: 10px;\r\n    padding: 6px;\r\n    cursor: pointer;\r\n}\r\n\r\n.itemSettings:hover {\r\n    background-color: #4B4B4B;\r\n}\r\n\r\n.activeItemSettings {\r\n    background: #4B4B4B;\r\n}\r\n\r\n.folder {\r\n    margin-left: 10px;\r\n}\r\n\r\n.folderHeader {\r\n    display: flex;\r\n    flex-direction: row;\r\n    justify-content: start;\r\n    align-items: center;\r\n    gap: 4px;\r\n}\r\n\r\n.folderTabs {\r\n    margin-left: 15px;\r\n    margin-top: 5px;\r\n}",
                "styler": "@export function getStyleOf(name){\r\n    return tags[name]\r\n}",
                "surroundingDivs.css": ".wrapper {\r\n    position: relative;\r\n    display: inline-block;\r\n    /* padding: 20px;  */\r\n}\r\n\r\n.contentOfSurrounding {\r\n    position: relative;\r\n    /* background: white;  */\r\n    z-index: 1;\r\n    padding: 5px;\r\n}\r\n\r\n.surrounding {\r\n    position: absolute;\r\n    background-color: transparent;\r\n}\r\n\r\n/* Top div */\r\n.top {\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 5px;\r\n    pointer-events: all !important;\r\n}\r\n\r\n/* Bottom div */\r\n.bottom {\r\n    bottom: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 5px;\r\n    pointer-events: all !important;\r\n\r\n}\r\n\r\n/* Left div */\r\n.left {\r\n    top: 0;\r\n    left: 0;\r\n    width: 5px;\r\n    height: 100%;\r\n    pointer-events: all !important;\r\n\r\n\r\n}\r\n\r\n/* Right div */\r\n.right {\r\n    top: 0;\r\n    right: 0;\r\n    width: 5px;\r\n    height: 100%;\r\n    pointer-events: all !important;\r\n\r\n}",
                "system": "app.styles",
                "testSettings.css": ".textSettings-sidebar {\r\n    width: 280px;\r\n    height: 100vh;\r\n    /* background-color: var(--primary-color); */\r\n    /* box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); */\r\n    display: flex;\r\n    flex-direction: column;\r\n    font-family: 'Segoe UI', Arial, sans-serif;\r\n    border-left: 1px solid #e0e0e0;\r\n    padding: 10px;\r\n    overflow: scroll;\r\n}\r\n\r\n\r\n",
                "themeSettings.css": ".themeSettings-container {\r\n  font-family: sans-serif;\r\n  padding: 16px;\r\n  width: 280px;\r\n  height: 100%;\r\n  overflow: scroll;\r\n}\r\n\r\n.sidebarLine {\r\n  margin-top: 25px;\r\n  width: 100%;\r\n  height: 1px;\r\n  background-color: var(--gray2-color);\r\n}\r\n\r\n.themeText {\r\n  color: #000;\r\n  font-family: \"Open Sans\";\r\n  font-size: 14px;\r\n  font-style: normal;\r\n  font-weight: 600;\r\n  line-height: normal;\r\n}\r\n\r\n.themeButton {\r\n  width: 100%;\r\n  height: 48px;\r\n  flex-shrink: 0;\r\n  border-radius: 4px;\r\n  background: #4459F3;\r\n  outline: none;\r\n  border: none;\r\n  color: white;\r\n  margin-top: 40px;\r\n  cursor: pointer;\r\n}",
                "toolbar.css": ".toolbar-container-1 {\r\n  display: flex;\r\n  justify-content: center;\r\n  padding: 16px 0;\r\n  width: 100%;\r\n  position: fixed;\r\n  bottom: 18px;\r\n  left: 50%;\r\n  z-index: 10;\r\n}\r\n\r\n.toolbar-1 {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  /* background-color: var(--themeSideMenu); */\r\n  border-radius: 12px;\r\n  padding: 8px 20px;\r\n  box-shadow: 0 26px 10px rgba(0, 0, 0, 0.1);\r\n  gap: 10px;\r\n  /* min-width: 320px; */\r\n  max-width: 600px;\r\n  /* width: 80%; */\r\n  position: fixed;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  bottom: 18px;\r\n  z-index: 99;\r\n  border: 1px solid #00000024;\r\n}\r\n\r\n\r\n.toolbar-button {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  border: none;\r\n  background-color: transparent;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s ease;\r\n}\r\n\r\n.toolbar-button:hover {\r\n  background-color: #f0f0f0;\r\n}\r\n\r\n.toolbar-button:focus {\r\n  /* outline: none; */\r\n  /* background-color: #e8e8e8; */\r\n}\r\n\r\n.material-icons {\r\n  color: #333;\r\n  font-size: 24px;\r\n}\r\n\r\n\r\n.toolbar-item-wrapper {\r\n  position: relative;\r\n  transition: transform 0.25s ease;\r\n}\r\n\r\n.toolbar-button {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  border: none;\r\n  background-color: transparent;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s ease, transform 0.25s ease;\r\n}\r\n\r\n.toolbar-button:hover {\r\n  background-color: #f0f0f0;\r\n}\r\n\r\n/* 👇 Empty space where item was */\r\n.placeholder {\r\n  visibility: hidden;\r\n}",
                "toolbarSettings.css": ".toolbar-container {\r\n  font-family: sans-serif;\r\n  padding: 16px;\r\n  width: 280px;\r\n  height: 100%;\r\n}\r\n\r\n.breadcrumb {\r\n  font-size: 12px;\r\n  color: #888;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.section-header .section-title {\r\n  font-weight: bold;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.section-desc {\r\n  font-size: 13px;\r\n  color: #666;\r\n  margin-bottom: 16px;\r\n}\r\n\r\n.all-tools-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-weight: bold;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.add-btn {\r\n  background: #eee;\r\n  border: none;\r\n  border-radius: 4px;\r\n  padding: 2px 6px;\r\n  cursor: pointer;\r\n}\r\n\r\n.tool-list {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.tool-item {\r\n  display: flex;\r\n  align-items: center;\r\n  background: #fff;\r\n  padding: 10px;\r\n  margin-bottom: 8px;\r\n  border-radius: 8px;\r\n  box-shadow: 0 0 0 1px #ddd;\r\n}\r\n\r\n.tool-item.active {\r\n  box-shadow: 0 0 0 2px #d0d0ff;\r\n}\r\n\r\n.icon {\r\n  font-size: 18px;\r\n  margin-right: 12px;\r\n}\r\n\r\n.label {\r\n  flex-grow: 1;\r\n}\r\n\r\n.switch {\r\n  position: relative;\r\n  display: inline-block;\r\n  width: 34px;\r\n  height: 20px;\r\n}\r\n\r\n.switch input {\r\n  opacity: 0;\r\n  width: 0;\r\n  height: 0;\r\n}\r\n\r\n.slider {\r\n  position: absolute;\r\n  cursor: pointer;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background-color: #ccc;\r\n  transition: 0.4s;\r\n  border-radius: 34px;\r\n}\r\n\r\n.slider:before {\r\n  position: absolute;\r\n  content: \"\";\r\n  height: 14px;\r\n  width: 14px;\r\n  left: 3px;\r\n  bottom: 3px;\r\n  background-color: white;\r\n  transition: 0.4s;\r\n  border-radius: 50%;\r\n}\r\n\r\ninput:checked+.slider {\r\n  background-color: #4d6fff;\r\n}\r\n\r\ninput:checked+.slider:before {\r\n  transform: translateX(14px);\r\n}\r\n\r\n.menu-dots {\r\n  margin-left: 10px;\r\n  cursor: pointer;\r\n}"
            }
        },
