                },
                "45ca5da5-6b2d-40f5-8cd8-20128997c3d3/api/BSB/GEN/3.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "027f9eb267985a9a3e8667c25e989634643a87b829f14a39c1fb558f13d4a177",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "The Serpent’s Deception"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "Now the serpent",
                                        {
                                            "noteId": 2123
                                        },
                                        "was more crafty than any beast of the field that the LORD God had made. And he said to the woman, “Did God really say, ‘You must not eat from any tree in the garden?’”"
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "The woman answered the serpent, “We may eat the fruit of the trees of the garden,"
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "but about the fruit of the tree in the middle of the garden, God has said, ‘You must not eat of it or touch it, or you will die.’”"
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“You will not surely die,” the serpent told her."
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "“For God knows that in the day you eat of it, your eyes will be opened and you will be like God, knowing good and evil.”"
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "When the woman saw that the tree was good for food and pleasing to the eyes, and that it was desirable for obtaining wisdom, she took the fruit and ate it. She also gave some to her husband who was with her, and he ate it."
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the eyes of both of them were opened, and they knew that they were naked; so they sewed together fig leaves and made coverings for themselves."
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "God Arraigns Adam and Eve"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the man and his wife heard the voice of the LORD God walking in the garden in the breeze",
                                        {
                                            "noteId": 2124
                                        },
                                        "of the day, and they hid themselves from the presence of the LORD God among the trees of the garden."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But the LORD God called out to the man, “Where are you?”"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“I heard Your voice in the garden,” he replied, “and I was afraid because I was naked; so I hid myself.”"
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Who told you that you were naked?” asked the LORD God. “Have you eaten from the tree of which I commanded you not to eat?”"
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the man answered, “The woman whom You gave me, she gave me fruit from the tree, and I ate it.”"
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD God said to the woman, “What is this you have done?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "“The serpent deceived me,” she replied, “and I ate.”"
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Fate of the Serpent"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So the LORD God said to the serpent:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“Because you have done this,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "cursed are you above all livestock"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and every beast of the field!"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "On your belly will you go,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and dust you will eat,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "all the days of your life."
                                        }
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "And I will put enmity between you and the woman,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and between your seed and her seed."
                                        },
                                        {
                                            "poem": 1,
                                            "text": "He will crush your head,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and you will strike his heel."
                                        },
                                        {
                                            "noteId": 2125
                                        },
                                        {
                                            "poem": 2,
                                            "text": "”"
                                        }
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Punishment of Mankind"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "To the woman He said:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“I will sharply increase your pain in childbirth;"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "in pain you will bring forth children."
                                        },
                                        {
                                            "poem": 1,
                                            "text": "Your desire will be for your husband,"
                                        },
                                        {
                                            "noteId": 2126
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and he will rule over you.”"
                                        }
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And to Adam He said:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“Because you have listened to the voice of your wife"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and have eaten from the tree"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "of which I commanded you not to eat,"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "cursed is the ground because of you;"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "through toil you will eat of it"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "all the days of your life."
                                        }
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "Both thorns and thistles it will yield for you,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and you will eat the plants of the field."
                                        }
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "By the sweat of your brow"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "you will eat your bread,"
                                        },
                                        {
                                            "poem": 1,
                                            "text": "until you return to the ground—"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "because out of it were you taken."
                                        },
                                        {
                                            "poem": 1,
                                            "text": "For dust you are,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "and to dust you shall return.”"
                                        }
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Adam named his wife Eve,",
                                        {
                                            "noteId": 2127
                                        },
                                        "because she would be the mother of all the living."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Expulsion from Paradise"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the LORD God made garments of skin for Adam and his wife, and He clothed them."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then the LORD God said, “Behold, the man has become like one of Us, knowing good and evil. And now, lest he reach out his hand and take also from the tree of life, and eat, and live forever...”"
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Therefore the LORD God banished him from the Garden of Eden to work the ground from which he had been taken."
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So He drove out the man and stationed cherubim on the east side of the Garden of Eden, along with a whirling sword of flame to guard the way to the tree of life."
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 2123,
                                    "reference": {
                                        "chapter": 3,
                                        "verse": 1
                                    },
                                    "text": "Hebrew nachash, translated in this chapter as serpent, is translated in most cases as snake."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2124,
                                    "reference": {
                                        "chapter": 3,
                                        "verse": 8
                                    },
                                    "text": "Or at the breezy (time); Hebrew unto the Ruach"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2125,
                                    "reference": {
                                        "chapter": 3,
                                        "verse": 15
                                    },
                                    "text": "Or He will bruise your head, and you will bruise his heel. The same Hebrew root for crush, bruise, or strike appears twice in this verse."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2126,
                                    "reference": {
                                        "chapter": 3,
                                        "verse": 16
                                    },
                                    "text": "Or You will desire to control your husband"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2127,
                                    "reference": {
                                        "chapter": 3,
                                        "verse": 20
                                    },
                                    "text": "Eve sounds like the Hebrew for giving life or living."
                                }
                            ],
                            "number": 3
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/4.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_004_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_004_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_004.mp3"
                        },
                        "numberOfVerses": 24,
                        "previousChapterApiLink": "/api/BSB/GEN/2.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_002_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_002_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_002.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_003_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_003_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_003.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/3.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "587b6d4528b746696e90560a23115d4da5dac426bbd75e288276092f5a45ad21",
                            "shortName": "BSB",
                            "textDirection": "ltr",
                            "totalNumberOfChapters": 1189,
                            "totalNumberOfVerses": 31086,
                            "website": "https://berean.bible/"
                        }
                    },
                    "headers": {
                        "content-type": "application/json",
                        "last-modified": "Wed, 13 Nov 2024 21:19:48 GMT"
                    },
                    "status": 200,
                    "statusText": ""
                },
                "45ca5da5-6b2d-40f5-8cd8-20128997c3d3/api/BSB/GEN/4.json": {
                    "data": {
                        "book": {
                            "commonName": "Genesis",
                            "firstChapterApiLink": "/api/BSB/GEN/1.json",
                            "id": "GEN",
                            "lastChapterApiLink": "/api/BSB/GEN/50.json",
                            "name": "Genesis",
                            "numberOfChapters": 50,
                            "order": 1,
                            "sha256": "027f9eb267985a9a3e8667c25e989634643a87b829f14a39c1fb558f13d4a177",
                            "title": "Genesis",
                            "totalNumberOfVerses": 1533,
                            "translationId": "BSB"
                        },
                        "chapter": {
                            "content": [
                                {
                                    "content": [
                                        "Cain and Abel"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "content": [
                                        "And Adam had relations with his wife Eve, and she conceived and gave birth to Cain.",
                                        {
                                            "noteId": 2128
                                        },
                                        {
                                            "lineBreak": true
                                        },
                                        "“With the help of the LORD I have brought forth a man,” she said."
                                    ],
                                    "number": 1,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Later she gave birth to Cain’s brother Abel.",
                                        {
                                            "lineBreak": true
                                        },
                                        "Now Abel was a keeper of sheep, while Cain was a tiller of the soil."
                                    ],
                                    "number": 2,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "So in the course of time, Cain brought some of the fruit of the soil as an offering to the LORD,"
                                    ],
                                    "number": 3,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "while Abel brought the best portions of the firstborn of his flock.",
                                        {
                                            "lineBreak": true
                                        },
                                        "And the LORD looked with favor on Abel and his offering,"
                                    ],
                                    "number": 4,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "but He had no regard for Cain and his offering. So Cain became very angry, and his countenance fell."
                                    ],
                                    "number": 5,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Why are you angry,” said the LORD to Cain, “and why has your countenance fallen?"
                                    ],
                                    "number": 6,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "If you do what is right, will you not be accepted? But if you refuse to do what is right, sin is crouching at your door; it desires you,",
                                        {
                                            "noteId": 2129
                                        },
                                        "but you must master it.”"
                                    ],
                                    "number": 7,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Cain said to his brother Abel, “Let us go out to the field.”",
                                        {
                                            "noteId": 2130
                                        },
                                        "And while they were in the field, Cain rose up against his brother Abel and killed him."
                                    ],
                                    "number": 8,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And the LORD said to Cain, “Where is your brother Abel?”",
                                        {
                                            "lineBreak": true
                                        },
                                        "“I do not know!” he answered. “Am I my brother’s keeper?”"
                                    ],
                                    "number": 9,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“What have you done?” replied the LORD. “The voice of your brother’s blood cries out to Me from the ground."
                                    ],
                                    "number": 10,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Now you are cursed and banished from the ground, which has opened its mouth to receive your brother’s blood from your hand."
                                    ],
                                    "number": 11,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "When you till the ground, it will no longer yield its produce to you. You will be a fugitive and a wanderer on the earth.”"
                                    ],
                                    "number": 12,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "But Cain said to the LORD, “My punishment",
                                        {
                                            "noteId": 2131
                                        },
                                        "is greater than I can bear."
                                    ],
                                    "number": 13,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Behold, this day You have driven me from the face of the earth, and from Your face I will be hidden; I will be a fugitive and a wanderer on the earth, and whoever finds me will kill me.”"
                                    ],
                                    "number": 14,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "“Not so!”",
                                        {
                                            "noteId": 2132
                                        },
                                        "replied the LORD. “If anyone slays Cain, then Cain will be avenged sevenfold.” And the LORD placed a mark on Cain, so that no one who found him would kill him."
                                    ],
                                    "number": 15,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "So Cain went out from the presence of the LORD and settled in the land of Nod,",
                                        {
                                            "noteId": 2133
                                        },
                                        "east of Eden."
                                    ],
                                    "number": 16,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "The Descendants of Cain"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Cain had relations with his wife, and she conceived and gave birth to Enoch. Then Cain built a city and named it after his son Enoch."
                                    ],
                                    "number": 17,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Now to Enoch was born Irad, and Irad was the father of Mehujael, and Mehujael was the father of Methusael, and Methusael was the father of Lamech."
                                    ],
                                    "number": 18,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And Lamech married two women, one named Adah and the other Zillah."
                                    ],
                                    "number": 19,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Adah gave birth to Jabal; he was the father of those who dwell in tents and raise livestock."
                                    ],
                                    "number": 20,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "And his brother’s name was Jubal; he was the father of all who play the harp and flute."
                                    ],
                                    "number": 21,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Zillah gave birth to Tubal-cain, a forger of every implement of bronze and iron. And the sister of Tubal-cain was Naamah."
                                    ],
                                    "number": 22,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "Then Lamech said to his wives:",
                                        {
                                            "lineBreak": true
                                        },
                                        {
                                            "poem": 1,
                                            "text": "“Adah and Zillah, hear my voice;"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "wives of Lamech, listen to my speech."
                                        },
                                        {
                                            "poem": 1,
                                            "text": "For I have slain a man for wounding me,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "a young man for striking me."
                                        }
                                    ],
                                    "number": 23,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        {
                                            "poem": 1,
                                            "text": "If Cain is avenged sevenfold,"
                                        },
                                        {
                                            "poem": 2,
                                            "text": "then Lamech seventy-sevenfold.”"
                                        },
                                        {
                                            "noteId": 2134
                                        }
                                    ],
                                    "number": 24,
                                    "type": "verse"
                                },
                                {
                                    "content": [
                                        "Seth and Enosh"
                                    ],
                                    "type": "heading"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And Adam again had relations with his wife, and she gave birth to a son and named him Seth,",
                                        {
                                            "noteId": 2135
                                        },
                                        "saying, “God has granted me another seed in place of Abel, since Cain killed him.”"
                                    ],
                                    "number": 25,
                                    "type": "verse"
                                },
                                {
                                    "type": "line_break"
                                },
                                {
                                    "content": [
                                        "And to Seth also a son was born, and he called him Enosh.",
                                        {
                                            "lineBreak": true
                                        },
                                        "At that time men began to call upon",
                                        {
                                            "noteId": 2136
                                        },
                                        "the name of the LORD."
                                    ],
                                    "number": 26,
                                    "type": "verse"
                                }
                            ],
                            "footnotes": [
                                {
                                    "caller": "+",
                                    "noteId": 2128,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 1
                                    },
                                    "text": "Cain sounds like the Hebrew for acquired or brought forth."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2129,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 7
                                    },
                                    "text": "Or it desires to control you"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2130,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 8
                                    },
                                    "text": "SP, LXX, Syriac, and Vulgate; Hebrew Then Cain spoke to his brother Abel."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2131,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 13
                                    },
                                    "text": "Or guilt or sin"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2132,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 15
                                    },
                                    "text": "LXX, Vulgate, and Syriac; Hebrew “Very well!” or “Therefore:”"
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2133,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 16
                                    },
                                    "text": "Nod means wandering."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2134,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 24
                                    },
                                    "text": "Hebrew; LXX can be translated as either seventy times seven or seventy-sevenfold; see also Matthew 18:22."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2135,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 25
                                    },
                                    "text": "Seth probably means granted or appointed."
                                },
                                {
                                    "caller": "+",
                                    "noteId": 2136,
                                    "reference": {
                                        "chapter": 4,
                                        "verse": 26
                                    },
                                    "text": "Or to proclaim; some translators to invoke or to call themselves by or to profane"
                                }
                            ],
                            "number": 4
                        },
                        "nextChapterApiLink": "/api/BSB/GEN/5.json",
                        "nextChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_005_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_005_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_005.mp3"
                        },
                        "numberOfVerses": 26,
                        "previousChapterApiLink": "/api/BSB/GEN/3.json",
                        "previousChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_003_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_003_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_003.mp3"
                        },
                        "thisChapterAudioLinks": {
                            "gilbert": "https://openbible.com/audio/gilbert/BSB_01_Gen_004_G.mp3",
                            "hays": "https://openbible.com/audio/hays/BSB_01_Gen_004_H.mp3",
                            "souer": "https://openbible.com/audio/souer/BSB_01_Gen_004.mp3"
                        },
                        "thisChapterLink": "/api/BSB/GEN/4.json",
                        "translation": {
                            "availableFormats": [
                                "json"
                            ],
                            "englishName": "Berean Standard Bible",
                            "id": "BSB",
                            "language": "eng",
                            "languageEnglishName": "English",
                            "languageName": "English",
                            "licenseUrl": "https://berean.bible/",
                            "listOfBooksApiLink": "/api/BSB/books.json",
                            "name": "Berean Standard Bible",
                            "numberOfBooks": 66,
                            "sha256": "587b6d4528b746696e90560a23115d4da5dac426bbd75e288276092f5a45ad21",
                            "shortName": "BSB",
